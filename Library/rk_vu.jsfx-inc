desc:ReaKit analog VU meter — self-contained face, 20 themes
// ══════════════════════════════════════════════════════════════════════
// rk_vu.jsfx-inc — a complete VU meter that draws into a plain rectangle.
//
// Written clean-room for ReaKit, in the same spirit as rk_padgrid and
// rk_piano: hand it a rect and it paints a finished instrument, plate and
// all. Nothing here is ported from another plugin.
//
// PROVENANCE OF THE SCALE. A VU movement is LINEAR in rectified amplitude;
// the dB figures are printed at nonlinear positions along that linear
// travel. So every mark sits at 10^(dB/20), normalised across -20..+3.
// That is the physics — and it is also exactly the equation Lubomir I.
// Ivanov (Liteon) published as a tutorial, "Designing an analog VU meter
// in DSP" (2009):
//
//     xl = exp(log(1.055) * C * dB)
//
// with C = ln(10) / (20 ln 1.055) = 2.150 (his article gives 2.1 and says
// to tune it; 2.154 fits the ZenoMOD table to 0.0006). The scale here is
// COMPUTED from that law every frame. No table is transcribed from anyone.
//
// BALLISTIC. ANSI C16.5 / IEC 60268-17 define the VU movement by its step
// response: a sine at reference level applied from silence, the pointer
// reaches 99% of reference deflection in 300 ms (+-10%) and overshoots by
// at least 1% and at most 1.5%. rk_vu_sample runs a damped second-order
// system, and its two constants were SOLVED for that spec by simulating
// this exact code, 16-sample decimation included: zeta = 0.813 gives 1.22%
// overshoot, wn = 13.54 rad/s puts the 99% crossing at 300 ms. The textbook
// shortcut 4.6/(zeta*wn) is an envelope estimate — it was tried first and
// measured at 146 ms with 4.5% overshoot. Measure, don't derive.
//
// ⚠️ ONE ANGLE FRAME, EVERYWHERE. Every angle in this file is gfx_arc's:
// radians, 0 = 12 o'clock, positive = clockwise. Points are always
// (cx + sin(a)*r, cy - cos(a)*r). There is deliberately no second
// convention to convert between — mixing gfx_arc's frame with the
// cos/sin-from-3-o'clock frame is what left vu_kbsg's arc drawn 90 degrees
// away from its own scale, and sliders_kbsg's arc band before that.
//
// ⚠️ NO MEMORY. This file claims no freemem and writes to no fixed address.
// State is per-instance (this.*), colours are globals. Import it anywhere,
// in any order, next to anything.
//
// PHYSICS / DRAWING SPLIT
//   rk_vu_init(ref_db)      once, per instance
//   rk_vu_sample(x)         per sample, per instance — movement only
//   rk_vu_draw(x,y,w,h,mode,theme,label)   per frame — appearance only
//
// PUBLIC API
//   vu.rk_vu_init(-18)                     0 VU = a -18 dBFS sine. THE DEFAULT: it is
//                                          the hardware calibration (EBU, a real 1176
//                                          in a DAW) AND what ZenoMOD and chris-s's
//                                          Simple VU ship at, so a stock ZenoMOD on the
//                                          next track agrees. -20 = SMPTE. 0 makes it
//                                          read like REAPER's track meter. Product
//                                          decision 2026-09-02, after finding that
//                                          EON's own vu_kbsg port had 0 baked in where
//                                          ZenoMOD has a -18 slider.
//   vu.rk_vu_sample(spl0)                  feed it; abs() is taken here
//   vu.rk_vu_init_gr() / vu.rk_vu_sample_gr(gain)   gain-reduction meter: feed
//                                          LINEAR gain, 1.0 = none — vu_kbsg's
//                                          vu_gr_sample contract. Draw with mode 1.
//                                          The movement runs in dB: `pos` and
//                                          `hold` ARE the reduction in dB (0 =
//                                          none), so a readout is just -vu.pos.
//   rk_vu_gain2db(g)                       linear gain -> dB of reduction, no
//                                          transcendental (safe in @sample)
//   vu.rk_vu_draw(x, y, w, h, 0, 0, "L")   mode 0 = level, 1 = gain reduction
//                                          theme 0..19 (-1 host), label "" for none
//   vu.rk_vu_draw_at(cx, cy, r, mode, theme, label)   vu_kbsg's centre+radius box
//   rk_vu_pal_rgb(slot, r, g, b)           the palette hook from 0..1 floats
//   rk_vu_draw_pair(x,y,w,h,mode,theme, posA,holdA,overA,labA, posB,...)
//                                          stereo or mid/side, two plates
//   rk_vu_face / rk_vu_ink / rk_vu_cap_led two needles on ONE plate
//   vu.rk_vu_set_ref(db)                   move 0 VU without resetting the needle
//   vu.rk_vu_set_legacy(1)                 read like the meter EON shipped before this
//                                          one (peak-driven, its calibration, its
//                                          feel) - for a migration that must not
//                                          change what users see. 0 = the standard.
//   rk_vu_legacy_ratio(pos)                the same map, for rk_vu_draw_pair callers
//   vu.rk_vu_set_warn(dBFS)                peak LED threshold, absolute (default +3 VU)
//   vu.rk_vu_set_hold_style(0..3)          0 none, 1 needle, 2 arc, 3 both
//   vu.rk_vu_set_readout(0..4)             box + PEAK label: 0 off, 1 VU, 2 VU held,
//                                          3 peak dBFS held, 4 peak max (rk_vu_reset_peak)
//   rk_vu_pal(slot, 0xRRGGBB) + theme -1   a plugin's own theme drives the colours
//   vu.rk_vu_set_led_hold(sec)             peak LED lit time
//   vu.rk_vu_set_peak_hold(sec)            peak readout hold (-1 = needle's)
//   vu.rk_vu_set_speed(mult)               1 = standard 300 ms, 2 = twice as fast
//   rk_vu_set_text_scale(mult)             numerals and labels, 1 = as designed
//   vu.rk_vu_set_numbers(0|1)              numerals on the scale (1) or TICKS ONLY (0),
//                                          the dial then as large as the face allows.
//                                          rk_vu_face / rk_vu_geom callers without an
//                                          instance set rkvu_nums themselves (default 1)
//   vu.rk_vu_set_flat(0|1)                 1: a rect wider than 1.7:1 draws a bigger,
//                                          FLATTER dial, its pivot below the plate,
//                                          growing with the rect up to the flattest
//                                          (a strip dragged wide); 0 (default): the
//                                          1.6:1 face, centred. Sets rkvu_flat_on /
//                                          rkvu_fb for the host. Callers without an
//                                          instance set rkvu_flat (default 0)
//   vu.rk_vu_picker(x,y,w,h,cur) -> theme  click the cover: a sheet of live
//                                          miniatures; returns the pick or -1.
//                                          Call LAST in @gfx. Needs mx/my/lmb_down.
//                                          ⚠️ CALL IT THROUGH THE INSTANCE (vu.): its
//                                          open flag is this.pk_open, and EEL2 binds
//                                          `this` in an UNPREFIXED call to the
//                                          function's own name (measured 2026-09-25:
//                                          f() writes f.q, not q), so a host that
//                                          tests vu.pk_open to hold clicks off its
//                                          widgets while the sheet is up tests a
//                                          flag nothing ever sets.
//   rk_vu_set_hold(seconds)                hold-needle fall time (0 = off). PLUGIN-WIDE,
//                                          on purpose: every meter in the plugin (an L/R
//                                          pair must fall alike), the peak readout's
//                                          default hold and whether the hold needle is
//                                          drawn at all. Call it once, no vu. prefix: a
//                                          prefixed call still sets every meter. No plugin
//                                          in the suite sets it (all run the 1.6 s default).
//   rk_vu_theme_name(i, #dst)              theme name for a picker
//
// THEMES  0 Cream  1 Dark Studio  2 Black & Gold  3 Modern White  4 Broadcast
//         5 Midnight  6 Vintage Amber  7 Olive  8 Ivory  9 Blackface
//         10 SSL  11 Neve  12 API  13 Ableton  14 FL Studio
//         15 Red  16 Yellow  17 Orange  18 Emerald  19 Cobalt   (-1 = host palette)
// ══════════════════════════════════════════════════════════════════════

@init

RKVU_SWEEP  = 100 * ($pi / 180);   // total needle travel, radians
RKVU_K      = log(10) / 20;        // exp(K*dB) = 10^(dB/20): linear travel
RKVU_DB_LO  = -20;
RKVU_DB_HI  = 3;
RKVU_HOLD_S = 1.6;                 // hold needle fall time, seconds
RKVU_GR_FALL = 16;                 // GR hold needle fall rate, dB per second
rkvu_hold_style = 1;               // default for callers that draw ink themselves
rkvu_text_scale = 1;
// The movement's right-hand stop, as the linear ratio the physics runs on:
// +3 VU, where the scale ends. A real pointer cannot travel past its peg, so
// when an overload ends it leaves the stop at once; without this the model
// kept climbing (a +10 dB burst reached ratio 3.16) and then sat pinned at +3
// for 123 ms while it fell back (measured). The GR movement pegs at 20 dB.
RKVU_PEG    = 10 ^ (RKVU_DB_HI / 20);
RKVU_PEG_LEGACY = 0.9553;          // the same stop through rk_vu_legacy_ratio
RKVU_FMIN   = 7;                   // smallest numeral, in LOGICAL px (x the DPI hint)
RKVU_REF_F  = 100;                 // numeral widths are measured once at this size
rkvu_wr_ok  = 0;                   // ...per instance, on the first draw
RKVU_SNAP   = 1.5;                 // px a numeral may land sideways: pixel snapping + hinting
RKVU_MINUS_LO = 0.22;              // a minus sign's ink ends this x font below its label's centre
                                   // (0.10..0.21 measured in REAPER, sizes 7..40, 2026-09-25)
RKVU_CRUSH  = 0.6;                 // a face whose numerals need the arc below this share: none
                                   // (⚠️ NOT "RKVU_NONUM": EEL2 is case-blind, that IS rkvu_nonum)
rkvu_gmode  = 0;                   // the label set rk_vu_geom solves for: 0 level, 1 GR
// ⚠️ DIGITS UNDER 10 px ARE REGULAR, NOT BOLD. REAPER draws Arial BOLD at 8 and
// 9 px with the "5" closed into a "6" (captured in the sandbox 2026-09-25: "-5"
// read "-6", "-15" read "-16"; the user's own mixer shot showed a "-6" that can
// only have been -5). Regular is right at every size, and Arial's digits and
// minus have the same advance in both weights, so no fit or spacing changes.
RKVU_BOLD   = 10;                  // smallest numeral size, in drawn px, set in bold
// Numeral vs numeral, up and down, the test clears the DIGITS' ink, not the
// whole font cell: REAPER's digits are at most 0.636 of the font size tall
// (every size 7..40, measured 2026-09-25). On the steep left end of a small
// dial that lets -20 and -10 stagger (round 3: the user wanted -10 on strips).
RKVU_INK_H  = 0.66;
rkvu_l10    = 0;                   // the level set in use: 1 the -10-first ladder (_rk_vu_fit)
rkvu_nums   = 1;                   // the face being laid out carries numerals: 1, or 0 = ticks only
                                   // (rk_vu_draw and rk_vu_picker set it from the instance, then put 1 back)
// FLAT faces (vu.rk_vu_set_flat, 2026-09-27): a rect wider than RKVU_FLAT_A0:1 gets a
// bigger, flatter dial whose pivot sinks below the plate (rk_vu_geom says how).
RKVU_FLAT_A0 = 1.7;                // width:height past which a flat face flattens
RKVU_FLAT_M  = 2.5;                // px (x the DPI hint) the scale's lowest ink keeps above the bezel
rkvu_flat    = 0;                  // the face being laid out may flatten: 1, or 0 (the default)
                                   // (rk_vu_draw and rk_vu_picker set it from the instance, then put 0 back)
rkvu_flat_on = 0;                  // out: the last geometry IS flat (its pivot may be below the plate)
rkvu_fb      = 0;                  // out: the last geometry's face bottom, the bezel's inner edge

// PLUGIN-WIDE by design (see the API list): one hold for every meter in the plugin.
function rk_vu_set_hold(sec) ( RKVU_HOLD_S = max(sec, 0); );

// ── Scale ───────────────────────────────────────────────────────────────
// dB -> 0..1 along the arc, straight from the published equation.
function rk_vu_db2frac(db) local(lo, hi) (
  lo = exp(RKVU_K * RKVU_DB_LO);
  hi = exp(RKVU_K * RKVU_DB_HI);
  (exp(RKVU_K * min(max(db, RKVU_DB_LO - 6), RKVU_DB_HI + 2)) - lo) / (hi - lo);
);

// The eleven marks a VU face carries, by index.
function rk_vu_mark_db(i) (
  i == 0 ? -20 : i == 1 ? -10 : i == 2 ? -7 : i == 3 ? -5 : i == 4 ? -3 :
  i == 5 ?  -2 : i == 6 ?  -1 : i == 7 ?  0 : i == 8 ?  1 : i == 9 ?  2 : 3;
);

// ── The only angle conversion in the file ───────────────────────────────
// The stops are AT -20 and +3, like ZenoMOD's and like a real movement's
// pegs. This used to allow 4% of travel past each end, so at silence the
// needle rested 4 degrees below -20 - visibly not where his rests.
function rk_vu_ang(frac) ( (min(max(frac, 0), 1) - 0.5) * RKVU_SWEEP; );
function rk_vu_px(cx, r, a) ( cx + sin(a) * r; );
function rk_vu_py(cy, r, a) ( cy - cos(a) * r; );

// ── Host palette ────────────────────────────────────────────────────────
// A plugin's own theme drives the meter: set the nine colour slots from
// packed 0xRRGGBB, then draw with theme -1 and rk_vu_face leaves them alone.
// Slots: 0 plate  1 plate shade  2 bezel  3 ink  4 red zone  5 needle
//        6 cover  7 LED          8 level band
function rk_vu_pal(slot, hex) local(r, g, b) (
  r = floor(hex / 65536) / 255;
  g = (floor(hex / 256) - floor(hex / 65536) * 256) / 255;
  b = (hex - floor(hex / 256) * 256) / 255;
  slot == 0 ? ( rkvu_pl_r = r; rkvu_pl_g = g; rkvu_pl_b = b; ) :
  slot == 1 ? ( rkvu_p2_r = r; rkvu_p2_g = g; rkvu_p2_b = b; ) :
  slot == 2 ? ( rkvu_bz_r = r; rkvu_bz_g = g; rkvu_bz_b = b; ) :
  slot == 3 ? ( rkvu_ik_r = r; rkvu_ik_g = g; rkvu_ik_b = b; ) :
  slot == 4 ? ( rkvu_rd_r = r; rkvu_rd_g = g; rkvu_rd_b = b; ) :
  slot == 5 ? ( rkvu_nd_r = r; rkvu_nd_g = g; rkvu_nd_b = b; ) :
  slot == 6 ? ( rkvu_cp_r = r; rkvu_cp_g = g; rkvu_cp_b = b; ) :
  slot == 7 ? ( rkvu_ld_r = r; rkvu_ld_g = g; rkvu_ld_b = b; ) :
              ( rkvu_ar_r = r; rkvu_ar_g = g; rkvu_ar_b = b; );
);

// ── Themes ──────────────────────────────────────────────────────────────
// Twenty faces, nine colours each: plate, plate shade, bezel, ink, red zone,
// needle, cover, LED, level band. The console ones are designed from the
// hardware's look (SSL's cream and charcoal, Neve's blue, API's black and
// blue, Live's flat grey and orange, FL's charcoal and orange), not from
// anyone's code. On the red and orange plates the "red zone" is yellow or
// dark red, because red on red does not read.
RKVU_THEMES = 20;

function rk_vu_theme(t) (
  t = min(max(floor(t + 0.5), 0), RKVU_THEMES - 1);
  t == 0 ? (           // Cream
    rk_vu_pal(0, $xF2EFD8); rk_vu_pal(1, $xE5DEBD); rk_vu_pal(2, $x2B2B2C); rk_vu_pal(3, $x1A1A1C); rk_vu_pal(4, $xC21A16); rk_vu_pal(5, $x101012); rk_vu_pal(6, $x212123); rk_vu_pal(7, $xFF341A); rk_vu_pal(8, $xE8A317);
  ) :
  t == 1 ? (     // Dark Studio
    rk_vu_pal(0, $x212328); rk_vu_pal(1, $x16181C); rk_vu_pal(2, $x0B0C0E); rk_vu_pal(3, $xC8CDD8); rk_vu_pal(4, $xFF4A3C); rk_vu_pal(5, $xE6EAF2); rk_vu_pal(6, $x08090B); rk_vu_pal(7, $xFF422E); rk_vu_pal(8, $x4CC2E0);
  ) :
  t == 2 ? (    // Black & Gold
    rk_vu_pal(0, $x16130F); rk_vu_pal(1, $x0C0A08); rk_vu_pal(2, $x080706); rk_vu_pal(3, $xD8B25A); rk_vu_pal(4, $xE0452E); rk_vu_pal(5, $xF0D89A); rk_vu_pal(6, $x080706); rk_vu_pal(7, $xFFB020); rk_vu_pal(8, $xD8B25A);
  ) :
  t == 3 ? (    // Modern White
    rk_vu_pal(0, $xFAFAFA); rk_vu_pal(1, $xE8E8E9); rk_vu_pal(2, $xC8C8CA); rk_vu_pal(3, $x2A2A2D); rk_vu_pal(4, $xD83A2A); rk_vu_pal(5, $x1A1A1C); rk_vu_pal(6, $x2A2A2D); rk_vu_pal(7, $xE03020); rk_vu_pal(8, $x3A7BD5);
  ) :
  t == 4 ? (       // Broadcast
    rk_vu_pal(0, $x10161C); rk_vu_pal(1, $x090D12); rk_vu_pal(2, $x060A0E); rk_vu_pal(3, $x7FD4E8); rk_vu_pal(4, $xFF5040); rk_vu_pal(5, $xEAF6FA); rk_vu_pal(6, $x060A0E); rk_vu_pal(7, $xFF4030); rk_vu_pal(8, $xF2C14E);
  ) :
  t == 5 ? (        // Midnight
    rk_vu_pal(0, $x2A2B30); rk_vu_pal(1, $x1C1D21); rk_vu_pal(2, $x101114); rk_vu_pal(3, $x9EA3AD); rk_vu_pal(4, $xFF3FA8); rk_vu_pal(5, $x57D7FF); rk_vu_pal(6, $x0B0C0E); rk_vu_pal(7, $xFF3FA8); rk_vu_pal(8, $x57D7FF);
  ) :
  t == 6 ? (   // Vintage Amber
    rk_vu_pal(0, $xD9B37A); rk_vu_pal(1, $xC29A5E); rk_vu_pal(2, $x3A2A18); rk_vu_pal(3, $x3B2A14); rk_vu_pal(4, $xB8321E); rk_vu_pal(5, $x2A1C0C); rk_vu_pal(6, $x3A2A18); rk_vu_pal(7, $xFF5A1A); rk_vu_pal(8, $xE07A1F);
  ) :
  t == 7 ? (           // Olive
    rk_vu_pal(0, $x6B7A55); rk_vu_pal(1, $x566344); rk_vu_pal(2, $x2A3020); rk_vu_pal(3, $xF0EAD0); rk_vu_pal(4, $xE24B2E); rk_vu_pal(5, $xF5F0DC); rk_vu_pal(6, $x222818); rk_vu_pal(7, $xFF4A2A); rk_vu_pal(8, $xD9C36A);
  ) :
  t == 8 ? (           // Ivory
    rk_vu_pal(0, $xF6F1E4); rk_vu_pal(1, $xE9E1CE); rk_vu_pal(2, $x1E1E20); rk_vu_pal(3, $x141416); rk_vu_pal(4, $xC8241C); rk_vu_pal(5, $xC8241C); rk_vu_pal(6, $x1E1E20); rk_vu_pal(7, $xFF2A1A); rk_vu_pal(8, $xC89A3A);
  ) :
  t == 9 ? (       // Blackface
    rk_vu_pal(0, $x1A1A1A); rk_vu_pal(1, $x0F0F0F); rk_vu_pal(2, $x050505); rk_vu_pal(3, $xF0F0F0); rk_vu_pal(4, $xE0302A); rk_vu_pal(5, $xE0302A); rk_vu_pal(6, $x050505); rk_vu_pal(7, $xFF3A2A); rk_vu_pal(8, $xC8C8C8);
  ) :
  t == 10 ? (             // SSL
    rk_vu_pal(0, $xF0EDE3); rk_vu_pal(1, $xDCD8CC); rk_vu_pal(2, $x2C2F33); rk_vu_pal(3, $x1B1D20); rk_vu_pal(4, $xD22B2B); rk_vu_pal(5, $x15171A); rk_vu_pal(6, $x2C2F33); rk_vu_pal(7, $xFF3A2A); rk_vu_pal(8, $x6F8BA6);
  ) :
  t == 11 ? (            // Neve
    rk_vu_pal(0, $xF3EAD3); rk_vu_pal(1, $xE3D7B8); rk_vu_pal(2, $x2E4057); rk_vu_pal(3, $x1E1A14); rk_vu_pal(4, $xC8102E); rk_vu_pal(5, $xC8102E); rk_vu_pal(6, $x2E4057); rk_vu_pal(7, $xFF2A1A); rk_vu_pal(8, $x2E4057);
  ) :
  t == 12 ? (             // API
    rk_vu_pal(0, $x141414); rk_vu_pal(1, $x0A0A0A); rk_vu_pal(2, $x050505); rk_vu_pal(3, $xF2F2F2); rk_vu_pal(4, $xE03A2A); rk_vu_pal(5, $xFFFFFF); rk_vu_pal(6, $x050505); rk_vu_pal(7, $xFF3A2A); rk_vu_pal(8, $x1E6FB8);
  ) :
  t == 13 ? (         // Ableton
    rk_vu_pal(0, $xE9E9E9); rk_vu_pal(1, $xDADADA); rk_vu_pal(2, $xC4C4C4); rk_vu_pal(3, $x3C3C3C); rk_vu_pal(4, $xE8552B); rk_vu_pal(5, $xFF9F1A); rk_vu_pal(6, $x6A6A6A); rk_vu_pal(7, $xFF5A1A); rk_vu_pal(8, $xFF9F1A);
  ) :
  t == 14 ? (       // FL Studio
    rk_vu_pal(0, $x1E1F26); rk_vu_pal(1, $x15161B); rk_vu_pal(2, $x0E0F13); rk_vu_pal(3, $xC9CCD6); rk_vu_pal(4, $xFF4D3A); rk_vu_pal(5, $xF98F19); rk_vu_pal(6, $x0E0F13); rk_vu_pal(7, $xFF4D3A); rk_vu_pal(8, $xF98F19);
  ) :
  t == 15 ? (             // Red
    rk_vu_pal(0, $x9B1F1F); rk_vu_pal(1, $x7A1616); rk_vu_pal(2, $x2A0A0A); rk_vu_pal(3, $xF6E8D8); rk_vu_pal(4, $xFFD84A); rk_vu_pal(5, $xFFF4E0); rk_vu_pal(6, $x2A0A0A); rk_vu_pal(7, $xFFE04A); rk_vu_pal(8, $xFFB347);
  ) :
  t == 16 ? (          // Yellow
    rk_vu_pal(0, $xF2C230); rk_vu_pal(1, $xD9A81E); rk_vu_pal(2, $x2A2418); rk_vu_pal(3, $x1A1A1A); rk_vu_pal(4, $xD22B2B); rk_vu_pal(5, $x1A1A1A); rk_vu_pal(6, $x2A2418); rk_vu_pal(7, $xFF2A1A); rk_vu_pal(8, $xE0641E);
  ) :
  t == 17 ? (          // Orange
    rk_vu_pal(0, $xF07A2A); rk_vu_pal(1, $xD4661C); rk_vu_pal(2, $x3A1C08); rk_vu_pal(3, $x2A1608); rk_vu_pal(4, $x8E0E0E); rk_vu_pal(5, $x2A1608); rk_vu_pal(6, $x3A1C08); rk_vu_pal(7, $xFF1E1E); rk_vu_pal(8, $xFFD24A);
  ) :
  t == 18 ? (         // Emerald
    rk_vu_pal(0, $x1F7A4F); rk_vu_pal(1, $x16603D); rk_vu_pal(2, $x0C2A1B); rk_vu_pal(3, $xEAF5EC); rk_vu_pal(4, $xFF6A3A); rk_vu_pal(5, $xFFFFFF); rk_vu_pal(6, $x0C2A1B); rk_vu_pal(7, $xFF5A2A); rk_vu_pal(8, $xA8E6A0);
  ) :
  (          // Cobalt
    rk_vu_pal(0, $x1F4FA8); rk_vu_pal(1, $x163C84); rk_vu_pal(2, $x0B1F45); rk_vu_pal(3, $xEAF0FF); rk_vu_pal(4, $xFF5A4A); rk_vu_pal(5, $xFFFFFF); rk_vu_pal(6, $x0B1F45); rk_vu_pal(7, $xFF4A3A); rk_vu_pal(8, $x8FD3FF);
  );
);

function rk_vu_theme_name(i, dst) (
  i == 0  ? strcpy(dst, "Cream") :
  i == 1  ? strcpy(dst, "Dark Studio") :
  i == 2  ? strcpy(dst, "Black & Gold") :
  i == 3  ? strcpy(dst, "Modern White") :
  i == 4  ? strcpy(dst, "Broadcast") :
  i == 5  ? strcpy(dst, "Midnight") :
  i == 6  ? strcpy(dst, "Vintage Amber") :
  i == 7  ? strcpy(dst, "Olive") :
  i == 8  ? strcpy(dst, "Ivory") :
  i == 9  ? strcpy(dst, "Blackface") :
  i == 10 ? strcpy(dst, "SSL") :
  i == 11 ? strcpy(dst, "Neve") :
  i == 12 ? strcpy(dst, "API") :
  i == 13 ? strcpy(dst, "Ableton") :
  i == 14 ? strcpy(dst, "FL Studio") :
  i == 15 ? strcpy(dst, "Red") :
  i == 16 ? strcpy(dst, "Yellow") :
  i == 17 ? strcpy(dst, "Orange") :
  i == 18 ? strcpy(dst, "Emerald") :
           strcpy(dst, "Cobalt");
  dst;
);

// Same, from 0..1 floats - for a host whose palette is already floats.
function rk_vu_pal_rgb(slot, r, g, b) (
  slot == 0 ? ( rkvu_pl_r = r; rkvu_pl_g = g; rkvu_pl_b = b; ) :
  slot == 1 ? ( rkvu_p2_r = r; rkvu_p2_g = g; rkvu_p2_b = b; ) :
  slot == 2 ? ( rkvu_bz_r = r; rkvu_bz_g = g; rkvu_bz_b = b; ) :
  slot == 3 ? ( rkvu_ik_r = r; rkvu_ik_g = g; rkvu_ik_b = b; ) :
  slot == 4 ? ( rkvu_rd_r = r; rkvu_rd_g = g; rkvu_rd_b = b; ) :
  slot == 5 ? ( rkvu_nd_r = r; rkvu_nd_g = g; rkvu_nd_b = b; ) :
  slot == 6 ? ( rkvu_cp_r = r; rkvu_cp_g = g; rkvu_cp_b = b; ) :
  slot == 7 ? ( rkvu_ld_r = r; rkvu_ld_g = g; rkvu_ld_b = b; ) :
              ( rkvu_ar_r = r; rkvu_ar_g = g; rkvu_ar_b = b; );
);

// ── Numerals: the labels a face carries ─────────────────────────────────
// By mode: level (the eleven marks) or gain reduction (0 -5 -10 -15 -20,
// evenly spaced at frac i/4). For each: its angle, its reference width, and
// whether it sits over the red zone. rkvu_gmode is the mode the NEXT geometry
// is solved for; rk_vu_face sets it from its own mode argument.
// Reference width of level mark i's numeral at RKVU_REF_F.
function _rk_vu_wr(i) (
  i == 0 ? rkvu_wr0 : i == 1 ? rkvu_wr1 : i == 2 ? rkvu_wr2 : i == 3 ? rkvu_wr3 :
  i == 4 ? rkvu_wr4 : i == 5 ? rkvu_wr5 : i == 6 ? rkvu_wr6 : i == 7 ? rkvu_wr7 :
  i == 8 ? rkvu_wr8 : i == 9 ? rkvu_wr9 : rkvu_wr10;
);
function _rk_vu_lab_n(mode) ( mode == 1 ? 5 : 11; );
function _rk_vu_lab_a(mode, i) (
  mode == 1 ? rk_vu_ang(i / 4) : rk_vu_ang(rk_vu_db2frac(rk_vu_mark_db(i)));
);
function _rk_vu_lab_w(mode, i) (
  mode == 1 ? ( i == 0 ? rkvu_wr7 : i == 1 ? rkvu_wr3 : i == 2 ? rkvu_wr1 : i == 3 ? rkvu_wr15 : rkvu_wr0 )
            : _rk_vu_wr(i);
);
function _rk_vu_lab_red(mode, i) ( mode == 1 ? i >= 3 : rk_vu_mark_db(i) >= 0; );
function _rk_vu_lab_neg(mode, i) ( mode == 1 ? i >= 1 : rk_vu_mark_db(i) < 0; );

// Measure every numeral ONCE, at RKVU_REF_F, in a font slot of its own (16,
// which nothing else in the tree uses), then re-select the slot the caller
// had: fonts exist only in @gfx, the font is global state (wiki 4.3), and a
// geometry call must not change a host's font as a side effect.
function _rk_vu_measure() local(fi, th) (
  !rkvu_wr_ok ? (
    fi = gfx_getfont();
    gfx_setfont(16, "Arial", RKVU_REF_F, 'b');
    gfx_measurestr("-20", rkvu_wr0, rkvu_hr);
    gfx_measurestr("-10", rkvu_wr1, th); gfx_measurestr("-7", rkvu_wr2, th);
    gfx_measurestr("-5", rkvu_wr3, th);  gfx_measurestr("-3", rkvu_wr4, th);
    gfx_measurestr("-2", rkvu_wr5, th);  gfx_measurestr("-1", rkvu_wr6, th);
    gfx_measurestr("0", rkvu_wr7, th);   gfx_measurestr("1", rkvu_wr8, th);
    gfx_measurestr("2", rkvu_wr9, th);   gfx_measurestr("3", rkvu_wr10, th);
    gfx_measurestr("-15", rkvu_wr15, th); gfx_measurestr("-", rkvu_wrm, th);
    gfx_setfont(fi);
    rkvu_wr_ok = rkvu_hr > 0;
  );
);

// How far outside the scale line (rkvu_r) the label ring must sit so that no
// label's ink reaches the scale's: the line's antialiased edge at r + 1, the
// red zone's at r + n - 1 (it is n rows, r-1 .. r+n-2). A label is a box
// centred on the ring, so its reach toward the pivot is its half-width times
// |sin a| plus its half-height times cos a; the half-width carries RKVU_SNAP
// for pixel snapping and small-size hinting, and the box's own blank rows
// (the font's descent) are the visible air below the digits.
// Right of centre the pivot lies down-LEFT, so a negative label's nearest
// corner is its minus sign — a bar that ends RKVU_MINUS_LO x font below the
// centre, with no blank under it (so it gets 1 px of its own) — and its
// digits start one minus-advance further right. Treating that corner as ink
// pushed every large GR face's ring out for nothing (its -20 sits there).
// Sets rkvu_fsz_x.
// The red zone's rows (drawn from r-1 outward): the scale line's own two on a
// small dial, so the arc simply turns red past 0, then 0.03 r — unchanged from
// r ~133 up. It was max(4, ...): a four-row band that bunched up on a
// strip-sized dial (the user, 2026-09-26). The ring below clears whatever it is.
function _rk_vu_redn(r) ( max(2, floor(r * 0.03)); );
function _rk_vu_ringc(r) local(f, hh, n, c, i, a, hw, s) (
  f  = max(RKVU_FMIN * rkvu_sc, r * 0.12 * rkvu_text_scale);
  rkvu_fsz_x = f;
  hh = rkvu_hr * f / RKVU_REF_F * 0.5;
  n  = _rk_vu_redn(r);
  c  = 0;
  i  = 0;
  loop(_rk_vu_lab_n(rkvu_gmode),
    a  = _rk_vu_lab_a(rkvu_gmode, i);
    hw = _rk_vu_lab_w(rkvu_gmode, i) * f / RKVU_REF_F * 0.5;
    s  = abs(sin(a));
    c = max(c, (_rk_vu_lab_red(rkvu_gmode, i) ? n - 1 : 1) + (
      a > 0 && _rk_vu_lab_neg(rkvu_gmode, i)
        ? max((hw - rkvu_wrm * f / RKVU_REF_F + RKVU_SNAP) * s + hh * cos(a),
              (hw + RKVU_SNAP) * s + RKVU_MINUS_LO * f * cos(a) + 1)
        : (hw + RKVU_SNAP) * s + hh * cos(a)));
    i += 1;
  );
  c;
);

// ── Geometry ────────────────────────────────────────────────────────────
// Publishes rkvu_cx / rkvu_cy / rkvu_r (the scale line) and rkvu_ring (the
// label ring) for the rect, plus rkvu_sc, the numeral size (rkvu_fsz_x exact,
// rkvu_fsz drawn) and rkvu_nonum (1 = too small for numerals, or a ticks-only
// face: rkvu_nums 0, see rk_vu_set_numbers). The label ring
// is the outermost thing drawn, so the radius is solved from ITS extent —
// that is what keeps the numbers inside the plate at any aspect ratio.
// A host calling this directly for a gain-reduction face sets rkvu_gmode = 1
// first; rk_vu_face and rk_vu_picker set it themselves.
// (This is the face rule. rk_vu_geom, below, is what hosts call: it runs this
// rule as it stands, or twice more for a flat face.)
function _rk_vu_face_geom(x, y, w, h) local(pad, rl, half, tx, ty, c, hh, hwe, ins, fh, fw, rs) (
  // A VU face is wider than tall. With the pivot at 90% of the height and the
  // radius bound by the width, any rect taller than ~1.6:1 turns its extra
  // height into empty plate ABOVE the arc — a 195x300 stereo half was 60%
  // dead space. So the face is capped at 1.6:1 and centred in the rect; the
  // leftover belongs to the host. A 400x300 rect draws a 400x250 face.
  rkvu_ow = min(w, h * 1.6);
  rkvu_oh = rkvu_ow / 1.6;
  rkvu_ox = x + (w - rkvu_ow) * 0.5;
  rkvu_oy = y + (h - rkvu_oh) * 0.5;

  pad  = min(rkvu_ow, rkvu_oh) * 0.08;         // air between the numerals and the bezel
  rl   = 1.11;                                  // label ring, x arc radius
  half = sin(RKVU_SWEEP * 0.5);                 // horizontal reach at the ends
  // Numerals are CENTRED on the ring, so half of each one hangs outside it —
  // sideways at the ends, UPWARD at the top. Both halves are budgeted here in
  // units of r: at fsz = 0.12r a three-glyph label is ~0.28r wide (tx) and a
  // glyph is ~0.14r tall (ty). The top budget was missing until 2026-09-02,
  // and on a 400x250 face the "-10" sat 5 px INTO the bezel while the end
  // labels had 14 px of air — the arc was sized to the ring's centre line.
  tx   = 0.14;
  ty   = 0.07;
  rkvu_cx = rkvu_ox + rkvu_ow * 0.5;
  rkvu_cy = rkvu_oy + rkvu_oh * 0.90;           // pivot low on the plate
  rkvu_r  = min((rkvu_ow * 0.5 - pad) / (half * rl + tx),
                (rkvu_cy - rkvu_oy - pad) / (rl + ty));
  rkvu_r  = max(rkvu_r, 4);

  // ⚠️ SMALL FACES (2026-09-25 audit). That budget assumes numerals at 0.12 r,
  // but they never go below RKVU_FMIN px, and the red zone never below four
  // rows — so on a small face both are BIGGER than it planned. Measured
  // against the ink REAPER itself draws: every level face up to 140 px wide
  // had numerals touching the scale line or standing in the red zone, and
  // every gain-reduction face up to ~240 px (the +3 / -20 labels merged into
  // the red). So the label ring sits wherever the labels' real boxes clear
  // the scale (_rk_vu_ringc) — never inside the 1.11 r it always had — and
  // if that ring's labels would leave the face, the scale line shrinks
  // until they fit: the bezel's inner edge, less 1.5 px above and 2 px at
  // the sides for pixel snapping. A face that is already clean keeps its
  // radius (level from ~125 px wide, GR from ~150) and, from ~355 px (level)
  // and ~465 px (GR), its ring too; between, the labels step out at most
  // 2 px (level) or 3 px (GR). In a default mixer strip the level scale is
  // ~14 % smaller than before, in a short track panel ~21 %.
  rkvu_sc = max(1, gfx_ext_retina);
  _rk_vu_measure();
  // Ticks only (rkvu_nums = 0, vu.rk_vu_set_numbers(0)): no numerals, so no
  // ring to fit and no shrink — the dial keeps the whole budget above, the
  // radius the smallest faces already get.
  rkvu_nonum = rkvu_nums ? 0 : 1;
  rkvu_wr_ok && rkvu_nums ? (
    c = _rk_vu_ringc(rkvu_r);
    rkvu_ring = max(rkvu_r * rl, rkvu_r + c);
    hh  = rkvu_hr * rkvu_fsz_x / RKVU_REF_F * 0.5;
    hwe = max(_rk_vu_lab_w(rkvu_gmode, 0), _rk_vu_lab_w(rkvu_gmode, _rk_vu_lab_n(rkvu_gmode) - 1))
        * rkvu_fsz_x / RKVU_REF_F * 0.5;                     // the end labels' half widths
    ins = min(rkvu_ow, rkvu_oh) * 0.075 * 0.55;             // _rk_vu_plate's bezel
    fh  = rkvu_cy - rkvu_oy - ins - 1.5 * rkvu_sc;           // pivot to the highest a label may reach
    fw  = rkvu_ow * 0.5 - ins - 2 * rkvu_sc;                 // centre to the furthest, sideways
    rkvu_ring + hh > fh || rkvu_ring * half + hwe > fw ? (
      // Shrinking can only keep or shrink the font and the red zone, so a
      // radius solved with this c and these boxes fits at the smaller size.
      rs = min(min(fh - hh - c, (fw - hwe) / half - c), min((fh - hh) / rl, (fw - hwe) / (rl * half)));
      // Text that would crush the dial below RKVU_CRUSH of its budget: this
      // face (under ~45 px wide at 100 %) shows no numerals and keeps its arc.
      rs < rkvu_r * RKVU_CRUSH ? rkvu_nonum = 1 : (
        rkvu_r = max(rs, 4);
        rkvu_ring = max(rkvu_r * rl, rkvu_r + _rk_vu_ringc(rkvu_r));
      );
    );
  ) : (
    rkvu_fsz_x = max(RKVU_FMIN * rkvu_sc, rkvu_r * 0.12 * rkvu_text_scale);
    rkvu_ring  = rkvu_r * rl;
  );
  rkvu_fsz = floor(rkvu_fsz_x + 0.5);
);

// ── Flat faces (2026-09-27) ─────────────────────────────────────────────
// The user: a widened mixer strip's meter should grow with the strip, "from
// flatter to flattest". A face capped at 1.6:1 cannot: past that its extra
// width is plate. So a meter set flat (vu.rk_vu_set_flat(1)) whose rect is
// wider than RKVU_FLAT_A0:1 draws TODAY'S FACE AT A BIGGER SIZE, wv x wv/1.6,
// by the rule above unchanged, slid up so its numerals' top sits where this
// rect's own face puts them, and cut off at the rect's bottom edge. The pivot
// sinks below the plate and the scale is a flatter slice of a bigger dial.
// wv grows twice as fast as the rect (the plate reaches the rect's width by
// 1.8:1) and stops at the flattest: where the scale's lowest ink, the end
// ticks or the level band, would come within RKVU_FLAT_M px of the bezel.
// Wider than that the plate stops growing and is centred.
// Every face up to RKVU_FLAT_A0:1 is today's face exactly, and past it the
// flat face starts as that same face (2e-6 px apart). PROVEN MODEL FIRST
// (.dev_tests/rk_vu_audit/vu_rule4_sim.py --flat --libw, this code line for
// line): ~150,000 flat faces, 20..150 px tall, 1.55..4.5:1, level and GR,
// numerals and ticks only, 100 % and 150 %: every numeral's ink a pixel or
// more from the scale, the bezel on all four sides and each other; the
// scale's own ink 1.5 px or more above the bezel and inside it at the top;
// no numeral leaves a widening face, and the dial never shrinks as its rect
// widens except where numerals first appear (today's rule does that at
// ~46 px: the arc makes room for them).
// A scale mark's length, inward from the line, on the face just laid out: never
// under 9 px (the long marks) / 6 px, x the DPI hint, while that stays within
// 0.30 r / 0.20 r. Above those floors, 0.13 r / 0.07 r with numerals; with NO
// numerals (ticks only, or a face too small for them) the marks ARE the scale
// and run longer, 0.24 r / 0.15 r. The user, 2026-09-28, on strips: "i can
// barley see thos things", then "the numbers version needs longer ticks too"
// (the floors were 7 / 4 px within 0.22 r / 0.12 r since 2026-09-26; a face
// big enough for its proportion, the plugin windows' meters, is unchanged).
// One rule for the drawing, the flat fit and the label.
function _rk_vu_tl(lng) (
  rkvu_nonum ? ( lng ? max(rkvu_r * 0.24, min(9 * rkvu_sc, rkvu_r * 0.30))
                     : max(rkvu_r * 0.15, min(6 * rkvu_sc, rkvu_r * 0.20)) )
             : ( lng ? max(rkvu_r * 0.13, min(9 * rkvu_sc, rkvu_r * 0.30))
                     : max(rkvu_r * 0.07, min(6 * rkvu_sc, rkvu_r * 0.20)) );
);
// The numerals' top as the fit sees it: the label ring less half a label cell.
function _rk_vu_top() ( rkvu_cy - rkvu_ring - rkvu_hr * rkvu_fsz_x / RKVU_REF_F * 0.5; );
// Does a virtual face wv wide keep its lowest scale ink RKVU_FLAT_M px clear
// of the bezel of a plate h tall, once slid up to put its numerals at t0?
function _rk_vu_flat_fits(wv, h, t0) local(cy, tl) (
  _rk_vu_face_geom(0, 0, wv, wv / 1.6);
  cy = rkvu_cy - max(_rk_vu_top() - t0, 0);
  tl = _rk_vu_tl(1);                                                  // the end marks are long
  cy - min(rkvu_r - tl, rkvu_r * 0.945 - max(3, floor(rkvu_r * 0.048))) * cos(RKVU_SWEEP * 0.5)
    <= h - h * 0.075 * 0.55 - RKVU_FLAT_M * rkvu_sc;
);
// The flattest: the widest virtual face that fits, searched over a bracket set
// by h alone, so every rect wider than it gets exactly the same face.
function _rk_vu_flat_max(h, t0) local(lo, hi, mid) (
  lo = h * 1.6; hi = h * 8;
  _rk_vu_flat_fits(hi, h, t0) ? lo = hi : (
    loop(20,
      mid = (lo + hi) * 0.5;
      _rk_vu_flat_fits(mid, h, t0) ? lo = mid : hi = mid;
    );
  );
  lo;
);

// Publishes rkvu_cx / rkvu_cy / rkvu_r / rkvu_ring, the plate (rkvu_ox/oy/ow/oh),
// the numeral size, rkvu_nonum, rkvu_flat_on and rkvu_fb (see the face rule
// above). rkvu_flat is an INPUT: 0 unless rk_vu_draw or rk_vu_picker set it.
function rk_vu_geom(x, y, w, h) local(t0, wv, dy) (
  rkvu_flat_on = 0;
  rkvu_flat && w > h * RKVU_FLAT_A0 ? (
    // A face too small for numerals (or ticks only) reports a label top the
    // bezel would hide: no flat face puts its numerals higher than the fit
    // lets any face.
    _rk_vu_face_geom(0, 0, h * 1.6, h);
    t0 = max(_rk_vu_top(), h * 0.075 * 0.55 + 1.5 * rkvu_sc);
    wv = min(w, h * 1.6 + 2 * (w - h * RKVU_FLAT_A0));
    !_rk_vu_flat_fits(wv, h, t0) ? wv = _rk_vu_flat_max(h, t0);
    _rk_vu_face_geom(0, 0, wv, wv / 1.6);
    dy = max(_rk_vu_top() - t0, 0);
    rkvu_ox = x + (w - wv) * 0.5; rkvu_ow = wv;
    rkvu_oy = y;                  rkvu_oh = h;
    rkvu_cx = rkvu_ox + wv * 0.5;
    rkvu_cy = y + rkvu_cy - dy;
    rkvu_flat_on = 1;
  ) : _rk_vu_face_geom(x, y, w, h);
  rkvu_fb = rkvu_oy + rkvu_oh - min(rkvu_ow, rkvu_oh) * 0.075 * 0.55;
);

// ── Plate ───────────────────────────────────────────────────────────────
function _rk_vu_rrect(x, y, w, h, r) local(d) (
  d = min(r, min(w, h) * 0.5);
  gfx_rect(x + d, y, w - d * 2, h);
  gfx_rect(x, y + d, w, h - d * 2);
  gfx_circle(x + d, y + d, d, 1, 1);
  gfx_circle(x + w - d - 1, y + d, d, 1, 1);
  gfx_circle(x + d, y + h - d - 1, d, 1, 1);
  gfx_circle(x + w - d - 1, y + h - d - 1, d, 1, 1);
);

// Bezel, then the face, then a soft vertical shade so the plate reads as a
// surface rather than a filled rectangle.
function _rk_vu_plate(x, y, w, h) local(i, n, t, br) (
  br = min(w, h) * 0.075;
  gfx_set(rkvu_bz_r, rkvu_bz_g, rkvu_bz_b, 1);
  _rk_vu_rrect(x, y, w, h, br);

  x += br * 0.55; y += br * 0.55; w -= br * 1.1; h -= br * 1.1;
  gfx_set(rkvu_pl_r, rkvu_pl_g, rkvu_pl_b, 1);
  _rk_vu_rrect(x, y, w, h, br * 0.6);

  n = max(floor(h * 0.5), 1);
  i = 0;
  loop(n,
    t = 1 - i / n;                             // 1 at the bottom row, 0 at mid-height
    gfx_set(rkvu_p2_r, rkvu_p2_g, rkvu_p2_b, t * t * 0.14);
    gfx_rect(x, y + h - 1 - i, w, 1);
    i += 1;
  );
  // inner shadow under the bezel — light from above, so the top is deepest
  i = 0;
  loop(4,
    gfx_set(0, 0, 0, 0.16 - i * 0.04);
    gfx_rect(x, y + i, w, 1);
    gfx_set(0, 0, 0, 0.08 - i * 0.02);
    gfx_rect(x + i, y, 1, h);
    gfx_rect(x + w - 1 - i, y, 1, h);
    i += 1;
  );
  rkvu_fx = x; rkvu_fy = y; rkvu_fw = w; rkvu_fh = h;   // the face, for cover + glass
);

// ── Numerals: as many as fit, and never a flicker ───────────────────────
// A face shows the longest PREFIX of a fixed LADDER of its labels whose
// numerals all clear one another:
//     level   0, -20, +3, -3, -10, +1, +2, -1, -5, -7, -2    once -10 fits
//             0, -20, +3, -3, -7, +1, +2, -1, -5, -10, -2    below that
//     GR      0, -20, -10, -5, -15
// The first three always show. A ladder is nested — each rung is the previous
// set plus one numeral — so growing a face only ADDS numerals, with one
// planned exception: -7 and -10 cannot both fit until a face is ~120 px wide,
// so on a small level face -10 takes -7's place as soon as it clears -20 (the
// user, round 3, 2026-09-25: -10 is the mark they read; from ~74 px at 100 %).
// It is then never fewer numerals than the -7 ladder would show at that size
// (-5 even arrives sooner, having only -10 and -3 to clear), and -7 returns
// once both fit. The -7 order was computed offline with Windows' own Arial
// Bold metrics (GetTextExtentPoint32, the call LICE measures with) as the
// order in which marks first fit.
// ⚠️ It replaces a tier test (2026-09-25) that measured widths at each ROUNDED
// font size and compared them with ARC length: pixel rounding flipped the four
// minors on and off every few pixels as a window was dragged, and above a
// ~160 px radius it hid them for good. The user saw exactly that.
// Two things keep this one steady: widths are measured ONCE at RKVU_REF_F and
// scaled to the exact (unrounded) size, so the decision is a smooth function
// of the face; and the test is a real 2D box overlap at the label ring (gap =
// max(2 px, 0.15 x font); across, the measured widths; up and down, the
// digits' ink height RKVU_INK_H, not the whole cell).
// CHECKED (2026-09-25, and again for round 3) against the ink REAPER itself
// draws — every numeral at every font size 5..40 px, captured from LICE in the
// sandbox — at every face from 25 to 700 px wide in four shapes, level and GR,
// at 100 % and 150 %: numerals at least 1 px apart after pixel snapping, at
// least 1 px clear of the scale and of the bezel, never one fewer on a bigger
// face, and none leaving a growing face but -7 making way for -10.
// (The GR scale's five used to be drawn unconditionally, "they always fit":
// on a small face -10 and -15 touched.)
// Rung k -> label index. Level labels: 0 -20, 1 -10, 2 -7, 3 -5, 4 -3, 5 -2,
// 6 -1, 7 0, 8 +1, 9 +2, 10 +3; rungs 4 and 9 hold -10 and -7 (rkvu_l10) or
// -7 and -10.
function _rk_vu_ladder(mode, k) (
  mode == 1 ? ( k == 0 ? 0 : k == 1 ? 4 : k == 2 ? 2 : k == 3 ? 1 : 3 ) : (
  k == 0 ? 7 : k == 1 ? 0 : k == 2 ? 10 : k == 3 ? 4 : k == 4 ? (rkvu_l10 ? 1 : 2) :
  k == 5 ? 8 : k == 6 ? 9 : k == 7 ? 6 : k == 8 ? 3 : k == 9 ? (rkvu_l10 ? 2 : 1) : 5 );
);
// Label index -> its rung on the ladder in use.
function _rk_vu_rank(mode, i) (
  mode == 1 ? ( i == 0 ? 0 : i == 4 ? 1 : i == 2 ? 2 : i == 1 ? 3 : 4 ) : (
  i == 7 ? 0 : i == 0 ? 1 : i == 10 ? 2 : i == 4 ? 3 : i == 2 ? (rkvu_l10 ? 9 : 4) :
  i == 8 ? 5 : i == 9 ? 6 : i == 6 ? 7 : i == 3 ? 8 : i == 1 ? (rkvu_l10 ? 4 : 9) : 10 );
);
// Would labels i and j overlap on the face just laid out, at font size f?
function _rk_vu_clash(mode, i, j, f, air) local(ai, aj) (
  ai = _rk_vu_lab_a(mode, i);
  aj = _rk_vu_lab_a(mode, j);
  abs(sin(ai) - sin(aj)) * rkvu_ring < (_rk_vu_lab_w(mode, i) + _rk_vu_lab_w(mode, j)) * f / RKVU_REF_F * 0.5 + air &&
  abs(cos(ai) - cos(aj)) * rkvu_ring < RKVU_INK_H * f + air;
);
// The longest clean prefix of the ladder in use (the first three always).
function _rk_vu_prefix(mode, f, air) local(k, j, ok) (
  k = 3; ok = rkvu_wr_ok;
  loop(_rk_vu_lab_n(mode) - 3,
    ok ? (
      j = 0;
      loop(k, _rk_vu_clash(mode, _rk_vu_ladder(mode, k), _rk_vu_ladder(mode, j), f, air) ? ok = 0; j += 1; );
      ok ? k += 1;
    );
  );
  k;
);
// How many rungs fit: none on a face too small for numerals (rk_vu_geom),
// else the prefix. Level: the -10 ladder when -10 fits beside the first four
// (rung 4), else the -7 one. Sets rkvu_l10, which _rk_vu_rank then reads.
function _rk_vu_fit(mode, f) local(air, k) (
  air = max(2 * rkvu_sc, 0.15 * f);
  rkvu_l10 = mode == 0;
  k = _rk_vu_prefix(mode, f, air);
  mode == 0 && k < 5 ? ( rkvu_l10 = 0; k = _rk_vu_prefix(mode, f, air); );
  rkvu_nonum ? 0 : k;
);

// ── Scale: arc, red zone, ticks, numbers ────────────────────────────────
function _rk_vu_scale(mode, fsz)
local(i, n, frac, a, r1, r2, tl, x1, y1, x2, y2, ox, oy, tw, th, lx, ly, a0, a1, ared, dbv, nshow, show) (
  a0 = rk_vu_ang(0); a1 = rk_vu_ang(1);

  // How many numerals this face shows (the ladders above).
  nshow = _rk_vu_fit(mode == 1, rkvu_fsz_x);

  gfx_set(rkvu_ik_r, rkvu_ik_g, rkvu_ik_b, 1);
  gfx_arc(rkvu_cx, rkvu_cy, rkvu_r, a0, a1, 1);
  gfx_arc(rkvu_cx, rkvu_cy, rkvu_r - 1, a0, a1, 1);

  // Red runs from 0 VU to the top of travel (mode 0), or from the far end of
  // reduction back (mode 1). Both come from the same frac->angle mapping.
  ared = mode == 1 ? rk_vu_ang(0.55) : rk_vu_ang(rk_vu_db2frac(0));
  gfx_set(rkvu_rd_r, rkvu_rd_g, rkvu_rd_b, 1);
  i = -1;
  loop(_rk_vu_redn(rkvu_r),
    gfx_arc(rkvu_cx, rkvu_cy, rkvu_r + i, ared, a1, 1);
    i += 1;
  );

  gfx_setfont(1, "Arial", fsz, fsz >= RKVU_BOLD ? 'b' : 0);
  n = mode == 1 ? 5 : 11;
  i = 0;
  loop(n,
    mode == 1 ? ( frac = i / 4; dbv = -(i * 5); )
              : ( dbv = rk_vu_mark_db(i); frac = rk_vu_db2frac(dbv); );
    a  = rk_vu_ang(frac);
    r1 = rkvu_r - 1;
    // Inward from the line, _rk_vu_tl: longer on a face with no numerals.
    tl = _rk_vu_tl(mode == 1 || i == 0 || i == 1 || i == 7 || i == 10);
    r2 = rkvu_r - tl;

    (mode == 0 && dbv >= 0) || (mode == 1 && frac >= 0.55) ?
      gfx_set(rkvu_rd_r, rkvu_rd_g, rkvu_rd_b, 1) :
      gfx_set(rkvu_ik_r, rkvu_ik_g, rkvu_ik_b, 1);

    // A long mark is a 2 px bar: two lines half a pixel either side of its
    // radius, offset ALONG the arc (cos a, sin a). The second line used to sit
    // 1 px to the RIGHT, which is along the arc only at the top: toward the
    // ends it sheared the bar, and the user saw bent ticks (2026-09-26).
    x1 = rk_vu_px(rkvu_cx, r1, a); y1 = rk_vu_py(rkvu_cy, r1, a);
    x2 = rk_vu_px(rkvu_cx, r2, a); y2 = rk_vu_py(rkvu_cy, r2, a);
    // The bar itself is one filled quad between those two lines, and the lines
    // are its soft edges: the two hairlines alone left a lighter seam where a
    // leaning mark's antialiasing stepped them onto separate pixels, and a
    // strip meter zoomed in read "double lines" (the user, 2026-09-28).
    (mode == 1 || i == 0 || i == 1 || i == 7 || i == 10) ? (
      ox = cos(a) * 0.5; oy = sin(a) * 0.5;
      gfx_triangle(x1 - ox, y1 - oy, x1 + ox, y1 + oy, x2 + ox, y2 + oy, x2 - ox, y2 - oy);
      gfx_line(x1 - ox, y1 - oy, x2 - ox, y2 - oy, 1);
      gfx_line(x1 + ox, y1 + oy, x2 + ox, y2 + oy, 1);
    ) : gfx_line(x1, y1, x2, y2, 1);

    show = _rk_vu_rank(mode == 1, i) < nshow;
    show ? (
      gfx_setfont(1, "Arial", fsz, fsz >= RKVU_BOLD ? 'b' : 0);
      sprintf(#_rkvu_l, "%d", dbv);
      gfx_measurestr(#_rkvu_l, tw, th);
      lx = rk_vu_px(rkvu_cx, rkvu_ring, a);
      ly = rk_vu_py(rkvu_cy, rkvu_ring, a);
      gfx_x = lx - tw * 0.5; gfx_y = ly - th * 0.5;
      gfx_drawstr(#_rkvu_l);
    );
    i += 1;
  );
);

// ── Level band ──────────────────────────────────────────────────────────
// The filled arc that tracks the reading — ZenoMOD's amber band. `slot`
// steps it inward so two movements can share one plate (stereo, M/S).
function _rk_vu_arc_fill(frac, slot) local(a0, a1, rr, i, n) (
  a0 = rk_vu_ang(0);
  a1 = rk_vu_ang(frac);
  a1 > a0 ? (
    rr = rkvu_r * (slot <= 0 ? 0.945 : 0.880);
    n  = max(3, floor(rkvu_r * 0.048));
    gfx_set(rkvu_ar_r, rkvu_ar_g, rkvu_ar_b, 0.92);
    i = 0;
    loop(n, gfx_arc(rkvu_cx, rkvu_cy, rr - i, a0, a1, 1); i += 1; );
  );
);

// ── Needle ──────────────────────────────────────────────────────────────
// `wide` tapers the root; `alpha` lets the hold needle share the code.
function _rk_vu_needle(frac, wide, alpha, cr, cg, cb)
local(a, tipx, tipy, rootx, rooty, i, sx, sy, hw, px, py, n, t, ts) (
  a = rk_vu_ang(frac);
  tipx  = rk_vu_px(rkvu_cx, rkvu_r * 0.955, a);
  tipy  = rk_vu_py(rkvu_cy, rkvu_r * 0.955, a);
  hw = wide > 1 ? rkvu_r * 0.020 : 0;         // hold needle stays a hairline
  sx = rkvu_r * 0.012; sy = rkvu_r * 0.020;
  // A flat face's pivot can be below the plate: the needle then comes out
  // from under the bezel, its root (and its shadow's) where it crosses the
  // face's bottom edge, its widest corner half a pixel above it.
  t = rkvu_r * 0.10; ts = t;
  rkvu_flat_on ? (
    t  = max(t, (rkvu_cy - (rkvu_fb - 0.5 - abs(sin(a)) * hw)) / cos(a));
    ts = max(t, (rkvu_cy + sy - (rkvu_fb - 0.5)) / cos(a));
  );
  rootx = rk_vu_px(rkvu_cx, t, a);
  rooty = rk_vu_py(rkvu_cy, t, a);

  // Fixed light, upper-left: the offset is constant in the world, so it is
  // the needle's ANGLE that decides how much shadow shows beside it. The
  // offset scales with the meter — a 2px shadow vanishes on a 300px face.
  alpha >= 0.9 ? (
    gfx_set(0, 0, 0, 0.15);
    i = 0;
    loop(max(1, wide) + 1,
      gfx_line(rk_vu_px(rkvu_cx, ts, a) + sx + i, rk_vu_py(rkvu_cy, ts, a) + sy, tipx + sx + i, tipy + sy, 1);
      i += 1;
    );
  );

  gfx_set(cr, cg, cb, alpha);
  px = cos(a); py = sin(a);
  n  = max(1, floor(hw * 2) + 1);
  i  = 0;
  loop(n,
    gfx_line(rootx + px * (-hw + i), rooty + py * (-hw + i), tipx, tipy, 1);
    i += 1;
  );
);

// ── Centre cap, peak LED, label ─────────────────────────────────────────
// The coil cover: the dome over the movement that the needle emerges from
// and disappears behind. Built as the UPPER half of a disc, row by row, then
// squared off down to the bezel — so it never pokes out of the plate however
// low the pivot sits, and the pivot itself is never seen. (This is also why
// there is no counterweight tail: on a covered movement it is inside the
// dome. Draw one and you are drawing something a real meter hides.)
function _rk_vu_cover() local(R, i, dy, hw, n, am) (
  R = rkvu_r * 0.19;
  n = max(floor(R), 2);
  !rkvu_flat_on ? (
    gfx_set(0, 0, 0, 0.22);                            // its shadow on the face
    i = 0;
    loop(n,
      dy = i / n * R; hw = sqrt(max(R * R - dy * dy, 0));
      gfx_rect(rkvu_cx - hw + 2, rkvu_cy - dy + 3, hw * 2, 1);
      i += 1;
    );
    gfx_set(rkvu_cp_r, rkvu_cp_g, rkvu_cp_b, 1);       // the dome
    i = 0;
    loop(n,
      dy = i / n * R; hw = sqrt(max(R * R - dy * dy, 0));
      gfx_rect(rkvu_cx - hw, rkvu_cy - dy, hw * 2, 1);
      i += 1;
    );
    gfx_rect(rkvu_cx - R, rkvu_cy, R * 2, max(rkvu_fy + rkvu_fh - rkvu_cy, 0));
    gfx_set(1, 1, 1, 0.14);                            // rim light
    gfx_arc(rkvu_cx, rkvu_cy, R - 1, -$pi * 0.5, $pi * 0.5, 1);
    gfx_set(1, 1, 1, 0.06);
    gfx_arc(rkvu_cx, rkvu_cy, R - 3, -$pi * 0.40, $pi * 0.40, 1);
  ) : rkvu_cy - R < rkvu_fb - 1 ? (
    // A flat face: only the part of the dome above the face's bottom edge,
    // the same rows; none at all once the pivot is a dome's height below it.
    gfx_set(0, 0, 0, 0.22);
    i = 0;
    loop(n,
      dy = i / n * R; hw = sqrt(max(R * R - dy * dy, 0));
      rkvu_cy - dy + 3 <= rkvu_fb - 1 ? gfx_rect(rkvu_cx - hw + 2, rkvu_cy - dy + 3, hw * 2, 1);
      i += 1;
    );
    gfx_set(rkvu_cp_r, rkvu_cp_g, rkvu_cp_b, 1);
    i = 0;
    loop(n,
      dy = i / n * R; hw = sqrt(max(R * R - dy * dy, 0));
      rkvu_cy - dy <= rkvu_fb - 1 ? gfx_rect(rkvu_cx - hw, rkvu_cy - dy, hw * 2, 1);
      i += 1;
    );
    rkvu_cy < rkvu_fb ? gfx_rect(rkvu_cx - R, rkvu_cy, R * 2, rkvu_fb - rkvu_cy);
    // the rim light's arcs, cut where they would cross the bottom edge
    am = acos(min(max((rkvu_cy - (rkvu_fb - 1)) / (R - 1), -1), 1));
    am > 0.05 ? (
      gfx_set(1, 1, 1, 0.14);
      gfx_arc(rkvu_cx, rkvu_cy, R - 1, -min(am, $pi * 0.5), min(am, $pi * 0.5), 1);
    );
    am = acos(min(max((rkvu_cy - (rkvu_fb - 1)) / max(R - 3, 1), -1), 1));
    am > 0.05 ? (
      gfx_set(1, 1, 1, 0.06);
      gfx_arc(rkvu_cx, rkvu_cy, R - 3, -min(am, $pi * 0.40), min(am, $pi * 0.40), 1);
    );
  );
);

// Glass. A soft diagonal highlight across the upper-left of the face and
// nothing else — drawn LAST because it is in front of everything, and kept
// faint so the ink underneath stays legible.
function _rk_vu_glass() local(rows, i, t, a) (
  rows = max(floor(rkvu_fh * 0.30), 3);
  i = 0;
  loop(rows,
    t = i / rows;
    a = 0.055 * (1 - t) * (1 - t);
    gfx_set(1, 1, 1, a);
    gfx_rect(rkvu_fx, rkvu_fy + i, rkvu_fw, 1);
    i += 1;
  );
);

// Distance from a point to a segment.
function _rk_vu_segd(px, py, ax, ay, bx, by) local(vx, vy, t) (
  vx = bx - ax; vy = by - ay;
  t = max(0, min(1, ((px - ax) * vx + (py - ay) * vy) / max(vx * vx + vy * vy, 0.000000001)));
  sqrt(sqr(px - (ax + t * vx)) + sqr(py - (ay + t * vy)));
);

// The peak LED's spot and size on the face just laid out: rkvu_lx, rkvu_ly,
// rkvu_lr (0: no room on a flat face). Geometry only, no drawing.
function _rk_vu_led_pos() local(lx, ly, lr, s1, c1, tlo, thi, kw, has, ex, ey, hw, hh, rho, lm, p, k, ok, fr) (
  lr = rkvu_r * 0.055;
  lx = rkvu_cx + rkvu_r * 0.66;
  ly = rkvu_cy - rkvu_r * 0.16;
  rkvu_flat_on ? (
    // A flat face: the bezel pushes the LED up and it moves right by as much,
    // staying outside the needle's travel; left level with the far-end
    // numeral it goes right of it; never past the plate's right edge. It must
    // clear, by a pixel of plate, the keep-out along the far stop (the needle
    // there, the end tick, the red zone's end) and that numeral's box. If it
    // cannot it shrinks by a fifth and tries again, eight times, and a face
    // with no room shows none. (vu_rule4_sim.py led_pos, proven with the rest.)
    s1 = sin(RKVU_SWEEP * 0.5); c1 = cos(RKVU_SWEEP * 0.5);
    tlo = rkvu_r * 0.10;
    rkvu_cy - tlo * c1 > rkvu_fb - 0.5 ? tlo = (rkvu_cy - (rkvu_fb - 0.5)) / c1;
    thi = rkvu_r + _rk_vu_redn(rkvu_r) - 1.25;
    kw  = max(0.5, rkvu_r * 0.020) + 0.5;
    has = !rkvu_nonum;
    has ? (
      ex = rkvu_cx + s1 * rkvu_ring; ey = rkvu_cy - c1 * rkvu_ring;
      hw = _rk_vu_lab_w(rkvu_gmode, _rk_vu_lab_n(rkvu_gmode) - 1) * rkvu_fsz_x / RKVU_REF_F * 0.5 + RKVU_SNAP;
      hh = rkvu_hr * rkvu_fsz_x / RKVU_REF_F * 0.5;
    );
    fr = rkvu_ox + rkvu_ow - min(rkvu_ow, rkvu_oh) * 0.075 * 0.55;   // the face's right edge
    ok = 0; k = 0;
    while (!ok && k < 8) (
      // rho keeps the ring clear of the needle and the numerals; lm keeps the
      // LIT glow (2.1 lr, _rk_vu_led) inside the plate on a flat face, where
      // the LED sits at the plate's bottom and right edge (Codex delta audit,
      // 2026-09-28: the glow ran ~4 px into the bezel of a 600x150 ticks face).
      rho = lr * 1.45 + 1; lm = lr * 2.1 + 2.5 * rkvu_sc;
      lx = rkvu_cx + rkvu_r * 0.66; ly = rkvu_cy - rkvu_r * 0.16;
      p = max(ly - (rkvu_fb - lm), 0); ly -= p; lx += p;
      has && ly - rho < ey + hh + 1 ? lx = max(lx, ex + hw + 1 + rho);
      lx = min(lx, fr - lm);
      ok = _rk_vu_segd(lx, ly, rkvu_cx + s1 * tlo, rkvu_cy - c1 * tlo,
                               rkvu_cx + s1 * thi, rkvu_cy - c1 * thi) - kw - rho >= 1;
      has && ok ? ok = sqrt(sqr(max(max(ex - hw - lx, 0), lx - ex - hw))
                          + sqr(max(max(ey - hh - ly, 0), ly - ey - hh))) - rho >= 1;
      !ok ? lr *= 0.8;
      k += 1;
    );
    !ok ? lr = 0;
  );
  rkvu_lx = lx; rkvu_ly = ly; rkvu_lr = lr;
);

function _rk_vu_led(on) (
  _rk_vu_led_pos();
  rkvu_lr > 0 ? (
    gfx_set(rkvu_ik_r, rkvu_ik_g, rkvu_ik_b, 0.28);
    gfx_circle(rkvu_lx, rkvu_ly, rkvu_lr * 1.45, 0, 1);
    on ? (
      gfx_set(rkvu_ld_r, rkvu_ld_g, rkvu_ld_b, 0.28);
      gfx_circle(rkvu_lx, rkvu_ly, rkvu_lr * 2.1, 1, 1);
      gfx_set(rkvu_ld_r, rkvu_ld_g, rkvu_ld_b, 1);
    ) : gfx_set(rkvu_ld_r * 0.30, rkvu_ld_g * 0.30, rkvu_ld_b * 0.30, 1);
    gfx_circle(rkvu_lx, rkvu_ly, rkvu_lr, 1, 1);
  );
);

function _rk_vu_label(s, fsz) local(tw, th, ok, f, n, k, ri, lo, cm, c) (
  strlen(s) > 0 ? (
    // The label sits on the line through the pivot, its centre 0.56 r above it
    // (the classic spot), in the band between the coil cover (on a flat face
    // whose pivot is below the plate, the bezel) and the scale marks: its top
    // corners a pixel inside the circle the marks end on (_rk_vu_tl), its
    // width within the dial's radius. Where the band is short it sits lower;
    // where that is not enough it is set smaller, down to RKVU_FMIN, then cut
    // with ".."; a face with no room shows none. Labels that fit (every "GR"
    // on an ordinary meter, 2026-09-28) draw where and as they always have,
    // bold (10 px or more); a label set under 10 px is regular (RKVU_BOLD).
    // (Longer marks on small numbered faces, 2026-09-28, reached a small GR
    // face's label; a typed name, 2026-09-27, can be as wide as the dial.)
    ri = rkvu_r - _rk_vu_tl(1) - 1;
    lo = max(rkvu_r * 0.19, rkvu_cy - rkvu_fb) + 1;
    strcpy(#_rkvu_lb, s);
    f = floor(fsz * 1.4 + 0.5);
    n = strlen(s);
    ok = 0; k = 0;
    while (!ok && k < 64) (
      gfx_setfont(1, "Arial", f, f >= RKVU_BOLD ? 'b' : 0);
      tw = 0; th = 0; gfx_measurestr(#_rkvu_lb, tw, th);
      cm = sqr(ri) - sqr(tw * 0.5);
      cm = cm > 0 ? sqrt(cm) - th * 0.5 : -1;            // the highest centre clear of the marks
      ok = tw <= rkvu_r && cm >= lo + th * 0.5;
      !ok ? (
        f > RKVU_FMIN * rkvu_sc ? (
          f -= 1;
        ) : n > 1 ? (
          // Cut to about the width that fits, then by one: a long name used to
          // lose one character per pass and run out of passes (64) still too
          // wide, and drew nothing (Codex delta audit, 2026-09-28).
          n = min(n - 1, max(1, floor(n * rkvu_r / max(tw, 1))));
          strcpy_substr(#_rkvu_lb, s, 0, n); strcat(#_rkvu_lb, "..");
        ) : (
          k = 64;                                         // no room: no label
        );
      );
      k += 1;
    );
    ok ? (
      c = max(lo + th * 0.5, min(rkvu_r * 0.56, cm));
      gfx_set(rkvu_ik_r, rkvu_ik_g, rkvu_ik_b, 0.90);
      gfx_x = rkvu_cx - tw * 0.5;
      gfx_y = rkvu_cy - c - th * 0.5;
      gfx_drawstr(#_rkvu_lb);
    );
  );
);

// ══ PHYSICS ════════════════════════════════════════════════════════════
// A damped second-order movement, stepped every RKVU_DEC samples. No
// transcendentals in the audio path: the ballistic runs on linear
// deflection and the dB/scale mapping happens once per frame in the draw.
RKVU_DEC  = 16;
RKVU_ZETA = 0.813;   // 1.22% overshoot — spec says 1.0..1.5   (measured)
RKVU_WN   = 13.54;   // 99% of a step at 300 ms                (measured)

function rk_vu_init(ref_db) (
  this.pos = 0; this.vel = 0; this.hold = 0; this.hold_t = 0;
  this.acc = 0; this.cnt = 0; this.over = 0;
  // 0 VU = a sine at ref_db. mean|sine| = 2A/pi, so scale the rectified
  // average by pi/2 to recover the peak the reference is quoted in.
  this.ref = 10 ^ (ref_db / 20);
  this.ref_db = ref_db;
  this.dt  = RKVU_DEC / max(srate, 1);
  this.lim = 10 ^ ((ref_db + 3) / 20);   // peak LED at +3 VU
  this.zeta = RKVU_ZETA; this.wn = RKVU_WN;
  this.legacy = 0;
  this.hold_style = 1;                   // 0 off, 1 needle, 2 arc, 3 both
  this.readout = 0;                      // 0 off, 1 VU, 2 VU held, 3 peak, 4 peak max
  this.warn_on = 0;                      // 1 once rk_vu_set_warn has been called
  this.pkb = 0; this.pk_cur = 0; this.pk_t = 0; this.pk_max = 0;
  this.led_hold = 1.6;                   // seconds the peak LED stays lit
  this.pk_hold  = -1;                    // peak readout hold; -1 = same as the needle's
  this.speed    = 1;                     // ballistic multiplier, 1 = the standard
  this.pk_open  = 0;                     // theme picker sheet
  this.gr       = 0;                     // a level meter (rk_vu_init_gr sets 1)
  this.nums     = 1;                     // numerals on the scale (rk_vu_set_numbers)
  this.flat     = 0;                     // a wide rect keeps the 1.6:1 face (rk_vu_set_flat)
);

// ── The four switches ───────────────────────────────────────────────────

// Peak LED threshold as an absolute dBFS level, ZenoMOD's "Warn Level".
// Until this is called the LED trips at +3 VU relative to the reference.
function rk_vu_set_warn(db_fs) (
  this.warn_db = db_fs; this.warn_on = 1;
  this.legacy ? 0 : this.lim = 10 ^ (db_fs / 20);
);

// Hold display: 0 none, 1 hold NEEDLE (default), 2 hold ARC - the band runs
// to the held value instead of the current one - 3 both.
function rk_vu_set_hold_style(style) ( this.hold_style = min(max(floor(style + 0.5), 0), 3); );

// Readout box on the face plus a PEAK label by the LED. 0 off; 1 VU now;
// 2 VU held; 3 peak dBFS, held; 4 peak dBFS, max since rk_vu_reset_peak.
function rk_vu_set_readout(mode) ( this.readout = min(max(floor(mode + 0.5), 0), 4); );
function rk_vu_reset_peak() ( this.pk_max = 0; this.pk_cur = 0; );

// How long the peak LED stays lit after a hit (ZenoMOD's "LED Hold").
function rk_vu_set_led_hold(sec) ( this.led_hold = max(sec, 0.05); );

// Hold time of the peak READOUT, separate from the needle's (rk_vu_set_hold).
// -1 (the default) follows the needle's.
function rk_vu_set_peak_hold(sec) ( this.pk_hold = sec; );

// Speed. 1 = the standard, 300 ms. 2 = twice as fast, 0.5 = half. Scales the
// movement's natural frequency, so the overshoot stays at 1.2%; a faster meter
// is a less accurate one, which is why this is a multiplier and not a spec.
function rk_vu_set_speed(mult) (
  this.speed = min(max(mult, 0.2), 5);
  this.wn = (this.legacy ? 12.12 : RKVU_WN) * this.speed;
);

// Text size multiplier for every numeral and label, 1 = as designed.
function rk_vu_set_text_scale(mult) ( rkvu_text_scale = min(max(mult, 0.5), 2); );

// Numerals on the scale: 1 (the default), or 0 for a TICKS-ONLY face — the
// ticks, the arc and the red zone, no numbers, the dial as large as the face
// allows (the user, 2026-09-26: "the option to be no numbers, just ticks",
// what the old ZenoMOD face did on small meters). Per meter, and it can
// change from one draw to the next: a host may set it for its strip view and
// clear it for its window.
function rk_vu_set_numbers(on) ( this.nums = on ? 1 : 0; );

// Flat: 1 lets a rect wider than RKVU_FLAT_A0:1 draw a bigger, flatter dial
// whose pivot sinks below the plate, growing with the rect up to the flattest
// (rk_vu_geom); 0 (the default) keeps the 1.6:1 face centred in it. For a
// strip that can be dragged wide (the user, 2026-09-27: GainKit's stacked
// mixer strip, "from flatter to flattest"). Per meter, and it can change from
// one draw to the next, like rk_vu_set_numbers. A flat face shows its coil
// cover only while the pivot is on the plate, and draws no readout box
// (rk_vu_set_readout): there is no room for it beside the scale's ends.
function rk_vu_set_flat(on) ( this.flat = on ? 1 : 0; );

// LEGACY: read like the meter EON has been shipping (vu_kbsg section 7 at
// speed 61 with a reference of 0 baked in). That meter is peak-driven, its
// spring is a second order at wn 12.12 / zeta 0.99, and its scale is linear
// position labelled as dB. ⚠️ That is chris-s's ORIGINAL physics, NOT the
// current ZenoMOD: ZenoMOD 1.8.0 averages its detector and solves Rise Time /
// Overshoot to zeta 0.813, wn 13.79 — which is this file's STANDARD mode.
// Measured side by side on sines from -38 to 0 dBFS, standard rk_vu and
// ZenoMOD 1.8.0 agree to 0.24 dB and both hit 99% of a step at ~300 ms. So:
// standard = ZenoMOD as installed; legacy = what EON's plugins showed before. This switch runs THIS movement on a block-peak
// detector at that spring's constants, then maps the settled position onto
// the old reading through rk_vu_legacy_ratio. Matches the shipping meter to
// 0.11 dB on sines from -24 to 0 dBFS. For a migrated plugin that must show
// its users exactly what they saw yesterday; the standard mode is the truth.
function rk_vu_set_legacy(on) (
  this.legacy = on ? 1 : 0;
  this.zeta = on ? 0.993 : RKVU_ZETA;
  this.wn   = (on ? 12.12 : RKVU_WN) * this.speed;
  this.lim  = on ? 1.0 : (this.warn_on ? 10 ^ (this.warn_db / 20) : 10 ^ ((this.ref_db + 3) / 20));
);

// Change the reference on a running meter. 0 VU = a sine at ref_db; the peak
// LED trips 3 dB above it. -18 is the default (EBU, hardware, and what ZenoMOD
// ships at); -20 SMPTE; 0 reads like REAPER's own track meter.
function rk_vu_set_ref(ref_db) (
  this.ref = 10 ^ (ref_db / 20);
  this.ref_db = ref_db;
  !this.legacy && !this.warn_on ? this.lim = 10 ^ ((ref_db + 3) / 20);   // legacy / warn keep their own LED
);

// Gain-reduction meter. Same movement, same ballistic, but the thing being
// tracked is the compressor's GAIN, fed linear (1.0 = no reduction, 0.5 = 6 dB)
// exactly as vu_kbsg's vu_gr_sample took it, so a compressor swaps over
// without changing what it passes. The needle rests at 0 on the left and
// swings right with reduction — the dedicated-GR-scale convention vu_kbsg
// used, not the 1176's rest-at-0-VU-and-drop-left. Hold tracks the DEEPEST
// reduction. No transcendentals here: rk_vu_gain2db is a series.
function rk_vu_init_gr() (
  this.pos = 0; this.vel = 0; this.hold = 0; this.hold_t = 0;   // dB of reduction, 0 = rest
  this.acc = 0; this.cnt = 0; this.over = 0;
  this.ref = 1; this.lim = 2;              // LED never trips on a GR meter
  this.dt  = RKVU_DEC / max(srate, 1);
  this.zeta = RKVU_ZETA; this.wn = RKVU_WN;
  this.legacy = 0;
  this.gr  = 1;                            // marks the instance as GR
  this.led_hold = 1.6; this.pk_hold = -1; this.speed = 1; this.pk_open = 0;
  this.hold_style = 1;                     // the thin needle that falls behind the main one
  this.readout = 0; this.warn_on = 0;      // same fresh state rk_vu_init leaves
  this.nums = 1;
  this.flat = 0;
);

// Linear gain -> dB of reduction with no transcendental: double the value
// (6.0206 dB each time, at most eight) until it sits in [0.5, 1), then the
// atanh series for ln on that span (|t| <= 1/3, five terms, under 0.0002 dB).
// Floors at 48 dB. Defined here because rk_vu_sample_gr runs per sample.
function rk_vu_gain2db(g) local(k, m, t, t2, l) (
  g <= 0.00390625 ? 48.1648 : g >= 1 ? 0 : (
    k = 0; m = g;
    loop(8, m < 0.5 ? ( m *= 2; k += 1; ); );
    t  = (m - 1) / (m + 1); t2 = t * t;
    l  = 2 * t * (1 + t2 * (0.333333333 + t2 * (0.2 + t2 * (0.142857143 + t2 * 0.111111111))));
    6.02059991 * k - 8.68588964 * l;
  );
);

// The GR scale is LINEAR IN dB (0, -5, -10, -15, -20 evenly spaced), so the
// movement runs in dB: that is the only way its 300 ms / 1.2% overshoot mean
// the same thing on this face as on the level face. Running it on linear
// gain measured 314 ms and +1.0 dB of overshoot on a 20 dB step. The block
// detector keeps the DEEPEST gain (the peak of reduction), converted once
// per 16 samples.
// Reliability, both movements (2026-09-25 audit):
//  - A NaN or infinite input sample is refused before it reaches the state.
//    The old code survived one only by ACCIDENT (measured): EEL2 calls
//    NaN < 0 true, so the rest peg happened to catch a NaN position and the
//    velocity snap a NaN velocity. A guard should not lean on that.
//    ⚠️ The test is `abs(x) >= 0`, MEASURED in the sandbox with a genuine IEEE
//    NaN (injected through gmem): EEL2 calls NaN == NaN true and NaN != NaN
//    false (=== and !== too), and NaN < 0 TRUE; only >= on abs() cleanly
//    separates every real number (true) from NaN (false). Do not "simplify"
//    it to x != x — that passes the NaN straight through.
//  - The step length is taken from the LIVE srate every step. rk_vu_init's
//    this.dt went stale on a samplerate change in hosts that set
//    ext_noinit = 1 (Swing, Weld, ExpressBus: wiki 3.2 — then @init never
//    re-runs). MEASURED with the plugin loaded at 44.1 kHz and the device
//    switched to 96 kHz: the needle reached 99 % in 138 ms instead of 300,
//    until the project was reloaded. Now 300.5 ms.
//  - Both movements have a right-hand stop (RKVU_PEG / 20 dB) as well as the
//    rest peg, so an overload ends with the pointer leaving the stop at once.
//    MEASURED after one second at +10 VU: the old model sat on the stop for
//    123 ms after the burst ended (its reading had climbed to 3.16); now 10 ms.
// The same run confirmed what did NOT change: sines at -38/-28/-21/-18/-15
// dBFS read -20.00/-10.00/-3.00/0.00/+3.00 VU, and a 0 VU step reaches 99 %
// in 300.1 ms (44.1k) / 300.5 ms (96k) with 1.2 % overshoot and falls to 1 %
// in 300 ms — the ANSI C16.5 / IEC 60268-17 movement, old and new alike.
function rk_vu_sample_gr(gain) local(tgt, a, dt) (
  abs(gain) >= 0 ? ( gain = min(max(gain, 0), 1); ) : ( gain = 1; );   // NaN: no reduction
  this.acc = this.cnt == 0 ? gain : min(this.acc, gain);   // deepest in the block
  this.cnt += 1;
  this.cnt >= RKVU_DEC ? (
    dt  = RKVU_DEC / max(srate, 1);
    tgt = rk_vu_gain2db(this.acc);
    a   = this.wn * this.wn * (tgt - this.pos)
        - 2 * this.zeta * this.wn * this.vel;
    this.vel += a * dt;
    this.pos += this.vel * dt;
    this.pos < 0 ? ( this.pos = 0; this.vel = max(this.vel, 0); );     // the rest peg
    this.pos > 20 ? ( this.pos = 20; this.vel = min(this.vel, 0); );   // the far stop
    abs(this.vel) < 0.0000001 ? this.vel = 0;
    abs(this.pos) >= 0 && abs(this.vel) >= 0 ? 0 : ( this.pos = 0; this.vel = 0; );

    this.pos > this.hold ? ( this.hold = this.pos; this.hold_t = RKVU_HOLD_S; );
    this.hold_t > 0 ? this.hold_t -= dt
                    : this.hold = max(this.hold - dt * RKVU_GR_FALL, this.pos);
    this.cnt = 0;
  );
);

function rk_vu_sample(x) local(amp, tgt, a, dt, peg) (
  x = abs(x);
  // NaN -> silence; +inf -> a finite peak (+120 dBFS). The MOVEMENT's sum is
  // capped at 16 (+24 dBFS, far past the stop) so one hot sample cannot swamp
  // the block; the peak readout and the warn LED take the true value (Codex
  // delta audit, 2026-09-28: a +30 dBFS burst read +24.1, and a warn threshold
  // above +24 could never light).
  x >= 0 ? ( x > 1000000 ? x = 1000000; ) : ( x = 0; );
  this.acc = this.legacy ? max(this.acc, min(x, 16)) : this.acc + min(x, 16);
  this.pkb = max(this.pkb, x);
  x > this.lim ? this.over = this.led_hold;
  this.cnt += 1;
  this.cnt >= RKVU_DEC ? (
    dt  = RKVU_DEC / max(srate, 1);
    peg = this.legacy ? RKVU_PEG_LEGACY : RKVU_PEG;
    amp = this.legacy ? this.acc : (this.acc / RKVU_DEC) * ($pi * 0.5);
    tgt = this.legacy ? amp : amp / max(this.ref, 0.0000001);
    a   = this.wn * this.wn * (tgt - this.pos)
        - 2 * this.zeta * this.wn * this.vel;
    this.vel += a * dt;
    this.pos += this.vel * dt;
    this.pos < 0 ? ( this.pos = 0; this.vel = max(this.vel, 0); );
    this.pos > peg ? ( this.pos = peg; this.vel = min(this.vel, 0); );
    abs(this.vel) < 0.0000001 ? this.vel = 0;
    abs(this.pos) >= 0 && abs(this.vel) >= 0 ? 0 : ( this.pos = 0; this.vel = 0; );

    this.pos > this.hold ? ( this.hold = this.pos; this.hold_t = RKVU_HOLD_S; );
    this.hold_t > 0 ? this.hold_t -= dt
                    : this.hold = max(this.hold - dt * 0.8, this.pos);
    this.over > 0 ? this.over -= dt;
    // sample peak, held RKVU_HOLD_S then released, plus an all-time max
    this.pkb > this.pk_cur ? ( this.pk_cur = this.pkb; this.pk_t = this.pk_hold >= 0 ? this.pk_hold : RKVU_HOLD_S; )
                           : ( this.pk_t > 0 ? this.pk_t -= dt : this.pk_cur = this.pkb; );
    this.pk_max = max(this.pk_max, this.pkb);
    this.pkb = 0;
    this.acc = 0; this.cnt = 0;
  );
);

// ══ DRAW ═══════════════════════════════════════════════════════════════
// Split three ways on purpose. The face is a plain global function, so a
// caller that wants TWO movements on ONE plate (stereo, or mid/side) draws
// the face once and the ink twice. Values are passed in rather than read off
// `this`, which keeps every helper namespace-free — EEL2 namespace
// parameters are not used anywhere else in this tree and this is not the
// file to prove them in.
//
//   MONO    vu.rk_vu_draw(x, y, w, h, 0, theme, "");
//   STEREO  rk_vu_draw_pair(x, y, w, h, 0, theme,
//                           vu_l.pos, vu_l.hold, vu_l.over > 0, "L",
//                           vu_r.pos, vu_r.hold, vu_r.over > 0, "R");
//   MID/SID  same call, feeding m = (l+r)*0.5 and s = (l-r)*0.5, labels "M"/"S"
//   ONE PLATE, TWO NEEDLES
//           rk_vu_face(x, y, w, h, 0, theme, "");
//           rk_vu_ink(vu_l.pos, vu_l.hold, 0, 0);
//           rk_vu_ink(vu_r.pos, vu_r.hold, 0, 1);
//           rk_vu_cap_led(vu_l.over > 0 || vu_r.over > 0);
//
// mode 0 = level, 1 = gain reduction. theme 0..19 (-1 host). label "" for none.

function rk_vu_face(x, y, w, h, mode, theme, label) (
  theme >= 0 ? rk_vu_theme(theme);      // -1: the host set the rkvu_* colours itself
  rkvu_gmode = mode == 1;               // the labels this face carries decide its geometry
  rk_vu_geom(x, y, w, h);
  // ONE scale authority: the rect. rkvu_r is already in the canvas's own
  // pixels (on Windows gfx_w itself grows with the display scale, wiki 4.6),
  // so the numerals follow r alone (rk_vu_geom sizes them) and gfx_ext_retina
  // only sets the smallest legible size. Multiplying r by it again (until
  // 2026-09-25) scaled the text twice on a scaled screen (1.5x too big at
  // 150 %), and the fit then hid the numerals it had inflated. (By the wiki
  // 4.6 rule; this machine is 100 %, so that case is reasoned, not measured.)
  // rkvu_fsz_x is the exact size the numeral fit reasons with; rkvu_fsz is
  // the whole-pixel size everything draws at.
  _rk_vu_plate(rkvu_ox, rkvu_oy, rkvu_ow, rkvu_oh);
  _rk_vu_scale(mode, rkvu_fsz);
  _rk_vu_label(label, rkvu_fsz);
);

// One movement's ink on the face last drawn: band, hold needle, needle.
// In GR mode `pos`/`hold` are dB of reduction and the scale is 0..20 dB,
// linear in dB, so 6 dB sits at 0.3 of the travel.
function rk_vu_ink(pos, hold, mode, slot) local(frac, hfrac) (
  frac  = mode == 1 ? min(max(pos  / 20, 0), 1)
                    : rk_vu_db2frac(20 * log10(max(pos,  0.0000001)));
  hfrac = mode == 1 ? min(max(hold / 20, 0), 1)
                    : rk_vu_db2frac(20 * log10(max(hold, 0.0000001)));
  // rkvu_hold_style: 0 none, 1 needle, 2 arc (band to the held value), 3 both.
  // rk_vu_draw sets it from the instance; pair callers set it themselves.
  _rk_vu_arc_fill(rkvu_hold_style >= 2 ? max(hfrac, frac) : frac, slot);
  (rkvu_hold_style == 1 || rkvu_hold_style == 3) && RKVU_HOLD_S > 0 && hfrac > frac + 0.005 ?
    _rk_vu_needle(hfrac, 1, 0.42, rkvu_nd_r, rkvu_nd_g, rkvu_nd_b);
  _rk_vu_needle(frac, max(2, floor(rkvu_r * 0.018)), 1,
                rkvu_nd_r, rkvu_nd_g, rkvu_nd_b);
);

// The readout: a box on the lower-left of the face, and PEAK beside the LED.
function _rk_vu_readout(val, is_peak, blank)
local(bw, bh, bx, by, tw, th, lx, ly, lr, fb) (
  lr = rkvu_r * 0.040; lx = rkvu_cx + rkvu_r * 0.62; ly = rkvu_cy - rkvu_r * 0.30;
  gfx_setfont(1, "Arial", max(7 * rkvu_sc, floor(rkvu_fsz * 0.85 + 0.5)));
  gfx_set(rkvu_ik_r, rkvu_ik_g, rkvu_ik_b, 0.70);
  gfx_measurestr("PEAK", tw, th);
  gfx_x = lx - lr * 2.2 - tw; gfx_y = ly - th * 0.5; gfx_drawstr("PEAK");

  // The box holds its widest reading at any size: below a ~50 px radius the
  // proportional 0.16r box was shorter than its own minimum-size text.
  // Bold from RKVU_BOLD px only: an 8 or 9 px bold "5" draws as a "6", and
  // this is the one number on the face a user reads as a value.
  fb = max(8 * rkvu_sc, floor(rkvu_fsz * 0.95 + 0.5));
  gfx_setfont(1, "Arial", fb, fb >= RKVU_BOLD ? 'b' : 0);
  blank ? strcpy(#_rkvu_ro, "--") : sprintf(#_rkvu_ro, is_peak ? "%.1f" : "%+.1f", val);
  gfx_measurestr(is_peak ? "-60.0" : "-20.0", bw, bh);
  gfx_measurestr(#_rkvu_ro, tw, th);
  bw = max(rkvu_r * 0.42, max(bw, tw) + 6 * rkvu_sc);
  bh = max(rkvu_r * 0.16, th + 2 * rkvu_sc);
  bx = rkvu_fx + rkvu_r * 0.10; by = rkvu_fy + rkvu_fh - bh - rkvu_r * 0.08;
  gfx_set(0, 0, 0, 0.30);
  _rk_vu_rrect(bx, by, bw, bh, 3 * rkvu_sc);
  gfx_set(rkvu_ik_r, rkvu_ik_g, rkvu_ik_b, 1);
  gfx_x = bx + bw * 0.5 - tw * 0.5; gfx_y = by + bh * 0.5 - th * 0.5;
  gfx_drawstr(#_rkvu_ro);
);

// Cover, LED, then the glass over the lot. Last call in every pattern.
function rk_vu_cap_led(over) ( _rk_vu_cover(); _rk_vu_led(over); _rk_vu_glass(); );

// The legacy map: three straight segments through four points MEASURED off
// the shipping meter - where this movement settles on a 1 kHz sine at
// -24 / -9 / -2 / 0 dBFS, against what that meter reads there. Returns a
// linear ratio so rk_vu_ink's 20*log10 lands on the old reading. Pair
// callers in legacy mode pass their pos/hold through this first.
function rk_vu_legacy_ratio(p) local(l) (
  l = p <= 0.3389 ? (p - 0.0603) / (0.3389 - 0.0603) * 0.3102
    : p <= 0.7588 ? 0.3102 + (p - 0.3389) / (0.7588 - 0.3389) * (0.7861 - 0.3102)
    :               0.7861 + (p - 0.7588) / (0.9553 - 0.7588) * (1.0 - 0.7861);
  10 ^ ((min(max(l, 0), 1) * 23 - 20) / 20);
);

// One movement, one rect.
function rk_vu_draw(x, y, w, h, mode, theme, label) local(v, pk) (
  rkvu_nums = this.nums;                   // this meter's numerals setting, for rk_vu_geom
  rkvu_flat = this.flat;                   // ...and whether a wide rect may flatten it
  rk_vu_face(x, y, w, h, mode, theme, label);
  rkvu_hold_style = this.hold_style;
  this.legacy && mode == 0
    ? rk_vu_ink(rk_vu_legacy_ratio(this.pos), rk_vu_legacy_ratio(this.hold), mode, 0)
    : rk_vu_ink(this.pos, this.hold, mode, 0);
  rk_vu_cap_led(this.over > 0);
  this.readout > 0 && mode == 0 && !rkvu_flat_on ? (
    this.readout <= 2 ? (
      v = this.readout == 2 ? this.hold : this.pos;
      this.legacy ? v = rk_vu_legacy_ratio(v);
      _rk_vu_readout(min(max(20 * log10(max(v, 0.0000001)), -20), 3), 0, v < 0.0000001);
    ) : (
      pk = this.readout == 4 ? this.pk_max : this.pk_cur;
      _rk_vu_readout(20 * log10(max(pk, 0.0000001)), 1, pk < 0.0000001);
    );
  );
  rkvu_nums = 1;                           // the defaults again, for rk_vu_face / rk_vu_geom callers
  rkvu_flat = 0;
);

// Two movements, two plates, one rect — stereo or mid/side.
// One movement at a CENTRE and RADIUS, in the same box vu_kbsg's
// mtr_vu_real_draw used (2.6r wide, 1.7r tall, centre 1.4r below the top).
// A plugin that placed its meter that way changes one call and keeps its
// layout numbers.
function rk_vu_draw_at(cx, cy, r, mode, theme, label) (
  this.rk_vu_draw(cx - r * 1.3, cy - r * 1.4, r * 2.6, r * 1.7, mode, theme, label);
);

function rk_vu_draw_pair(x, y, w, h, mode, theme,
                         posA, holdA, overA, labA,
                         posB, holdB, overB, labB) local(mw, gap) (
  gap = w * 0.025;
  mw  = (w - gap) * 0.5;
  rk_vu_face(x, y, mw, h, mode, theme, labA);
  rk_vu_ink(posA, holdA, mode, 0);
  rk_vu_cap_led(overA);
  rk_vu_face(x + mw + gap, y, mw, h, mode, theme, labB);
  rk_vu_ink(posB, holdB, mode, 0);
  rk_vu_cap_led(overB);
);

// ── Theme picker ────────────────────────────────────────────────────────
// Click the coil cover and a sheet opens showing every theme as a live
// miniature of this same face; click a card to choose it, click anywhere
// else to close. Call this LAST in @gfx, after everything the sheet may
// cover, with the rect the meter was drawn in and the theme it is showing.
// Needs the library's mouse globals: mx, my, lmb_down (a press edge, not the
// held state). Returns the chosen theme on the frame it is chosen, else -1 -
// write it into your theme slider and slider_automate it.
//
// The cards are drawn with rk_vu_face, so while the sheet is open the colour
// globals end up holding the last card's palette. A host that draws with
// theme -1 applies its own palette every frame before drawing, as it should.
function rk_vu_picker(x, y, w, h, cur)
local(chosen, cols, rows, sw, sh, sx, sy, cw, ch, fw, fh, i, cx, cy, hit, hover,
      hx, hy, hw, hh, tw, th) (
  chosen = -1;
  // The cover to click is where THIS meter's face put it: a small face's
  // scale radius depends on its labels, and a GR instance carries GR labels.
  // (rk_vu_geom also sets rkvu_sc: the sheet's fixed sizes are logical px.)
  // A ticks-only meter has the bigger dial, so its numerals setting counts too.
  rkvu_gmode = this.gr ? 1 : 0;
  rkvu_nums = this.nums;
  rkvu_flat = this.flat;                 // a flat meter's cover is where ITS pivot is
  rk_vu_geom(x, y, w, h);
  rkvu_flat = 0;                         // the sheet's cards are plain faces
  hw = rkvu_r * 0.38; hx = rkvu_cx - hw * 0.5;
  // The cover, down to the plate's edge. On a flat face whose pivot is below
  // the plate there is none: the spot is the band where the needle comes out
  // of the bezel, as tall as the cover would be.
  hy = min(rkvu_cy, rkvu_fb) - rkvu_r * 0.19; hh = rkvu_oy + rkvu_oh - hy;
  hover = mx >= hx && mx < hx + hw && my >= hy && my < hy + hh;

  !this.pk_open ? (
    hover ? ( gfx_set(1, 1, 1, 0.10);
              rkvu_cy <= rkvu_fb ? gfx_circle(rkvu_cx, rkvu_cy, rkvu_r * 0.19, 1, 1)
                                 : gfx_rect(hx, hy, hw, rkvu_fb - hy); );
    hover && lmb_down ? this.pk_open = 1;
  ) : (
    cols = 5; rows = ceil(RKVU_THEMES / cols);
    sw = max(w, 380 * rkvu_sc); sh = max(h, 264 * rkvu_sc);
    sx = min(max(x, 0), max(gfx_w - sw, 0)); sy = min(max(y, 0), max(gfx_h - sh, 0));
    gfx_set(0, 0, 0, 0.72); gfx_rect(0, 0, gfx_w, gfx_h);
    gfx_set(0.10, 0.10, 0.11, 1); _rk_vu_rrect(sx, sy, sw, sh, 6 * rkvu_sc);
    cw = (sw - 12 * rkvu_sc) / cols; ch = (sh - 32 * rkvu_sc) / rows;
    fw = cw - 8 * rkvu_sc; fh = min(fw / 1.6, ch - 16 * rkvu_sc);
    gfx_setfont(1, "Arial", 11 * rkvu_sc, 'b'); gfx_set(0.85, 0.85, 0.85, 1);
    gfx_x = sx + 8 * rkvu_sc; gfx_y = sy + 5 * rkvu_sc; gfx_drawstr("THEME");
    i = 0;
    loop(RKVU_THEMES,
      cx = sx + 6 * rkvu_sc + (i % cols) * cw; cy = sy + 20 * rkvu_sc + floor(i / cols) * ch;
      hit = mx >= cx && mx < cx + cw && my >= cy && my < cy + ch;
      (hit || i == cur) ? ( gfx_set(1, 1, 1, hit ? 0.18 : 0.09);
                            _rk_vu_rrect(cx, cy, cw - 2 * rkvu_sc, ch - 2 * rkvu_sc, 4 * rkvu_sc); );
      // "this same face": a GR meter's cards are GR faces (they were always level
      // faces; outside audit round 2, 2026-09-25). Every host draws the instance
      // it calls this through in that instance's own mode, so this.gr is the face.
      rk_vu_face(cx + 4 * rkvu_sc, cy + 2 * rkvu_sc, fw, fh, this.gr ? 1 : 0, i, "");
      rk_vu_theme_name(i, #_rkvu_pn);
      gfx_setfont(1, "Arial", 9 * rkvu_sc); gfx_set(0.85, 0.85, 0.85, 1);
      gfx_measurestr(#_rkvu_pn, tw, th);
      gfx_x = cx + cw * 0.5 - tw * 0.5; gfx_y = cy + (3 * rkvu_sc) + fh; gfx_drawstr(#_rkvu_pn);
      hit && lmb_down ? chosen = i;
      i += 1;
    );
    lmb_down ? this.pk_open = 0;
  );
  rkvu_nums = 1;
  chosen;
);
