// ── the widgets that came out of Swing, on the tab with room for them ──
slider1 == 1 ? (
  gfx_setfont(1,"Arial",max(9,floor(11*sc)),'b'); gfx_set(0.72,0.74,0.80);
  gfx_x=ox+sc*14; gfx_y=sc*292; gfx_drawstr("TEXT · COLOUR · ENVELOPE · DROPDOWN · INK · TOOLTIP");

  // rk_textfield — click it and type. Enter commits, ESC puts it back. SPACE
  // reaches it only because the options line asks for want_all_kb.
  rk_text_run(tfmem, #el_text, ox+sc*14, sc*312, sc*160, sc*24, 24,
              0.29, 0.62, 1.00);
  mx >= ox+sc*14 && mx < ox+sc*174 && my >= sc*312 && my < sc*336 ?
    rk_tooltip_check(901, "rk_textfield — click to edit, Enter commits, ESC restores");

  // rk_colorpick — swatches for speed, the strip for the one you wanted. The
  // widget writes nothing; el_hue is ours.
  el_hue = rk_color_pick(cpmem, ox+sc*14, sc*348, sc*300, sc*18, el_hue, 0.75, 0.55);
  rk_color_set(el_hue, 0.75, 0.55);
  gfx_rect(ox+sc*322, sc*348, sc*40, sc*18);
  gfx_set(0.25,0.26,0.30,0.8); gfx_rect(ox+sc*322, sc*348, sc*40, sc*18, 0);
  mx >= ox+sc*14 && mx < ox+sc*362 && my >= sc*348 && my < sc*366 ?
    rk_tooltip_check(904, "rk_colorpick — click a swatch, drag or wheel the strip");

  // rk_adsr — fixed zones per segment and log time, so the short end of the
  // range is both visible and grabbable. Writes nothing; these four are ours.
  rk_adsr_run(admem, ox+sc*14, sc*378, sc*348, sc*64,
              el_a, el_d, el_s, el_r, 1000, 10000, 5000, 0.29, 0.62, 1.00);
  rk_adsr_moved ? (
    el_a = rk_adsr_a; el_d = rk_adsr_d; el_s = rk_adsr_s; el_r = rk_adsr_r;
    el_pre = 0;   // drawn by hand now, so no preset is ticked
  );
  gfx_setfont(1,"Arial",max(8,floor(10*sc))); gfx_set(0.55,0.58,0.64);
  sprintf(#_el_s, "A %.0f   D %.0f   S %.2f   R %.0f ms", el_a, el_d, el_s, el_r);
  gfx_x = ox+sc*372; gfx_y = sc*378; gfx_drawstr(#_el_s);
  mx >= ox+sc*14 && mx < ox+sc*362 && my >= sc*378 && my < sc*442 ?
    rk_tooltip_check(905, "rk_adsr — drag a corner. Time is log, so 1-50 ms is reachable");

  // rk_popup — the box is ours, the list is the widget's. A click on the box
  // opens the menu, and the pick comes back from rk_popup_run at the end of
  // @gfx. The menu is rebuilt every frame so its tick follows the envelope:
  // pick a preset and it is ticked, drag a corner and nothing is. The header,
  // the tick and the empty separator row are gfx_showmenu's own syntax.
  sprintf(#el_menu, "#ENVELOPE|%sPluck|%sKeys|%sPad|%sSwell||%sDefault",
          el_pre == 2 ? "!" : "", el_pre == 3 ? "!" : "", el_pre == 4 ? "!" : "",
          el_pre == 5 ? "!" : "", el_pre == 7 ? "!" : "");
  _dx = ox+sc*372; _dy = sc*400; _dw = sc*150; _dh = sc*24;
  _dhov = mx >= _dx && mx < _dx + _dw && my >= _dy && my < _dy + _dh;
  gfx_set(0, 0, 0, 0.30); gfx_rect(_dx, _dy, _dw, _dh);
  gfx_set(0.29, 0.62, 1.00, rk_popup_active(ppmem) ? 0.95 : _dhov ? 0.65 : 0.30);
  gfx_rect(_dx, _dy, _dw, 1); gfx_rect(_dx, _dy + _dh - 1, _dw, 1);
  gfx_rect(_dx, _dy, 1, _dh); gfx_rect(_dx + _dw - 1, _dy, 1, _dh);
  gfx_setfont(1,"Arial",max(8,floor(_dh*0.55))); gfx_set(0.84,0.855,0.886,1);
  gfx_x = _dx + sc*8; gfx_y = _dy + (_dh - gfx_texth) * 0.5;
  gfx_drawstr(el_pre_name(el_pre));
  gfx_set(0.29, 0.62, 1.00, 0.85);
  gfx_triangle(_dx + _dw - sc*15, _dy + _dh*0.42, _dx + _dw - sc*7, _dy + _dh*0.42,
               _dx + _dw - sc*11, _dy + _dh*0.64);
  _dhov && lmb_down && !rk_popup_active(ppmem) ? rk_popup_open(ppmem, _dx, _dy + _dh, _dw);
  _dhov ? rk_tooltip_check(906, "rk_popup — a menu that draws itself: #header, !tick, separator");

  // rk_ink — the SAME call on three lightnesses of the colour you just picked.
  // Drag the picker above and watch the label flip from dark to light on its
  // own: that is the whole widget. A hardcoded label colour would vanish on
  // one of these three.
  _ii = 0;
  loop(3,
    el_hue <= -1.5 ? ( _cr = 0.20; _cg = 0.20; _cb = 0.22; ) :
    el_hue <  0    ? ( _cr = 0.82; _cg = 0.82; _cb = 0.85; ) :
    ( rk_color_hsl(el_hue, 0.75, 0.22 + _ii * 0.30);
      _cr = rk_color_r; _cg = rk_color_g; _cb = rk_color_b; );
    gfx_set(_cr, _cg, _cb, 1);
    gfx_rect(ox+sc*(500 + _ii*64), sc*312, sc*60, sc*24);
    rk_ink_for(_cr, _cg, _cb);
    gfx_setfont(1,"Arial",max(8,floor(10*sc)));
    gfx_x = ox+sc*(508 + _ii*64); gfx_y = sc*318; gfx_drawstr("label");
    _ii += 1;
  );
  mx >= ox+sc*500 && mx < ox+sc*688 && my >= sc*312 && my < sc*336 ?
    rk_tooltip_check(903, "rk_ink — one call; the label inks itself against whatever is behind it");
);

