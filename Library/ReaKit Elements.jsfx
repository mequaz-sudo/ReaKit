desc:ReaKit Elements
// @description ReaKit - UI widget library for JSFX (knobs, faders, buttons, meters, VU, pads, piano)
// @author Quaz (EON Studios)
// @version 1.2.1
// @changelog
//   Arc slider fix: the arc BAND now sits on its own thumb. gfx_arc measures
//   angles from 12 o'clock while the thumb/tick math measures from 3 o'clock;
//   the band was drawn 90 degrees away from the thumb (dead zone at 3 o'clock
//   instead of 6). Band angles now get the +90 offset; thumb, ticks and
//   interaction were always correct and are untouched.
// @about
//   19 procedural knob styles, 17 slider/fader types, 10 button styles,
//   12 meter styles with DSP included, an analog VU with 11 face themes,
//   a drum pad grid and a piano keyboard (horizontal or vertical).
//   No bitmaps - everything is drawn in code and scales to any size.
//   The showcase is organized into five category tabs (the tab bar itself is
//   the library's btn_tab widget), scales uniformly to fit its window (resize
//   the FX window and the whole UI follows) and renders at full resolution on
//   HiDPI/Retina.
//   This file is the all-elements showcase; the library itself lives in the
//   *_kbsg.jsfx-inc files installed alongside it. The rk_ui_*.jsfx-inc files
//   are compatibility aliases for .jsfx exported by Forge.
// @provides
//   [nomain] knobs_kbsg.jsfx-inc
//   [nomain] sliders_kbsg.jsfx-inc
//   [nomain] buttons_kbsg.jsfx-inc
//   [nomain] vu_kbsg.jsfx-inc
//   [nomain] meters_kbsg.jsfx-inc
//   [nomain] rk_padgrid.jsfx-inc
//   [nomain] rk_piano.jsfx-inc
//   [nomain] rk_ui_math.jsfx-inc
//   [nomain] rk_ui_core.jsfx-inc
//   [nomain] rk_ui_knob.jsfx-inc
//   [nomain] rk_ui_button.jsfx-inc
//   [nomain] rk_ui_slider.jsfx-inc
//   [nomain] rk_ui_meter.jsfx-inc
//   [nomain] rk_ui_vu.jsfx-inc
tags: effect

// Requires the EON ReaKit *_kbsg.jsfx-inc libs on the JSFX import path
//   (knobs_kbsg must be the dispatcher build that defines rk_knob_draw).

slider1:0<0,4,1{Knobs,Buttons,Sliders,Meters,Pads & Keys}>-Tab
slider3:60<0,100,0.01>-SSL
slider4:6<-24,24,0.01>-Vari-Mu
slider5:70<0,100,0.01>-API
slider6:55<0,100,0.01>-WS
slider7:40<0,100,0.01>-Neve
slider8:65<0,100,0.01>-Joanny
slider9:50<0,100,0.01>-MPC
slider10:35<0,100,0.01>-Jog
slider11:80<0,100,0.01>-Spice
slider12:50<0,100,0.01>-Encoder
slider13:40<0,100,0.01>-Pultec
slider14:65<0,100,0.01>-Ableton
slider15:55<0,100,0.01>-FL
slider16:45<0,100,0.01>-ProTools
slider17:60<0,100,0.01>-FabFilter
slider18:75<0,100,0.01>-Serum
slider19:35<0,100,0.01>-Roland
slider20:55<0,100,0.01>-PultecCr
slider21:62<0,100,0.01>-NeveAlt
slider23:1<0,1,1{Off,On}>-Bypass
slider24:1<0,1,1{Off,On}>-EQ
slider25:1<0,1,1{Off,On}>-Link
slider26:1<0,1,1{Off,On}>-On
slider27:1<0,1,1{Off,On}>-Mode
slider28:1<0,1,1{Off,On}>-Pwr
slider29:1<0,1,1{Off,On}>-Stomp
slider30:1<0,2,1{0: 6,1: 12,2: 24}>-Slope
slider31:0<0,2,1{0: Amp,1: EQ,2: Mod}>-Page
slider32:1<0,2,1{0: Clean,1: Warm,2: Tube}>-Type
slider34:65<0,100,0.01>-Std
slider35:72<0,100,0.01>-Fill
slider36:50<0,100,0.01>-Step
slider37:30<-100,100,0.01>-Bipolar
slider38:60<0,100,0.01>-Mini
slider39:70<0,100,0.01>-Arc
slider41:70<0,100,0.01>-V
slider42:78<0,100,0.01>-LED
slider43:55<0,100,0.01>-Groove
slider44:35<-100,100,0.01>-SSL
slider45:60<-100,100,0.01>-Neve
slider46:40<-100,100,0.01>-API
slider47:72<-100,100,0.01>-Tube
slider69:74<0,100,0.01>-PT
slider70:0<-100,100,0.01>-MPC
slider71:66<0,100,0.01>-4K
slider73:5<0,15,1>-Pads
slider74:60<0,127,1>-Keys
slider75:55<0,127,1>-KeysV

import knobs_kbsg.jsfx-inc
import buttons_kbsg.jsfx-inc
import sliders_kbsg.jsfx-inc
import vu_kbsg.jsfx-inc
import meters_kbsg.jsfx-inc
import rk_padgrid.jsfx-inc
import rk_piano.jsfx-inc

@init
gfx_ext_retina = 1;   // HiDPI/Retina: REAPER doubles the surface, sc math below follows
freemem = 440;
KS = 16;
// freemem starts at 440: vu_kbsg owns addresses 0..437
km = freemem; freemem += 19 * KS;   // 16 words/knob
btnmem = freemem; freemem += 11 * 8;   // 8 words/button-family (10 demo styles + nav tab bar)
sldmem = freemem; freemem += 16 * 16;  // 16 words/slider
pgdmem_0 = freemem; freemem += 17;     // pad grid: 16 hover ramps + the held pad
WF_LEN = 256;
wf_0 = freemem; freemem += WF_LEN; wfp_0 = 0;
mtr_base = freemem; freemem += 1380; meter_init(mtr_base);   // meters_kbsg DSP state
mtr_en_rms = 1;   // enable (set after meter_init resets flags)
mtr_en_gonio = 1;   // enable (set after meter_init resets flags)
mtr_en_phase = 1;   // enable (set after meter_init resets flags)
mtr_en_wave = 1;   // enable (set after meter_init resets flags)
mtr_en_spectrum = 1;   // enable (set after meter_init resets flags)
mtr_en_lufs = 1;   // enable (set after meter_init resets flags)
vu_0.vu_init(2);   // VU ballistics (speed 2)
zm_theme = 0;      // analog VU face theme (scroll over the meter to cycle)

@slider

@block

@sample
vu_0.vu_sample(abs(spl0));
mtr_0 = max(abs(spl0), mtr_0 * 0.999);   // placeholder peak-decay feed
meter_process_sample(spl0, spl1);   // drives mtr_peak_l/r, mtr_rms_l/r, mtr_phase, …
wf_0[wfp_0] = spl0; wfp_0 = wfp_0 < WF_LEN - 1 ? wfp_0 + 1 : 0;
// audio passthrough — insert DSP above; spl0/spl1 left unchanged

@gfx 740 480
gfx_clear = 0x2e1a1a;   // canvas #1a1a2e packed as r+g*256+b*65536

// --- fit-to-window scale -------------------------------------------------
// Design canvas is 740x480; sc maps design px -> window px so the active
// tab is always visible at any window size (and crisp on HiDPI, since
// gfx_w/gfx_h arrive pre-doubled when gfx_ext_retina kicks in).
sc = min(gfx_w / 740, gfx_h / 480);
sc < 0.35 ? sc = 0.35;
zoom = sc;              // vu_kbsg barmeter_hor multiplies its coords by this

// --- per-frame input globals required by the kbsg libs ---
mx = mouse_x; my = mouse_y;
LMB = mouse_cap & 1; lmb_down = LMB && !_pLMB; _pLMB = LMB;
CTRL = mouse_cap & 4; SHIFT = mouse_cap & 8;
dt = time_precise() - _lt; _lt = time_precise(); hv_speed = 11; tau = 2*$pi;
frame_wheel = mouse_wheel / 120; mouse_wheel = 0;

// REAKIT ELEMENTS (title)
gfx_setfont(1,"Arial",max(9,floor(14*sc)),'b'); gfx_set(0.85,0.20,0.11); gfx_x=sc*14; gfx_y=sc*18; gfx_drawstr("REAKIT ELEMENTS");

// Nav tab bar — buttons_kbsg btn_tab, the library's own tab widget
bm = btnmem + 10*8;
_nt = btn_tab_interact(bm, sc*190, sc*10, sc*104, sc*28, 5, sc*4, slider1);
_nt != slider1 ? ( slider1 = _nt; slider_automate(slider1); );
gfx_setfont(1,"Arial",max(9,floor(12*sc)),'b');
btn_tab_draw(sc*190, sc*10, sc*104, sc*28, 0, slider1, "KNOBS", bm[0]);
btn_tab_draw(sc*298, sc*10, sc*104, sc*28, 1, slider1, "BUTTONS", bm[0]);
btn_tab_draw(sc*406, sc*10, sc*104, sc*28, 2, slider1, "SLIDERS", bm[0]);
btn_tab_draw(sc*514, sc*10, sc*104, sc*28, 3, slider1, "METERS", bm[0]);
btn_tab_draw(sc*622, sc*10, sc*104, sc*28, 4, slider1, "PADS/KEYS", bm[0]);

// ═══════════════════════ TAB 0 · KNOBS ═══════════════════════
slider1 == 0 ? (

// KNOBS — all 19 styles (select one · scroll to change) (label)
gfx_setfont(1,"Arial",max(9,floor(11*sc)),'b'); gfx_set(0.72,0.74,0.80); gfx_x=sc*14; gfx_y=sc*56; gfx_drawstr("KNOBS — all 19 styles (select one · scroll to change)");

// SSL (knob / ssl)
m = km + 0*KS;
_v = rk_knob_interact(1, m, sc*50, sc*160, sc*32, slider3, 0, 100, 60, 0);
_v != slider3 ? ( slider3 = _v; slider_automate(slider3); );
rk_knob_draw(1, sc*50, sc*160, sc*32, slider3, 0, 100, 0, m[0], 0.29,0.62,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("SSL",_tw,_th); gfx_x=sc*50-_tw/2; gfx_y=sc*196; gfx_drawstr("SSL");

// Vari-Mu (knob / varimu)
m = km + 1*KS;
_v = rk_knob_interact(2, m, sc*121, sc*160, sc*32, slider4, -24, 24, 6, 0);
_v != slider4 ? ( slider4 = _v; slider_automate(slider4); );
rk_knob_draw(2, sc*121, sc*160, sc*32, slider4, -24, 24, 1, m[0], 0.29,0.87,0.50, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Vari-Mu",_tw,_th); gfx_x=sc*121-_tw/2; gfx_y=sc*196; gfx_drawstr("Vari-Mu");

// API (knob / api)
m = km + 2*KS;
_v = rk_knob_interact(3, m, sc*192, sc*160, sc*32, slider5, 0, 100, 70, 0);
_v != slider5 ? ( slider5 = _v; slider_automate(slider5); );
rk_knob_draw(3, sc*192, sc*160, sc*32, slider5, 0, 100, 0, m[0], 0.98,0.80,0.08, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("API",_tw,_th); gfx_x=sc*192-_tw/2; gfx_y=sc*196; gfx_drawstr("API");

// WS (knob / ws)
m = km + 3*KS;
_v = rk_knob_interact(4, m, sc*263, sc*160, sc*32, slider6, 0, 100, 55, 0);
_v != slider6 ? ( slider6 = _v; slider_automate(slider6); );
rk_knob_draw(4, sc*263, sc*160, sc*32, slider6, 0, 100, 0, m[0], 0.98,0.45,0.09, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("WS",_tw,_th); gfx_x=sc*263-_tw/2; gfx_y=sc*196; gfx_drawstr("WS");

// Neve (knob / neve)
m = km + 4*KS;
_v = rk_knob_interact(5, m, sc*334, sc*160, sc*32, slider7, 0, 100, 40, 0);
_v != slider7 ? ( slider7 = _v; slider_automate(slider7); );
rk_knob_draw(5, sc*334, sc*160, sc*32, slider7, 0, 100, 0, m[0], 0.81,0.23,0.19, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Neve",_tw,_th); gfx_x=sc*334-_tw/2; gfx_y=sc*196; gfx_drawstr("Neve");

// Joanny (knob / witti)
m = km + 5*KS;
_v = rk_knob_interact(6, m, sc*405, sc*160, sc*32, slider8, 0, 100, 65, 0);
_v != slider8 ? ( slider8 = _v; slider_automate(slider8); );
rk_knob_draw(6, sc*405, sc*160, sc*32, slider8, 0, 100, 0, m[0], 0.64,0.46,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Joanny",_tw,_th); gfx_x=sc*405-_tw/2; gfx_y=sc*196; gfx_drawstr("Joanny");

// MPC (knob / mpc)
m = km + 6*KS;
_v = rk_knob_interact(7, m, sc*476, sc*160, sc*32, slider9, 0, 100, 50, 0);
_v != slider9 ? ( slider9 = _v; slider_automate(slider9); );
rk_knob_draw(7, sc*476, sc*160, sc*32, slider9, 0, 100, 0, m[0], 0.17,0.73,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("MPC",_tw,_th); gfx_x=sc*476-_tw/2; gfx_y=sc*196; gfx_drawstr("MPC");

// Jog (knob / jog)
m = km + 7*KS;
_v = rk_knob_interact(8, m, sc*547, sc*160, sc*32, slider10, 0, 100, 35, 0);
_v != slider10 ? ( slider10 = _v; slider_automate(slider10); );
rk_knob_draw(8, sc*547, sc*160, sc*32, slider10, 0, 100, 0, m[0], 0.86,0.72,0.42, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Jog",_tw,_th); gfx_x=sc*547-_tw/2; gfx_y=sc*196; gfx_drawstr("Jog");

// Spice (knob / sp)
m = km + 8*KS;
_v = rk_knob_interact(10, m, sc*618, sc*160, sc*32, slider11, 0, 100, 80, 0);
_v != slider11 ? ( slider11 = _v; slider_automate(slider11); );
rk_knob_draw(10, sc*618, sc*160, sc*32, slider11, 0, 100, 0, m[0], 0.89,0.29,0.29, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Spice",_tw,_th); gfx_x=sc*618-_tw/2; gfx_y=sc*196; gfx_drawstr("Spice");

// Encoder (knob / encoder)
m = km + 9*KS;
_v = rk_knob_interact(11, m, sc*689, sc*160, sc*32, slider12, 0, 100, 50, 0);
_v != slider12 ? ( slider12 = _v; slider_automate(slider12); );
rk_knob_draw(11, sc*689, sc*160, sc*32, slider12, 0, 100, 0, m[0], 0.29,0.62,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Encoder",_tw,_th); gfx_x=sc*689-_tw/2; gfx_y=sc*196; gfx_drawstr("Encoder");

// Pultec (knob / pultec)
m = km + 10*KS;
_v = rk_knob_interact(12, m, sc*85, sc*320, sc*32, slider13, 0, 100, 40, 0);
_v != slider13 ? ( slider13 = _v; slider_automate(slider13); );
rk_knob_draw(12, sc*85, sc*320, sc*32, slider13, 0, 100, 0, m[0], 0.86,0.72,0.42, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Pultec",_tw,_th); gfx_x=sc*85-_tw/2; gfx_y=sc*356; gfx_drawstr("Pultec");

// Ableton (knob / ableton)
m = km + 11*KS;
_v = rk_knob_interact(13, m, sc*156, sc*320, sc*32, slider14, 0, 100, 65, 0);
_v != slider14 ? ( slider14 = _v; slider_automate(slider14); );
rk_knob_draw(13, sc*156, sc*320, sc*32, slider14, 0, 100, 0, m[0], 0.29,0.87,0.50, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Ableton",_tw,_th); gfx_x=sc*156-_tw/2; gfx_y=sc*356; gfx_drawstr("Ableton");

// FL (knob / fl)
m = km + 12*KS;
_v = rk_knob_interact(14, m, sc*227, sc*320, sc*32, slider15, 0, 100, 55, 0);
_v != slider15 ? ( slider15 = _v; slider_automate(slider15); );
rk_knob_draw(14, sc*227, sc*320, sc*32, slider15, 0, 100, 0, m[0], 0.98,0.80,0.08, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("FL",_tw,_th); gfx_x=sc*227-_tw/2; gfx_y=sc*356; gfx_drawstr("FL");

// ProTools (knob / pt)
m = km + 13*KS;
_v = rk_knob_interact(15, m, sc*298, sc*320, sc*32, slider16, 0, 100, 45, 0);
_v != slider16 ? ( slider16 = _v; slider_automate(slider16); );
rk_knob_draw(15, sc*298, sc*320, sc*32, slider16, 0, 100, 0, m[0], 0.29,0.62,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("ProTools",_tw,_th); gfx_x=sc*298-_tw/2; gfx_y=sc*356; gfx_drawstr("ProTools");

// FabFilter (knob / fabfilter)
m = km + 14*KS;
_v = rk_knob_interact(16, m, sc*369, sc*320, sc*32, slider17, 0, 100, 60, 0);
_v != slider17 ? ( slider17 = _v; slider_automate(slider17); );
rk_knob_draw(16, sc*369, sc*320, sc*32, slider17, 0, 100, 0, m[0], 0.29,0.87,0.50, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("FabFilter",_tw,_th); gfx_x=sc*369-_tw/2; gfx_y=sc*356; gfx_drawstr("FabFilter");

// Serum (knob / serum)
m = km + 15*KS;
_v = rk_knob_interact(17, m, sc*440, sc*320, sc*32, slider18, 0, 100, 75, 0);
_v != slider18 ? ( slider18 = _v; slider_automate(slider18); );
rk_knob_draw(17, sc*440, sc*320, sc*32, slider18, 0, 100, 0, m[0], 0.64,0.46,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Serum",_tw,_th); gfx_x=sc*440-_tw/2; gfx_y=sc*356; gfx_drawstr("Serum");

// Roland (knob / roland)
m = km + 16*KS;
_v = rk_knob_interact(18, m, sc*511, sc*320, sc*32, slider19, 0, 100, 35, 0);
_v != slider19 ? ( slider19 = _v; slider_automate(slider19); );
rk_knob_draw(18, sc*511, sc*320, sc*32, slider19, 0, 100, 0, m[0], 0.98,0.45,0.09, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Roland",_tw,_th); gfx_x=sc*511-_tw/2; gfx_y=sc*356; gfx_drawstr("Roland");

// PultecCr (knob / pultec_cream)
m = km + 17*KS;
_v = rk_knob_interact(19, m, sc*582, sc*320, sc*32, slider20, 0, 100, 55, 0);
_v != slider20 ? ( slider20 = _v; slider_automate(slider20); );
rk_knob_draw(19, sc*582, sc*320, sc*32, slider20, 0, 100, 0, m[0], 0.86,0.72,0.42, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("PultecCr",_tw,_th); gfx_x=sc*582-_tw/2; gfx_y=sc*356; gfx_drawstr("PultecCr");

// NeveAlt (knob / neve_alt)
m = km + 18*KS;
_v = rk_knob_interact(20, m, sc*653, sc*320, sc*32, slider21, 0, 100, 62, 0);
_v != slider21 ? ( slider21 = _v; slider_automate(slider21); );
rk_knob_draw(20, sc*653, sc*320, sc*32, slider21, 0, 100, 0, m[0], 0.81,0.23,0.19, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("NeveAlt",_tw,_th); gfx_x=sc*653-_tw/2; gfx_y=sc*356; gfx_drawstr("NeveAlt");

); // end KNOBS tab

// ═══════════════════════ TAB 1 · BUTTONS ═══════════════════════
slider1 == 1 ? (

// BUTTONS — all 10 styles (label)
gfx_setfont(1,"Arial",max(9,floor(11*sc)),'b'); gfx_set(0.72,0.74,0.80); gfx_x=sc*14; gfx_y=sc*56; gfx_drawstr("BUTTONS — all 10 styles");

// Bypass (button)
bm = btnmem + 0*8;
_bs = btn_pill_interact(bm, sc*20, sc*130, sc*84, sc*28, slider23);
_bs != slider23 ? ( slider23 = _bs; slider_automate(slider23); );
btn_pill_draw(sc*20, sc*130, sc*84, sc*28, slider23, "Bypass", bm[0], 0.85,0.20,0.11);

// EQ (button)
bm = btnmem + 1*8;
_bs = btn_rect_interact(bm, sc*130, sc*131, sc*66, sc*26, slider24);
_bs != slider24 ? ( slider24 = _bs; slider_automate(slider24); );
btn_rect_draw(sc*130, sc*131, sc*66, sc*26, slider24, "EQ", bm[0], 0.29,0.87,0.50);

// Mode (button)
bm = btnmem + 4*8;
_bs = btn_rocker2_interact(bm, sc*226, sc*129, sc*80, sc*30, slider27);
_bs != slider27 ? ( slider27 = _bs; slider_automate(slider27); );
btn_rocker2_draw(sc*226, sc*129, sc*80, sc*30, slider27, "IN", "OUT", bm[0]);

// Type (button)
