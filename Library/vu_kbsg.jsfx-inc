// Theme 11-12: User Theme slots (populated by external imports)

// ── IMPORTANT: Memory reservation ────────────────────────────
// This library uses hardcoded memory addresses 0-437:
//   print[0..10] at addresses 10-20 (scale dB labels)
//   pos[0..10]   at addresses 30-40 (scale arc positions)
//   Theme arrays  at addresses 100-437 (25 arrays × 13 themes)
// Host plugins MUST set freemem >= 440 to avoid corruption.
// ─────────────────────────────────────────────────────────────

// ── Color helpers (exact from ZenoMOD Index.jsfx-inc) ─────────
function packed_RGB(hex) (
  r = (hex & $xff0000) >> 16;
  g = (hex & $x00ff00) >> 8;
  b = (hex & $x0000ff);
  r + g * 256 + b * 65536;
);

function set_color(trgb) (
  gfx_set(
    (trgb&$xff0000)/$xff0000,
    (trgb&$xff00)/$xff00,
    (trgb&$xff)/$xff
  );
);


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃  SECTION 2: TUKAN PHYSICS                                    ┃
// ┃  Exact port from: tk-vu_lib_d.jsfx-inc (demian d mod)        ┃
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

function mn_meter_reinit(speed_) (
  this.cosp = 0; this.dbL = -130; this.force = 0;
  this.mnblitscale = 0; this.mnmeterpng = -1;
  this.nd_posL = 0; this.nd_SpeedL = 0;
  this.ph = 0; this.r1 = 0; this.scnt = 0;
  this.sinP = 0; this.smpLL = 0;
  this.w1 = this.w2 = this.x1 = this.x2 = this.xa = this.xd = this.xw = this.y1 = this.y2 = this.ya = this.yd = this.yw = 0;
  mn_meter_speed = speed_;
  mn_Meter_fact_up = 10 ^ (( 0 - 10)/20) * 0.3785;
  mn_Meter_mom = 0.00010 + 0.00032 * mn_Meter_speed^3 / 125000;
  mn_Meter_dt = 10 / srate;
  mn_Meter_offset = 0.0074;
  mn_meter_damp = 1 - 0.005 * (48000 / srate);
  GR_mn_meter_speed = 40;
  GR_mn_Meter_fact_up = 10 ^ (( 0 - 10)/20) * 0.3785;
  GR_mn_Meter_mom = 0.00010 + 0.00032 * GR_mn_Meter_speed^3 / 125000;
  GR_mn_Meter_dt = 10 / srate;
  GR_mn_Meter_offset = 0.0074;
  GR_mn_meter_damp = 1 - 0.005 * (48000 / srate);
);

function mn_meter_reinit2(speed_ maxdb_tunning) (
  this.cosp = 0; this.dbL = -130; this.force = 0;
  this.mnblitscale = 0; this.mnmeterpng = -1;
  this.nd_posL = 0; this.nd_SpeedL = 0;
  this.ph = 0; this.r1 = 0; this.scnt = 0;
  this.sinP = 0; this.smpLL = 0;
  this.w1 = this.w2 = this.x1 = this.x2 = this.xa = this.xd = this.xw = this.y1 = this.y2 = this.ya = this.yd = this.yw = 0;
  mn_meter_speed = speed_;
  mn_Meter_fact_up = 10 ^ (( 0 - 10)/20) * 0.3790;
  mn_Meter_mom = 0.00010 + 0.00032 * mn_Meter_speed^3 / 125000;
  mn_Meter_dt = 10 / srate;
  mn_Meter_offset = 0.0074;
  mn_meter_damp = 1 - 0.005 * (48000 / srate);
  GR_mn_meter_speed = 40;
  gr_mn_meter_fact_up_multiplier=0.3790;
  GR_mn_Meter_fact_up = 10 ^ (( 0 - 10)/20) * 0.3790;
  GR_mn_Meter_mom = 0.00010 + 0.00032 * GR_mn_Meter_speed^3 / 125000;
  GR_mn_Meter_dt = 10 / srate;
  gr_mn_meter_offset_multiplier=GR_mn_Meter_fact_up/(GR_mn_Meter_fact_up/0.0215*maxdb_tunning);
  GR_mn_Meter_offset = gr_mn_meter_offset_multiplier;
  GR_mn_meter_damp = 1 - 0.005 * (48000 / srate);
);

function mnMetersample(meterIn) (
  this.smpL = abs(MeterIn);
  this.scnt += 1;
  this.scnt === 10 ? (
    this.force = this.smpL * mn_Meter_fact_up - (this.nd_posL * .1 + mn_Meter_offset);
    this.nd_SpeedL += this.force * mn_Meter_dt / mn_Meter_mom;
    this.nd_SpeedL = this.nd_SpeedL * mn_meter_damp;
    this.nd_posL += this.nd_SpeedL * mn_Meter_dt;
    this.nd_posL < 0 || this.nd_posL > 1 ? this.nd_SpeedL = 0;
    this.nd_posL = min(max(this.nd_posL,0),1);
    this.scnt = 0;
  );
);

function GR_mnMetersample(meterIn) (
  this.smpL = abs(MeterIn);
  this.scnt += 1;
  this.scnt === 10 ? (
    this.force = this.smpL * GR_mn_Meter_fact_up - (this.nd_posL * .1 + GR_mn_Meter_offset);
    this.nd_SpeedL += this.force * GR_mn_Meter_dt / GR_mn_Meter_mom;
    this.nd_SpeedL = this.nd_SpeedL * GR_mn_Meter_damp;
    this.nd_posL += this.nd_SpeedL * GR_mn_Meter_dt;
    this.nd_posL < 0 || this.nd_posL > 1 ? this.nd_SpeedL = 0;
    this.nd_posL = min(max(this.nd_posL,0),1);
    this.scnt = 0;
  );
);

function mn_meter_init () (
  this.cosp = 0; this.dbL = -130; this.force = 0;
  this.mnblitscale = 0; this.mnmeterpng = -1;
  this.nd_posL = 0; this.nd_SpeedL = 0;
  this.ph = 0; this.r1 = 0; this.scnt = 0;
  this.sinP = 0; this.smpLL = 0;
  this.w1 = this.w2 = this.x1 = this.x2 = this.xa = this.xd = this.xw = this.y1 = this.y2 = this.ya = this.yd = this.yw = 0;
);


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃  SECTION 3: ZENOMOD PHYSICS                                  ┃
// ┃  Exact port from: VU Meter (ZenoMOD) v1.7.7                  ┃
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

// Polynomial Regression — maps spring-mass dB to display dB
function vu(x)(
  (x > -10.739772 && x < 3.1) ? (
    0.0000000018574144851277023*pow(x,7) -0.000000007181675534274909*pow(x,6)
    +0.00000026010069461917307*pow(x,5) -0.000010602895408755132*pow(x,4)
    +0.0002816973632214551*pow(x,3) -0.009181854972743169*pow(x,2)
    +0.39887854736070294*x +1.9117333817772166
  ) : (
  x > -15.549665 && x <= -10.739772) ? (
    0.000045203665592780654*pow(x,5) +0.0025379041863024046*pow(x,4)
    +0.05990413162348811*pow(x,3) +0.6988138346039348*pow(x,2)
    +4.640331857325891*x +12.134166801893349
  ) : (
  x > -17.826267 && x <= -15.549665) ? (
    -0.0038388028713626453*pow(x,4) -0.23246545149124698*pow(x,3)
    -5.395512159008137*pow(x,2) -55.499232285589244*x -216.99316401521162
  ) : (
  x > -20 && x <= -17.826237) ? (
    0.0000028446420086192774*pow(x,7) +0.000047054132856009275*pow(x,6)
    -0.007734424207833404*pow(x,5) -0.3519383256717419*pow(x,4)
    -5.193316606317936*pow(x,3) -8.882367411579192*pow(x,2)
    +436.30657196835705*x +2902.0746462408774
  ) : -20;
);

function round_dec (x, places) local (mult, div) (
  mult = 10 ^ places; div = 1/mult;
  x = div * sign (x) * floor(abs (mult * x) + 0.5);
);

// Peak sample/hold struct offsets (exact from ZenoMOD @init)
peak_timeout = 0;
value = 0;
peak = 1;
left = 0;
right = 4;
clip = 3;

function _sample(ch, _spl, decay) local(s) (
  s = abs(_spl);
  ch[value] = max(ch[value], s);
  ch[peak_timeout] -= 1;
  ch[peak_timeout] <= 0 || s > ch[peak] ? (
    ch[peak] = s; ch[peak_timeout] = decay;
  );
  ch[clip] = max(ch[clip], s);
);

function dbfs(x) ( 20*log10(x); );


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃  SECTION 4: LITEON BALLISTICS                                ┃
// ┃  Exact port from: vumetergfx by Liteon (C) 2008-2009 GPL     ┃
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

// VU dB → native X coordinate (piecewise linear)
function lit_vu_db_to_x(vu_db) local(d) (
  vu_db <= -20 ? 66
  : vu_db <= -10 ? ( d = (vu_db + 20) / 10; 66  + d * 41;  )
  : vu_db <= -7  ? ( d = (vu_db + 10) / 3;  107 + d * 31;  )
  : vu_db <= -5  ? ( d = (vu_db + 7)  / 2;  138 + d * 20;  )
  : vu_db <= -3  ? ( d = (vu_db + 5)  / 2;  158 + d * 25;  )
  : vu_db <= 0   ? ( d = (vu_db + 3)  / 3;  183 + d * 93;  )
  : vu_db <= 3   ? ( d = vu_db / 3;         276 + d * 81;  )
  : 375;
);

// Arc Y from X (radius=200, pivot at 212,236)
function lit_arc_y(nx) local(r, ll, hh) (
  r = 200;
  ll = sqrt(r * r + (212 - nx) * (212 - nx));
  hh = (ll - r) * r / ll;
  35 + hh;
);


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃  SECTION 5: TUKAN DRAWING                                    ┃
// ┃  Exact port from: tk-vu_lib_d.jsfx-inc (demian d mod)        ┃
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

function mnmetergfx(mnmeterscale, mnmeterx, mnmetery, mnmeterpng) local (linestep d_btn_w d_btn_h d_imgscale) (
  gfx_getimgdim(mnmeterpng, d_btn_w, d_btn_h);
  d_btn_w == 382 ? (d_imgscale=1):(d_imgscale=382/d_btn_w);
  this.nd_posL_g = this.nd_posL;
  this.dbL = (this.nd_posL_g * 23) - 20;
  this.mnmeterpng = mnmeterpng;
  gfx_a = 1; gfx_x = mnmeterx; gfx_y=mnmetery;
  mnmeterscale == 0 ? (this.mnblitscale = gfx_w/190):(this.mnblitscale = mnmeterscale);
  gfx_a = 1;
  this.mnmeterpng >= 0 ? gfx_blit(this.mnmeterpng,this.mnblitscale / 2*d_imgscale,0);
  gfx_a = 1;
  this.w1 = $pi * 16.5 / 180;
  this.w2 = $pi * 45 / 180;
  this.xw = 190*this.mnblitscale;
  this.yw = 92*this.mnblitscale;
  this.r1 = 130*this.mnblitscale;
  this.xd = 10; this.yd = 10;
  this.xa = this.mnblitscale*190/2;
  this.ya = floor(this.yd + this.yw * 1.1);
  this.ph = this.dbL;
  this.ph = 51.5 + (this.ph+20.1)/23*83;
  this.r1 = this.mnblitscale*(80+abs((90 - abs(this.ph)))/5);
  this.ph = this.ph * ($pi / 180);
  this.cosp = cos(this.ph);
  this.sinP = sin(this.ph);
  this.ya = mnmetery+110*this.mnblitscale;
  this.xa = mnmeterx+(190*this.mnblitscale/2);
  this.x1 = this.xa - this.cosp * this.r1 * 0.25;
  this.y1 = this.ya - this.sinP * this.r1 * 0.25;
  this.x2 = this.xa - this.cosp * this.r1 * 1.1;
  this.y2 = this.ya - this.sinP * this.r1 * 1.1;
  gfx_x = this.x1; gfx_y = this.y1;
  gfx_lineto(this.x2, this.y2);
  this.mnblitscale > 1 ? (
    linestep = 0;
    loop(this.mnblitscale * 2,
      linestep += 0.25;
      gfx_line(this.x1+linestep,this.y1,this.x2+linestep,this.y2);
    );
  );
  gfx_a = 0.3;
  gfx_x = this.x1-2; gfx_y = this.y1;
  gfx_lineto(this.x2- 2, this.y2);
  gfx_a = 1;
);

// db2ratio: convert dB to linear ratio (may be defined in host plugins)
function db2ratio(db) ( 10 ^ (db / 20); );

function mnmetergfx2(mnmeterpng, mnmeterscale, mnmeterx, mnmetery, x_center_offset, y_center_offset, needle_line_start, needle_line_end, leftmostDegree, rightmostDegree, wall_offset, dn_bias) local (linestep d_btn_w d_btn_h d_imgscale) (
  gfx_getimgdim(mnmeterpng, d_btn_w, d_btn_h);
  d_btn_w == 382 ? (d_imgscale=1):(d_imgscale=382/d_btn_w);
  this.nd_posL_g = this.nd_posL;
  dn_pos=this.nd_posL_g*db2ratio(wall_offset);
  dn_pos=dn_pos^dn_bias;
  this.dbL = ((dn_pos) * 23) - 20;
  this.mnmeterpng = mnmeterpng;
  gfx_a = 1; gfx_x = mnmeterx; gfx_y=mnmetery;
  mnmeterscale == 0 ? (this.mnblitscale = gfx_w/190):(this.mnblitscale = mnmeterscale);
  gfx_a = 1;
  this.mnmeterpng >= 0 ? gfx_blit(this.mnmeterpng,this.mnblitscale / 2*d_imgscale,0);
  gfx_a = 1;
  this.w1 = $pi * 16.5 / 180;
  this.w2 = $pi * 45 / 180;
  this.xw = 190*this.mnblitscale;
  this.yw = 92*this.mnblitscale;
  this.r1 = 130*this.mnblitscale;
  this.xd = 10; this.yd = 10;
  this.xa = this.mnblitscale*190/2;
  this.ya = floor(this.yd + this.yw * 1.1);
  this.ph = this.dbL;
  this.ph = leftmostDegree + (this.ph + 20.1) / 23 * (rightmostDegree - leftmostDegree);
  this.r1 = this.mnblitscale*(80+abs((90 - abs(this.ph)))/5);
  this.ph = this.ph * ($pi / 180);
  this.cosp = cos(this.ph);
  this.sinP = sin(this.ph);
  this.ya = mnmetery+(110*y_center_offset)*this.mnblitscale;
  this.xa = mnmeterx+((190*x_center_offset)*this.mnblitscale/2);
  this.x1 = this.xa - this.cosp * this.r1 * needle_line_start;
  this.y1 = this.ya - this.sinP * this.r1 * needle_line_start;
  this.x2 = this.xa - this.cosp * this.r1 * needle_line_end;
  this.y2 = this.ya - this.sinP * this.r1 * needle_line_end;
  gfx_x = this.x1; gfx_y = this.y1;
  gfx_lineto(this.x2, this.y2);
  this.mnblitscale > 1 ? (
    linestep = 0;
    loop(this.mnblitscale * 2,
      linestep += 0.25;
      gfx_line(this.x1+linestep,this.y1,this.x2+linestep,this.y2);
    );
  );
  gfx_a = 0.3;
  gfx_x = this.x1-2; gfx_y = this.y1;
  gfx_lineto(this.x2- 2, this.y2);
  gfx_a = 1;
);

function draw_meter(d_gr_meter_x d_gr_meter_y d_gr_meter_zoom d_png) (
  gfx_r = 0; gfx_b = 0; gfx_g = 0;
  this.mnmetergfx(d_gr_meter_zoom*zoom, d_gr_meter_x*zoom, d_gr_meter_y*zoom, d_png);
);

function draw_meter2(d_png d_gr_meter_x d_gr_meter_y d_gr_meter_zoom x_center_offset y_center_offset needle_line_start needle_line_end leftmostDegree rightmostDegree wall_offset dn_bias) (
  gfx_r = 0; gfx_b = 0; gfx_g = 0;
  this.mnmetergfx2(d_png, d_gr_meter_zoom*zoom, d_gr_meter_x*zoom, d_gr_meter_y*zoom, x_center_offset, y_center_offset, needle_line_start, needle_line_end, leftmostDegree, rightmostDegree, wall_offset, dn_bias);
);

function dem_gr_meter_vertical(gr_meter x_pos meter_width) (
  gfx_r = 0.7; gfx_g = 0.7; gfx_b = 0; gfx_a = 0.8;
  gr_meter *= exp(1/30);
  gr_meter = min(gr_meter, 1);
  meter_bot = 20;
  meter_w = min(gfx_w, meter_width * zoom);
  yscale = gfx_h * 20 / meter_bot;
  gfx_x = x_pos*zoom;
  gfx_y = gfx_h + log10(gr_meter) * yscale;
  gfx_rectto(meter_w+gfx_x, gfx_h);
);

function barmeter_hor(grvalue grm_y grm_h grm_x grm_w grcolor) (
  gfx_r=1; gfx_g=gfx_b=0; gfx_a=0.8;
  grvalue *= exp(1/30); grvalue>1?grvalue=1;
  grm_y=grm_y*zoom; grm_h=grm_h*zoom; grm_x=grm_x*zoom; grm_w=grm_w*zoom;
  meter_bot=20; meter_h=grm_y+grm_h;
  xscale=grm_w*20/meter_bot;
  gfx_y=grm_y; gfx_x=grm_x;
  gfx_rectto(max(grm_x-grm_w, grm_x + log10(grvalue)*xscale),meter_h);
  gfx_r=gfx_g=gfx_b=1.0; gfx_a=0.6;
  grcolor==1?gfx_r=gfx_g=gfx_b=0;
  gfx_y=grm_y; gfx_x=grm_x;
  gfx_lineto(gfx_x,meter_h,0);
  s2=sqrt(2)/2; g = s2;
  while(
    gfx_x=grm_x + log10(g)*xscale;
    gfx_x >= grm_x-grm_w ? (
      gfx_y=grm_y; gfx_lineto(gfx_x,meter_h,0);
      gfx_y=meter_h; gfx_x+=2;
    );
    g*=s2; gfx_x >=grm_x-grm_w;
  );
  gfx_y=grm_y; gfx_x=grm_x-grm_w;
  gfx_lineto(gfx_x,meter_h,0); gfx_y=meter_h; gfx_a=1;
);


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃  SECTION 6: LITEON DRAWING                                   ┃
// ┃  Exact port from: vumetergfx / vumetergfxsum by Liteon        ┃
// ┃  (C) 2008-2009 Lubomir I. Ivanov — GPL                       ┃
// ┃  Wrapped into parametric functions for EON Studios ReaKit       ┃
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

// Draw one Liteon VU panel (scale, needle, info bar)
//   ox, oy — screen origin (top-left of this panel)
//   sc     — scale factor (native 425px → screen)
//   vu_db  — needle position in VU dB (-20 to +3)
//   rms_db — RMS value for numeric display
//   pk_db  — peak dB for numeric display
//   ch_label — 0=LEFT, 1=RIGHT, 2=L+R, 3=MID, 4=SIDE
function lit_draw_panel(ox, oy, sc, vu_db, rms_db, pk_db, ch_label)
local(sx, sy, ex, ey, xl, yl, fsz, is_red,
      nx1, ny1, nx2, ny2, n_px, n_py, n_base, n_tip,
      tw, th, piv_x, piv_y)
(
  // red scale numbers
  gfx_r = gfx_a = 1; gfx_g = gfx_b = 0;
  fsz = max(8, floor(sc * 10 + 0.5));
  gfx_setfont(1, "Arial", fsz);
  gfx_x = ox + 283 * sc; gfx_y = oy + 28 * sc; gfx_drawstr("0");
  gfx_x = ox + 370 * sc; gfx_y = oy + 55 * sc; gfx_drawstr("3");
  gfx_x = ox + 405 * sc; gfx_y = oy + 57 * sc; gfx_drawstr("+");
  // red tick lines
  gfx_line(ox + 283 * sc, oy + 38 * sc, ox + 269 * sc, oy + 76 * sc, 1);
  gfx_line(ox + 311 * sc, oy + 43 * sc, ox + 293 * sc, oy + 80 * sc, 1);
  gfx_line(ox + 342 * sc, oy + 51 * sc, ox + 318 * sc, oy + 85 * sc, 1);
  gfx_line(ox + 370 * sc, oy + 65 * sc, ox + 344 * sc, oy + 93 * sc, 1);

  // white scale numbers
  gfx_set(1, 1, 1, 1);
  gfx_x = ox + 12 * sc; gfx_y = oy + 60 * sc; gfx_drawstr("-");
  gfx_x = ox + 41 * sc; gfx_y = oy + 53 * sc; gfx_drawstr("20");
  gfx_x = ox + 80 * sc; gfx_y = oy + 37 * sc; gfx_drawstr("10");
  gfx_x = ox + 125 * sc; gfx_y = oy + 29 * sc; gfx_drawstr("7");
  gfx_x = ox + 157 * sc; gfx_y = oy + 25 * sc; gfx_drawstr("5");
  gfx_x = ox + 198 * sc; gfx_y = oy + 24 * sc; gfx_drawstr("3");
  // white tick lines
  gfx_line(ox + 56 * sc, oy + 63 * sc, ox + 82 * sc, oy + 92 * sc, 1);
  gfx_line(ox + 95 * sc, oy + 47 * sc, ox + 119 * sc, oy + 82 * sc, 1);
  gfx_line(ox + 130 * sc, oy + 39 * sc, ox + 146 * sc, oy + 77 * sc, 1);
  gfx_line(ox + 145 * sc, oy + 37 * sc, ox + 158 * sc, oy + 75 * sc, 1);
  gfx_line(ox + 162 * sc, oy + 35 * sc, ox + 171 * sc, oy + 74 * sc, 1);
  gfx_line(ox + 180 * sc, oy + 34 * sc, ox + 187 * sc, oy + 74 * sc, 1);
  gfx_line(ox + 202 * sc, oy + 34 * sc, ox + 204 * sc, oy + 72 * sc, 1);
  gfx_line(ox + 227 * sc, oy + 34 * sc, ox + 223 * sc, oy + 73 * sc, 1);
  gfx_line(ox + 253 * sc, oy + 35 * sc, ox + 245 * sc, oy + 73 * sc, 1);

  // VU box
  gfx_set(0.75, 0.75, 0.75, 1);
  gfx_rect(ox + 198 * sc, oy + 108 * sc, 43 * sc, 31 * sc);
  gfx_set(0.5, 0.1, 0.1, 1);
  gfx_rect(ox + 200 * sc, oy + 110 * sc, 39 * sc, 27 * sc);
  gfx_set(0.85, 0.85, 0.85, 1);
  gfx_setfont(1, "Arial", max(8, floor(sc * 11 + 0.5)), 'b');
  gfx_measurestr("VU", tw, th);
  gfx_x = ox + 219 * sc - tw / 2; gfx_y = oy + 123 * sc - th / 2;
  gfx_drawstr("VU");

  // needle (filled trapezoid)
  vu_db = min(max(vu_db, -20), 3);
  xl = lit_vu_db_to_x(vu_db);
  yl = lit_arc_y(xl);
  is_red = vu_db >= 0;
  piv_x = ox + 212 * sc;
  piv_y = oy + 236 * sc;
  nx2 = ox + xl * sc;
  ny2 = oy + yl * sc;
  n_px = -(ny2 - piv_y);
  n_py =  (nx2 - piv_x);
  n_base = sqrt(n_px * n_px + n_py * n_py);
  n_base > 0 ? ( n_px /= n_base; n_py /= n_base; );
  n_base = max(1.5, sc * 2.5);
  n_tip  = max(0.8, sc * 1.0);
  // shadow
  gfx_set(0, 0, 0, 0.15);
  gfx_triangle(
    piv_x - n_px * n_base + 2, piv_y - n_py * n_base + 2,
    piv_x + n_px * n_base + 2, piv_y + n_py * n_base + 2,
    nx2   + n_px * n_tip  + 2, ny2   + n_py * n_tip  + 2,
    nx2   - n_px * n_tip  + 2, ny2   - n_py * n_tip  + 2);
  // needle body
  is_red ? gfx_set(1, 0, 0, 1) : gfx_set(1, 1, 1, 1);
  gfx_triangle(
    piv_x - n_px * n_base, piv_y - n_py * n_base,
    piv_x + n_px * n_base, piv_y + n_py * n_base,
    nx2   + n_px * n_tip,  ny2   + n_py * n_tip,
    nx2   - n_px * n_tip,  ny2   - n_py * n_tip);

  // info bar (blue band)
  gfx_set(0.55, 0.55, 0.55, 1);
  gfx_rect(ox, oy + 179 * sc, 425 * sc, 1 * sc);
  gfx_set(0.1, 0.2, 0.39, 1);
  gfx_rect(ox, oy + 180 * sc, 425 * sc, 81 * sc);
  gfx_set(1, 1, 1, 0.1);
  gfx_rect(ox, oy + 180 * sc, 425 * sc, 10 * sc);
  gfx_set(0, 0, 0, 0.3);
  gfx_rect(ox, oy + 245 * sc, 425 * sc, 16 * sc);

  // text boxes
  gfx_set(0, 0, 0, 1);
  gfx_rect(ox + 250 * sc, oy + 210 * sc, 65 * sc, 17 * sc);
  gfx_rect(ox + 350 * sc, oy + 210 * sc, 65 * sc, 17 * sc);

  // channel label + readouts
  fsz = max(7, floor(sc * 9 + 0.5));
  gfx_setfont(1, "Arial", fsz);
  gfx_set(1, 1, 1, 1);
  gfx_x = ox + 20 * sc; gfx_y = oy + 215 * sc;
  ch_label == 0 ? gfx_drawstr("LEFT")
  : ch_label == 1 ? gfx_drawstr("RIGHT")
  : ch_label == 3 ? gfx_drawstr("MID")
  : ch_label == 4 ? gfx_drawstr("SIDE")
  : gfx_drawstr("L+R");

  gfx_x = ox + 215 * sc; gfx_y = oy + 215 * sc; gfx_drawstr("RMS");
  gfx_x = ox + 333 * sc; gfx_y = oy + 215 * sc; gfx_drawstr("P");

  // RMS value
  gfx_x = ox + 255 * sc; gfx_y = oy + 215 * sc;
  rms_db > -100 ? (
    rms_db > 0 ? ( gfx_set(1, 0, 0, 1); gfx_drawstr("+"); );
    sprintf(#lit_rms, "%.1f", rms_db); gfx_drawstr(#lit_rms);
  ) : ( gfx_drawstr("-INF"); );

  // Peak value
  gfx_set(1, 1, 1, 1);
  gfx_x = ox + 355 * sc; gfx_y = oy + 215 * sc;
  pk_db > -100 ? (
    pk_db >= 0 ? ( gfx_set(1, 0, 0, 1); gfx_drawstr("+"); );
    sprintf(#lit_pk, "%.1f", pk_db); gfx_drawstr(#lit_pk);
  ) : ( gfx_drawstr("-INF"); );
);

// Stereo Liteon VU (L/R stacked)
function mtr_vu_liteon_stereo(x, y, w, h, vu_l, vu_r, rms_l, rms_r, pk_l, pk_r)
local(sc, panel_h, ox, oy1, oy2) (
  sc = min(w / 425, h / 522);
  ox = x + (w - 425 * sc) / 2;
  panel_h = 261 * sc;
  oy1 = y + (h - 522 * sc) / 2;
  oy2 = oy1 + panel_h;
  lit_draw_panel(ox, oy1, sc, vu_l, rms_l, pk_l, 0);
  lit_draw_panel(ox, oy2, sc, vu_r, rms_r, pk_r, 1);
);

// Summed Liteon VU (mono single panel)
function mtr_vu_liteon_summed(x, y, w, h, vu_mono, rms_mono, pk_mono)
local(sc, ox, oy) (
  sc = min(w / 425, h / 261);
  ox = x + (w - 425 * sc) / 2;
  oy = y + (h - 261 * sc) / 2;
  lit_draw_panel(ox, oy, sc, vu_mono, rms_mono, pk_mono, 2);
);

// Mid/Side Liteon VU (two stacked panels)
function mtr_vu_liteon_ms(x, y, w, h, vu_m, vu_s, rms_m, rms_s, pk_m, pk_s)
local(sc, panel_h, ox, oy1, oy2) (
  sc = min(w / 425, h / 522);
  ox = x + (w - 425 * sc) / 2;
  panel_h = 261 * sc;
  oy1 = y + (h - 522 * sc) / 2;
  oy2 = oy1 + panel_h;
  lit_draw_panel(ox, oy1, sc, vu_m, rms_m, pk_m, 3);
  lit_draw_panel(ox, oy2, sc, vu_s, rms_s, pk_s, 4);
);


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃  SECTION 7: EON STUDIOS PHYSICS (cleaned instance-based)       ┃
// ┃  Adapted from Tukan spring-mass — all state in this.          ┃
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

// VU signal meter init (speed ~40-70, 61 = classic VU)
function vu_init(speed_) (
  this.nd_pos = 0; this.nd_speed = 0; this.force = 0;
  this.smpL = 0; this.scnt = 0; this.db_display = -40;
  this.over = 0; this.over_g = 0;
  this.vu_lim = 1.0;       // peak LED threshold (linear, 0 dBu)
  this.led_hold = 100;     // LED hold time (frames)
  this.vu_speed = speed_;
  this.vu_fact_up = 10 ^ ((0 - 10) / 20) * 0.3785;
  this.vu_mom = 0.00010 + 0.00032 * this.vu_speed ^ 3 / 125000;
  this.vu_dt = 10 / srate;
  this.vu_offset = 0.0074;
  this.vu_damp = min(max(1 - 0.005 * (48000 / srate), 0), 0.999999);
);

// GR meter init (different offset for gain reduction)
function vu_init_gr(speed_) (
  this.nd_pos = 0; this.nd_speed = 0; this.force = 0;
  this.smpL = 0; this.scnt = 0; this.db_display = 0;
  this.over = 0; this.over_g = 0;
  this.vu_lim = 0.5;       // peak LED threshold: triggers at ~6 dB GR
  this.led_hold = 100;     // LED hold time (frames)
  this.vu_speed = speed_;
  this.vu_fact_up = 10 ^ ((0 - 10) / 20) * 0.3790;
  this.vu_mom = 0.00010 + 0.00032 * this.vu_speed ^ 3 / 125000;
  this.vu_dt = 10 / srate;
  this.vu_offset = 0.0215;
  this.vu_damp = min(max(1 - 0.005 * (48000 / srate), 0), 0.999999);
);

// Process signal sample (feed absolute value every @sample)
function vu_sample(abs_in) (
  this.smpL = max(this.smpL, abs_in);
  this.scnt += 1;
  this.scnt >= 10 ? (
    this.force = this.smpL * this.vu_fact_up - (this.nd_pos * 0.1 + this.vu_offset);
    this.nd_speed += this.force * this.vu_dt / this.vu_mom;
    this.nd_speed = this.nd_speed * this.vu_damp;
    this.nd_pos += this.nd_speed * this.vu_dt;
    this.nd_pos < 0 || this.nd_pos > 1 ? this.nd_speed = 0;
    this.nd_pos = min(max(this.nd_pos, 0), 1);
    abs(this.nd_speed) < 0.0000001 ? this.nd_speed = 0;
    // LED countdown (exact from ZenoMOD: overL -= 100/led_hold every 10 samples)
    this.over -= 100 / this.led_hold;
    this.smpL = 0;
    this.scnt = 0;
  );
  // Peak detect (every sample, exact from ZenoMOD: smpL > lim ? overL = srate)
  abs_in > this.vu_lim ? this.over = srate;
  // GUI handoff (exact from ZenoMOD: overL_g = overL)
  this.over_g = this.over;
);

// GR sample (feed linear gain value, 1.0 = no reduction)
function vu_gr_sample(gr_linear) (
  gr_linear = min(max(gr_linear, 0), 2);
  this.smpL = max(this.smpL, max(1.0 - gr_linear, 0));
  this.scnt += 1;
  this.scnt >= 10 ? (
    this.force = this.smpL * this.vu_fact_up - (this.nd_pos * 0.1 + this.vu_offset);
    this.nd_speed += this.force * this.vu_dt / this.vu_mom;
    this.nd_speed = this.nd_speed * this.vu_damp;
    this.nd_pos += this.nd_speed * this.vu_dt;
    this.nd_pos < 0 || this.nd_pos > 1 ? this.nd_speed = 0;
    this.nd_pos = min(max(this.nd_pos, 0), 1);
    abs(this.nd_speed) < 0.0000001 ? this.nd_speed = 0;
    // LED countdown
    this.over -= 100 / this.led_hold;
    this.smpL = 0;
    this.scnt = 0;
  );
  // Peak detect: GR exceeds threshold → LED on
  (1.0 - gr_linear) > this.vu_lim ? this.over = srate;
  this.over_g = this.over;
);


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃  SECTION 8a: EON STUDIOS CUSTOM FACE — Tukan-style arc VU     ┃
// ┃  Custom vector face using Tukan geometry                      ┃
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

// Draw a custom arc-style VU face (Tukan geometry)
//   cx,cy = arc pivot center, radius = arc radius
//   mode: 0 = VU signal (-20..+3), 1 = GR (0..-20), 2 = custom
function vu_draw(cx, cy, radius, mode)
  local(db, ph, cosp, sinp, r_adj,
        x1, y1, x2, y2, tip_r,
        arc_start, arc_end, red_start,
        i, frac, tick_ph, tick_cos, tick_sin,
        tx1, ty1, tx2, ty2, lx, ly, tw, th,
        fsz, ret)
(
  ret = max(1, gfx_ext_retina);

  // Convert needle position to dB
  db = (this.nd_pos * 23) - 20;

  // Angle: 0.78π (left, -20dB) to 0.22π (right, +3dB)
  ph = 51.5 + (db + 20.1) / 23 * 83;

  // Variable radius for natural arc perspective
  r_adj = radius * (0.85 + abs(90 - abs(ph)) / 500);

  ph = ph * ($pi / 180);
  cosp = cos(ph);
  sinp = sin(ph);

  // ── Arc background ────────────────────────────────────
  arc_start = 0.22 * $pi;
  arc_end   = 0.78 * $pi;

  // Base arc (dark)
  gfx_set(0.15, 0.15, 0.15, 1);
  gfx_arc(cx, cy, radius, arc_start, arc_end, 1);
  gfx_arc(cx, cy, radius + 1, arc_start, arc_end, 1);

  // Red zone
  mode == 0 ? (
    red_start = arc_start + (arc_end - arc_start) * 0.12;
    gfx_set(0.82, 0.12, 0.10, 1);
    gfx_arc(cx, cy, radius + 2, arc_start, red_start, 1);
    gfx_arc(cx, cy, radius + 3, arc_start, red_start, 1);
  ) : mode == 1 ? (
    red_start = arc_start + (arc_end - arc_start) * 0.55;
    gfx_set(0.82, 0.12, 0.10, 1);
    gfx_arc(cx, cy, radius + 2, arc_end, red_start, 1);
    gfx_arc(cx, cy, radius + 3, arc_end, red_start, 1);
  );

  // ── Scale ticks ───────────────────────────────────────
  fsz = max(8, floor(radius * 0.11 * ret + 0.5));
  gfx_setfont(1, "Arial", fsz);

  mode == 0 ? (
    // VU scale ticks
    gfx_set(0.15, 0.15, 0.15, 1);
    i = 0;
    loop(11,
      frac = pos[i];
      tick_ph = (45 + frac * 90) * ($pi / 180);
      tick_cos = cos(tick_ph); tick_sin = sin(tick_ph);
      tx1 = cx - tick_cos * radius;
      ty1 = cy - tick_sin * radius;
      tx2 = cx - tick_cos * radius * 1.08;
      ty2 = cy - tick_sin * radius * 1.08;
      gfx_line(tx1, ty1, tx2, ty2, 1);

      // Label
      i >= 8 ? gfx_set(0.82, 0.12, 0.10, 1) : gfx_set(0.15, 0.15, 0.15, 1);
      lx = cx - tick_cos * radius * 1.15;
      ly = cy - tick_sin * radius * 1.15;
      sprintf(#_vu_lb, "%d", print[i]);
      gfx_measurestr(#_vu_lb, tw, th);
      gfx_x = lx - tw * 0.5; gfx_y = ly - th * 0.5;
      gfx_drawstr(#_vu_lb);
      i += 1;
    );
  ) : mode == 1 ? (
    // GR scale ticks: 0 to -20
    gfx_set(0.15, 0.15, 0.15, 1);
    i = 0;
    loop(5,
      frac = i / 4;
      tick_ph = (45 + frac * 90) * ($pi / 180);
      tick_cos = cos(tick_ph); tick_sin = sin(tick_ph);
      tx1 = cx - tick_cos * radius;
      ty1 = cy - tick_sin * radius;
      tx2 = cx - tick_cos * radius * 1.08;
      ty2 = cy - tick_sin * radius * 1.08;
      gfx_line(tx1, ty1, tx2, ty2, 1);
      i >= 3 ? gfx_set(0.82, 0.12, 0.10, 1) : gfx_set(0.15, 0.15, 0.15, 1);
      lx = cx - tick_cos * radius * 1.15;
      ly = cy - tick_sin * radius * 1.15;
      sprintf(#_vu_lb, "%d", -(i * 5));
      gfx_measurestr(#_vu_lb, tw, th);
      gfx_x = lx - tw * 0.5; gfx_y = ly - th * 0.5;
      gfx_drawstr(#_vu_lb);
      i += 1;
    );
  );

  // ── Needle ────────────────────────────────────────────
  x1 = cx - cosp * r_adj * 0.25;
  y1 = cy - sinp * r_adj * 0.25;
  x2 = cx - cosp * r_adj * 1.05;
  y2 = cy - sinp * r_adj * 1.05;

  // Shadow
  gfx_set(0, 0, 0, 0.2);
  gfx_line(x1 + 2, y1 + 1, x2 + 2, y2 + 1, 1);

  // Main needle (black)
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(x1, y1, x2, y2, 1);
  gfx_line(x1 + 1, y1, x2 + 1, y2, 1);

  // Red tip when in red zone
  mode == 0 ? ( db > 0 ? (
    tip_r = r_adj * 0.85;
    gfx_set(0.9, 0.08, 0.08, 1);
    gfx_line(cx - cosp * tip_r, cy - sinp * tip_r, x2, y2, 1);
    gfx_line(cx - cosp * tip_r + 1, cy - sinp * tip_r, x2 + 1, y2, 1);
  ));

  // Pivot dot
  gfx_set(0.1, 0.1, 0.1, 1);
  gfx_circle(cx, cy, max(3, radius * 0.06), 1, 1);

  // dB readout
  fsz = max(9, floor(radius * 0.13 * ret + 0.5));
  gfx_setfont(1, "Arial", fsz, 'b');
  gfx_set(0.9, 0.9, 0.9, 0.8);
  sprintf(#_vu_db, "%.1f dB", db);
  gfx_measurestr(#_vu_db, tw, th);
  gfx_x = cx - tw * 0.5;
  gfx_y = cy + radius * 0.15;
  gfx_drawstr(#_vu_db);
);


// ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
// ┃  SECTION 8b: ZENOMOD DRAWING SYSTEM (library-safe port)       ┃
// ┃  Draws bounded to meter bounding box. Embedded branches match  ┃
// ┃  ZenoMOD v1.7.7 exactly (13 gfx_ext_flags checks).           ┃
// ┃  Globals set by zm_draw_meter: xa,ya,r1,xd,yd,xw,yw,gsc,     ┃
// ┃    scaling,w1,w2,color,zm_face_bot                             ┃
// ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛

// Frame fill — replaces gfx_clear (which ZenoMOD uses but we can't, since we don't own the window)
function zm_draw_frame() (
  zm_frame_r >= 0 ? gfx_set(zm_frame_r, zm_frame_g, zm_frame_b, 1) : set_color(Frm_Buf[color]);
  gfx_rect(zm_box_x, zm_box_y, zm_box_w, zm_box_h);
);

function zm_draw_meter_bg() (
  set_color(MeterBG[color]);
  !zm_emb ? (
    gfx_rect(xd, yd, xw, yw);
  ) : (
    gfx_rect(xd * 0.001, yd * 0.99, xw * 1.387, yw);
  );
);


function zm_draw_3D() (
  EFX_3Di[color] ? (
    !zm_emb ? (
      // Floating: bounded 3D (rects stay within face area)
      // NOTE: ZenoMOD uses circles at ya*1.20+ which bleed past the bounding box.
      // We use rects that stay within yw bounds since we don't own the full window.
      i = 0;
      loop(3,
        set_color(Shdw_3D[color]);
        gfx_a = 0.1 + i * 0.025;
        gfx_rect(xd, yd, xw, yw * (0.16 - i * 0.01));
        i += 1;
      );
      set_color(Lght_3D[color]);
      gfx_a = 0.06;
      gfx_rect(xd + xw * 0.15, yd + yw * 0.3, xw * 0.7, yw * 0.35);
      gfx_a = 1;
    ) : (
      // Embedded: ZenoMOD exact (line 714-726)
      i = 0;
      loop(3,
        set_color(Shdw_3D[color]);
        gfx_a = 0.1 + i * 0.025;
        gfx_rect(xd * 0.001, yd * 0.99, xw * 1.385, yw / yd * (0.3 - i * 0.03) / 2);
        i += 1;
      );
      i = 0;
      loop(4,
        set_color(Lght_3D[color]);
        gfx_a = 0.1 + i * 0.025;
        gfx_circle(xa, ya * (1.15 + i * 0.05), r1 * 0.87, 1, 1);
        i += 1;
      );
      gfx_a = 1;
    );
  );
);

function zm_draw_arcs() (
  set_color(MtrArc1[color]);
  gfx_arc(xa, ya, r1, -45 * ($pi / 180), w2, 1);
  set_color(MtrArc2[color]);
  gsc >= 0.36 ? (
    i = 1;
    while (i <= 4) (
      gfx_arc(xa, ya, r1 + i, w1, w2, 1);
      i += 1;
    );
  ) : (
    i = 1;
    while (i <= 3) (
      gfx_arc(xa, ya, r1 + i, w1, w2, 1);
      i += 1;
    );
  );
);


function zm_draw_arcs_gr() (
  set_color(MtrArc1[color]);
  gfx_arc(xa, ya, r1, -45 * ($pi / 180), w2, 1);
  set_color(MtrArc2[color]);
  zm_gr_red_start = -45 * ($pi / 180) + ($pi / 2) * 0.5;
  gsc >= 0.36 ? (
    i = 1;
    while (i <= 4) (
      gfx_arc(xa, ya, r1 + i, zm_gr_red_start, w2, 1);
      i += 1;
    );
  ) : (
    i = 1;
    while (i <= 3) (
      gfx_arc(xa, ya, r1 + i, zm_gr_red_start, w2, 1);
      i += 1;
    );
  );
);


function zm_draw_scale() (
  gfx_setfont(1);
  set_color(SclDig1[color]);
  jj = 0;
  while ( jj <= 10 ) (
    ii = print[jj];
    ph = pos[jj];
    ph = (45 + ph*90) * $pi / 180;
    cosp = cos(ph) * r1;
    sinp = sin(ph) * r1;
    x1 = xa - cosp;
    y1 = ya - sinp;
    x2 = xa - cosp * 1.1;
    y2 = ya - sinp * 1.1;
    gsc > .237 ? (
      !zm_emb ? (
        x3 = xa - cosp * 1.13;
        y3 = ya - sinp * 1.11;
      ) : (
        x3 = xa - cosp * 1.18;
        y3 = ya - sinp * 1.12;
      );
    );
    gfx_x = x1;
    gfx_y = y1;
    gfx_lineto(x2, y2);

    !zm_emb ? (
      gfx_x = x3 * 0.998 - (scaling * 6);
    ) : (
      gfx_x = x3 * 0.975 - (scaling * 6);
    );
    gfx_y = y3 - gfx_texth;
    gsc > .237 ? (gfx_printf("%3d", ii));

    gsc > .237 ? (jj += 1) : (jj += 1.8);
    jj == 8 ? (set_color(SclDig2[color]));
  );
);


function zm_draw_scale_gr()
  local(jj, n_ticks, ph, cosp, sinp, x1, y1, x2, y2, x3, y3)
(
  gfx_setfont(1);
  n_ticks = 7;
  jj = 0;
  while (jj < n_ticks) (
    jj == 0 ? ( zm_gr_val = 0;   zm_gr_frac = 0.000; );
    jj == 1 ? ( zm_gr_val = -3;  zm_gr_frac = 0.150; );
    jj == 2 ? ( zm_gr_val = -5;  zm_gr_frac = 0.250; );
    jj == 3 ? ( zm_gr_val = -7;  zm_gr_frac = 0.350; );
    jj == 4 ? ( zm_gr_val = -10; zm_gr_frac = 0.500; );
    jj == 5 ? ( zm_gr_val = -15; zm_gr_frac = 0.750; );
    jj == 6 ? ( zm_gr_val = -20; zm_gr_frac = 1.000; );

    jj < 4 ? (set_color(SclDig1[color])) : (set_color(SclDig2[color]));

    ph = (45 + zm_gr_frac * 90) * $pi / 180;
    cosp = cos(ph) * r1;
    sinp = sin(ph) * r1;
    x1 = xa - cosp;
    y1 = ya - sinp;
    x2 = xa - cosp * 1.1;
    y2 = ya - sinp * 1.1;
    gfx_x = x1; gfx_y = y1;
    gfx_lineto(x2, y2);

    gsc > .237 ? (
      x3 = xa - cosp * 1.13;
      y3 = ya - sinp * 1.11;
      gfx_x = x3 * .998 - (scaling * 6);
      gfx_y = y3 - gfx_texth;
      gfx_printf("%d", zm_gr_val);
    );
    jj += 1;
  );
);


function zm_draw_vu_needle() (
  set_color(NdlLine[color]);
  gfx_line(x1, y1, x2, y2, 1);
  gsc > .5 ? (
    gfx_line(x1+1, y1, x2+1, y2, 1);
    set_color(NdlShdw[color]);
    gfx_line(x1+4, y1, x2+4, y2, 1);
  );
);


function zm_draw_hold_needle() (
  zm_hold_enabled && !zm_emb ? (
    set_color(NdlHold[color]);
    gfx_line(x1, y1, x2, y2, 1);
    gsc > .5 ? (
      gfx_line(x1+1, y1, x2+1, y2, 1);
      set_color(NdlShdw[color]);
      gfx_line(x1+4, y1, x2+4, y2, 1);
    );
  );
);


function zm_compute_draw_needle(needle, type) (
  needle = min(max(needle, -20), 3);
  ph = 45 + (needle + 20) / 23 * 90;
  ph = ph * ($pi / 180);
  cosp = cos(ph);
  sinp = sin(ph);
  x1 = xa - cosp * r1 * 0.15;
  y1 = ya - sinp * r1 * 0.15;
  x2 = xa - cosp * r1 * 1.1;
  y2 = ya - sinp * r1 * 1.1;
  type == 1 ? (zm_draw_vu_needle());
  type == 2 ? (zm_draw_hold_needle());
);


function zm_compute_draw_needle_gr(gr_db, type) (
  gr_db = min(max(gr_db, -20), 0);
  zm_remap = -20 + (-gr_db / 20) * 23;
  zm_remap = min(max(zm_remap, -20), 3);
  ph = 45 + (zm_remap + 20) / 23 * 90;
  ph = ph * ($pi / 180);
  cosp = cos(ph);
  sinp = sin(ph);
  x1 = xa - cosp * r1 * 0.15;
  y1 = ya - sinp * r1 * 0.15;
  x2 = xa - cosp * r1 * 1.1;
  y2 = ya - sinp * r1 * 1.1;
  type == 1 ? (zm_draw_vu_needle());
  type == 2 ? (zm_draw_hold_needle());
);


function zm_draw_hold_arc(hold_needle) (
  zm_hold_enabled ? (
    set_color(ArcHold[color]);
    start = -45 * ($pi / 180);
    end = start + (hold_needle + 20) / 23 * (w2 - start);
    gfx_arc(xa, ya, r1 - 3, start, end, 1);
    gfx_arc(xa, ya, r1 - 4, start, end, 1);
    gfx_arc(xa, ya, r1 - 5, start, end, 1);
    gsc >= 0.34 ? (
      gfx_arc(xa, ya, r1 - 6, start, end, 1);
    );
  );
);


function zm_draw_hold_arc_gr(gr_hold_db) (
  zm_hold_enabled ? (
    set_color(ArcHold[color]);
    gr_hold_db = min(max(gr_hold_db, -20), 0);
    zm_remap = -20 + (-gr_hold_db / 20) * 23;
    zm_remap = min(max(zm_remap, -20), 3);
    start = -45 * ($pi / 180);
    end = start + (zm_remap + 20) / 23 * (w2 - start);
    gfx_arc(xa, ya, r1 - 3, start, end, 1);
    gfx_arc(xa, ya, r1 - 4, start, end, 1);
    gfx_arc(xa, ya, r1 - 5, start, end, 1);
    gsc >= 0.34 ? (
      gfx_arc(xa, ya, r1 - 6, start, end, 1);
    );
  );
);


function zm_draw_peak_LED(over_flag) (
  led_x = xd + xw * 0.9 + (8 * scaling);
  led_y = yd + yw * 0.9 - 4;
  !zm_emb ? (
    led_scl = scaling * 4;
  ) : (
    gsc <= 0.5 ? (led_scl = scaling * 10) : (led_scl = scaling * 8);
  );
  set_color(PkLED_0[color]);
  gfx_circle(led_x, led_y, led_scl, 1, 1);
  set_color(PkLED_1[color]);
  over_flag > 0 ? (gfx_circle(led_x, led_y, led_scl, 1, 1));
);


function zm_draw_vu_str() (
  gfx_setfont(5);
  set_color(Font_Vu[color]);
  gfx_x = xa - 50 * scaling; gfx_y = yd;
  !zm_emb ? (
    gfx_drawstr(sprintf(#, "VU"), 261,
      xa + 50 * scaling, yd + yw + 52 * scaling);
  ) : (
    gfx_drawstr(sprintf(#, "VU"), 261,
      xa + 50 * scaling, yw + 70 * scaling);
  );
);


function zm_draw_gr_str() (
  gfx_setfont(5);
  set_color(Font_Vu[color]);
  gfx_x = xa - 50 * scaling; gfx_y = yd;
  !zm_emb ? (
    gfx_drawstr(sprintf(#, "GR"), 261,
      xa + 50 * scaling, yd + yw + 52 * scaling);
  ) : (
    gfx_drawstr(sprintf(#, "GR"), 261,
      xa + 50 * scaling, yw + 70 * scaling);
  );
);


// Coil cover — circle at pivot + rect below face to bounding box bottom
// Floating uses ZenoMOD exact ya*0.89/ya*0.91 multipliers.
// Embedded uses stretched width to fill panel.
function zm_draw_coil_cover() local(cover_top, cover_h, coil_r, csz, coil_y, coil_yend, coil_d2) (
  // When plugin overrides frame color, cap coil to size 2 (medium) so the
  // huge Coil_sz=3 dome doesn't bleed the override color across the VU face.
  zm_frame_r >= 0 ? (
    gfx_set(zm_frame_r, zm_frame_g, zm_frame_b, 1);
    csz = min(Coil_sz[color], 2);
  ) : (
    set_color(FG_Covr[color]);
    csz = Coil_sz[color];
  );
  // Coil circles (ZenoMOD line 670-676)
  !zm_emb ? (
    // Bounded port: ZenoMOD drew these discs against its own window bottom and
    // relied on window clipping. There is no clip here, so (a) the huge
    // Coil_sz=3 dome (theme 5) is capped to size 2 — at bounded-layout
    // coordinates (ya*1.32) it lands entirely BELOW the box and only leaks —
    // and (b) the disc is scanline-filled and stops at the bounding-box
    // bottom so no theme's coil ever escapes the meter.
    coil_r = csz >= 2 ? r1 * 0.2 : csz == 1 ? r1 * 0.16 : 0;
    coil_r > 0 ? (
      coil_y = max(floor(ya - coil_r), zm_box_y);
      coil_yend = min(ceil(ya + coil_r), zm_box_bot);
      while(coil_y < coil_yend) (
        coil_d2 = coil_r * coil_r - (coil_y - ya) * (coil_y - ya);
        coil_d2 > 0 ? gfx_rect(xa - sqrt(coil_d2), coil_y, sqrt(coil_d2) * 2, 1);
        coil_y += 1;
      );
    );
  ) : (
    // Embedded: ZenoMOD exact shifted circles
    csz == 1 ? gfx_circle(xa * 0.99, ya * 0.97, r1 * 0.16, 1, 1);
    csz == 2 ? gfx_circle(xa * 0.99, ya, r1 * 0.2, 1, 1);
    csz == 3 ? gfx_circle(xa * 0.99, ya * 1.33, r1 * 0.65, 1, 1);
  );
  // Cover rect (ZenoMOD line 678-687)
  !zm_emb ? (
    // Floating: ZenoMOD exact — ya*0.89/0.91 to bounding box bottom
    Coil_sz[color] == 0 ? (
      cover_top = floor(ya * 0.89);
    ) : (
      cover_top = floor(ya * 0.91);
    );
    cover_h = zm_box_bot - cover_top;
    cover_h > 0 ? (
      gfx_rect(xd, cover_top, xw, cover_h);
    );
  ) : (
    // Embedded: ZenoMOD exact — stretched width, fill to gfx_h
    gfx_rect(xd * 0.04, ya * 0.895, xw * 1.385, gfx_h);
  );
);


function zm_draw_channel_label(ch_label) (
  gsc > .35 && !zm_emb ? (
    gfx_setfont(5);
    set_color(Font_Ch[color]);
    gfx_x = xd + (6 * scaling);
    gfx_y = yd + yw + (2 * scaling);
    ch_label == 0 ? (gfx_drawstr("LEFT"));
    ch_label == 1 ? (gfx_drawstr("RIGHT"));
    ch_label == 2 ? (gfx_drawstr("SUMMED (L+R)"));
    ch_label == 3 ? (gfx_drawstr("MID"));
    ch_label == 4 ? (gfx_drawstr("SIDE"));
    ch_label == 5 ? (gfx_drawstr("GR"));
  );
);


// ── GR → VU scale interpolation ──────────────────────────────
// Maps GR dB (0 to -20) to a "fake VU dB" that aligns the needle
// with the correct VU scale mark via pos[] interpolation.
// This ensures: 0dB GR → needle at "0" mark, -10dB GR → "-10" mark, etc.
function zm_gr_to_vu_db(gr_db) local(j, t, frac) (
  gr_db = min(max(gr_db, -20), 0);
  gr_db >= 0 ? (
    frac = pos[7];   // "0" mark
  ) : gr_db <= -20 ? (
    frac = pos[0];   // "-20" mark
  ) : (
    // Search print[] array from index 0 (-20) to 7 (0) for bracket
    j = 0;
    while (j < 7 && print[j + 1] < gr_db) ( j += 1; );
    // j is now lower bracket, j+1 is upper
    t = (gr_db - print[j]) / (print[j + 1] - print[j]);
    frac = pos[j] + t * (pos[j + 1] - pos[j]);
  );
  // Convert pos fraction back to "fake dB" for standard needle formula
  // needle formula: angle = 45 + (db+20)/23*90
  // pos formula:    angle = 45 + frac*90
  // So: (db+20)/23 = frac → db = frac*23 - 20
  frac * 23 - 20;
);


// ── Main wrapper ─────────────────────────────────────────────
// meter_mode: 0 = VU signal, 1 = GR (needle at 0, swings left like real 1176)
// db_val: for mode 0, raw VU dB from (nd_pos*23)-20
//         for mode 1, GR dB from 0 (no GR) to -20 (heavy GR)
function zm_draw_meter(x, y, w, h, db_val, hold_db, over_flag, theme_idx, meter_mode)
  local(fsz, FONT_SZ_MIN, FONT_SZ_MAX, vu_db, gr_vu_db, hold_vu_db)
(
  color = min(max(theme_idx, 0), 12);

  // Effective embedded flag — zm_force_floating lets plugins opt out
  zm_emb = (gfx_ext_flags & 1) && !zm_force_floating;

  // Store bounding box for frame and coil cover
  zm_box_x = x; zm_box_y = y; zm_box_w = w; zm_box_h = h;
  zm_box_bot = y + h;

  // gsc controls detail level — ZenoMOD always uses full panel height (gfx_h)
  // In embedded mode, use gfx_h so detail matches ZenoMOD even when VU
  // shares the panel with other controls.
  !zm_emb ? (
    gsc = min(w / 500, h / 245);
  ) : (
    gsc = min(w / 500, gfx_h / 245);
  );
  scaling = w / 500;

  FONT_SZ_MIN = 2;
  FONT_SZ_MAX = 72;
  fsz = FONT_SZ_MIN + min(w / 100, FONT_SZ_MAX - FONT_SZ_MIN);
  gfx_setfont(1, "Arial", fsz * 2.1, '');
  gfx_setfont(2, "Arial", fsz * 2.2, '');
  gfx_setfont(5, "Arial", fsz * 3.0, 'b');

  w1 = $pi * 16.5 / 180;
  w2 = $pi * 45 / 180;

  // Layout — single meter fills its bounding box
  xw = max(1, floor(w * 0.75));
  yw = floor(xw * 0.67);
  !zm_emb ? (
    r1 = floor(yw * 0.85);
    xd = x + floor((w - xw) / 2);
    yd = y + max(2, floor(h * 0.04));
    xa = floor(xd + xw * 0.5);
    ya = floor(yd + yw * 1.1);
  ) : (
    r1 = floor(yw * 0.9);
    xd = floor(xw * 0.175);
    yd = y + 1;
    xa = floor(xd + xw * 0.5);
    ya = floor(yd + yw * 1.12);
  );
  zm_face_bot = yd + yw;

  // Hold enable: -21 = off (1175 convention)
  zm_hold_enabled = (hold_db > -20.5) ? 1 : 0;

  // ── Mouse interaction: theme cycling ──────────────────────
  (mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h) ? (
    // Mouse wheel scrolls through themes
    mouse_wheel != 0 ? (
      zm_theme += (mouse_wheel > 0) ? 1 : -1;
      zm_theme < 0 ? zm_theme = 10;
      zm_theme > 10 ? zm_theme = 0;
      color = zm_theme;
      mouse_wheel = 0;
    );
    // Right-click cycles forward
    (mouse_cap & 2) && !(zm_prev_mcap & 2) ? (
      zm_theme = zm_theme + 1;
      zm_theme > 10 ? zm_theme = 0;
      color = zm_theme;
    );
  );
  zm_prev_mcap = mouse_cap;

  // ── Draw order: frame → bg → 3D → arcs → scale → label → LED → hold → needle → coil
  zm_draw_frame();
  zm_draw_meter_bg();
  zm_draw_3D();

  // Both VU and GR use the same ZenoMOD face (arcs, scale, theme)
  zm_draw_arcs();
  zm_draw_scale();

  // Label: "VU" or "GR"
  meter_mode == 0 ? (zm_draw_vu_str()) : (zm_draw_gr_str());

  zm_draw_peak_LED(over_flag);

  // ── Needle mapping ────────────────────────────────────────
  meter_mode == 0 ? (
    // VU mode: feed spring-mass dB directly to needle (like ZenoMOD).
    // The spring physics produce the correct nonlinear VU ballistic response.
    // Do NOT apply vu() polynomial — that's for numeric readout only.

    // Hold
    zm_hold_enabled ? (
      zm_draw_hold_arc(hold_db);
      zm_compute_draw_needle(hold_db, 2);
    );

    // Main needle
    zm_compute_draw_needle(db_val, 1);
  ) : (
    // GR mode: interpolate through pos[] array for exact scale alignment
    // 0 dB GR → needle at "0" mark, -20 dB GR → needle at "-20" mark
    gr_vu_db = zm_gr_to_vu_db(db_val);

    // Hold
    zm_hold_enabled ? (
      hold_vu_db = zm_gr_to_vu_db(hold_db);
      zm_draw_hold_arc(hold_vu_db);
      zm_compute_draw_needle(hold_vu_db, 2);
    );

    // Main needle
    zm_compute_draw_needle(gr_vu_db, 1);
  );

  zm_draw_coil_cover();
);


// ── Convenience wrappers ─────────────────────────────────────

function zm_draw_stereo(x, y, w, h, dbL, dbR, holdL, holdR, overL, overR, theme_idx)
  local(mw, gap)
(
  gap = max(4, w * 0.02);
  mw = (w - gap) / 2;
  zm_draw_meter(x, y, mw, h, dbL, holdL, overL, theme_idx, 0);
  zm_draw_meter(x + mw + gap, y, mw, h, dbR, holdR, overR, theme_idx, 0);
);


// ── Backward-compatible wrappers (cx,cy,r → x,y,w,h) ────────

function mtr_vu_real_draw(cx, cy, r, db_val, hold_db, over, mode)
  local(bx, by, bw, bh)
(
  bw = r * 2.6;
  bh = r * 1.7;
  bx = cx - bw * 0.5;
  by = cy - r * 1.4;
  zm_draw_meter(bx, by, bw, bh, db_val, hold_db, over, zm_theme, mode);
);

function mtr_vu_real_draw_gr(cx, cy, r, gr_db, hold_db, over) (
  mtr_vu_real_draw(cx, cy, r, gr_db, hold_db, over, 1);
);

function mtr_vu_real_stereo(x, y, w, h, vu_l, vu_r, hold_l, hold_r, over_l, over_r)
  local(r, cx_l, cx_r, cy_both, gap)
(
  gap = max(6, w * 0.018);
  r = min((w - gap) / 5.08, h / 1.70);
  r = max(30, floor(r));
  cy_both = y + r * 1.34;
  cx_l = x + r * 1.27; cx_r = x + w - r * 1.27;
  mtr_vu_real_draw(cx_l, cy_both, r, vu_l, hold_l, over_l, 0);
  mtr_vu_real_draw(cx_r, cy_both, r, vu_r, hold_r, over_r, 0);
);

function mtr_vu_real_mono(x, y, w, h, vu_mono, hold_mono, over_mono)
  local(r, cx_m, cy_m)
(
  r = min(w / 2.54, h / 1.70);
  r = max(30, floor(r));
  cx_m = x + w * 0.5; cy_m = y + r * 1.34;
  mtr_vu_real_draw(cx_m, cy_m, r, vu_mono, hold_mono, over_mono, 0);
);

function mtr_vu_real_ms(x, y, w, h, vu_m, vu_s, hold_m, hold_s, over_m, over_s)
  local(r, cx_l, cx_r, cy_both, gap)
(
  gap = max(6, w * 0.018);
  r = min((w - gap) / 5.08, h / 1.70);
  r = max(30, floor(r));
  cy_both = y + r * 1.34;
  cx_l = x + r * 1.27; cx_r = x + w - r * 1.27;
  mtr_vu_real_draw(cx_l, cy_both, r, vu_m, hold_m, over_m, 0);
  mtr_vu_real_draw(cx_r, cy_both, r, vu_s, hold_s, over_s, 0);
);


