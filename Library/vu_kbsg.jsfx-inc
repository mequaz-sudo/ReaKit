zm_prev_mcap = 0;
zm_force_floating = 0;  // When 1, use floating geometry even in embedded mode
zm_frame_r = -1;  // If >= 0, overrides Frm_Buf for frame fill (coil cover always uses theme FG_Covr)
zm_frame_g = 0;
zm_frame_b = 0;

print = 10;
print[0] = -20; print[1] = -10; print[2] = -7; print[3] = -5; print[4] = -3;
print[5] = -2;  print[6] = -1;  print[7] = 0;  print[8] = 1;  print[9] = 2;
print[10] = 3;

// Scale arc positions (nonlinear VU mapping 0..1)
pos = 30;
pos[0] = 0;      pos[1] = .1650;  pos[2] = .2641;  pos[3] = .3519;  pos[4] = .4626;
pos[5] = .5284;  pos[6] = .6022;  pos[7] = .6849;  pos[8] = .7779;  pos[9] = .8822;
