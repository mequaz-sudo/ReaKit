desc: ReaKit colour picker
// ══════════════════════════════════════════════════════════════════════
// rk_colorpick.jsfx-inc — a row of swatches and a rainbow strip, for picking
// one colour.
//
// Written clean-room for ReaKit. Swing has this shape inside its pad overlay,
// but that copy writes straight into the pad model, reads the theme's
// saturation and lightness out of gmem, and shares a global drag arbiter with
// every other control in the plugin. What is actually reusable is the idea and
// the two or three decisions underneath it:
//
//   - A HUE IS NOT A COLOUR. The picker stores one number, and saturation and
//     lightness arrive from the caller, so a host with a light theme and a
//     host with a dark one get swatches that match their own panels instead of
//     a fixed palette that fits neither.
//   - BLACK AND WHITE ARE NOT HUES. They cannot live on a 0..1 hue line, so
//     they are negative sentinels: -2 is black, -1 is white, anything from 0
//     to 1 is a hue. The same convention Swing settled on.
//   - COARSE AND FINE ARE DIFFERENT CONTROLS. The swatch row is for picking a
//     colour quickly; the strip beside it is for the one you actually wanted.
//     Wheel over the strip steps a 64th, which is finer than the eye can
//     resolve on a 100 px strip but not finer than the value can hold.
//
// REQUIREMENTS (host plugin must provide, per frame, before calling):
//   - mx, my       — mouse position
//   - lmb_down     — left-button PRESS edge
//   - LMB          — left-button HELD state
//   - frame_wheel  — wheel ticks, for the strip
//   - dt, hv_speed — frame delta + hover ramp speed
//
// MEMORY: one caller-owned block of 4 words. [0] dragging the strip,
// [1] hover ramp, [2] hovered swatch.
//
// VALUE: -2 black, -1 white, 0..1 hue. Pass the current one in, use what comes
// back. The widget writes nothing itself.
//
// PUBLIC API:
//   rk_color_hsl(h, s, l)     publishes rk_color_r / _g / _b for a hue
//   rk_color_swatches(mem, x, y, w, h, cur, sat, lum)   the row, returns a value
//   rk_color_strip(mem, x, y, w, h, cur, sat, lum)      the rainbow, ditto
//   rk_color_pick(mem, x, y, w, h, cur, sat, lum)       both, side by side
// ══════════════════════════════════════════════════════════════════════

@init

RKCP_MEM  = 4;
RKCP_N    = 18;    // black + 16 hues + white
RKCP_STEP = 0.015625;   // a 64th of the hue circle, per wheel tick

// Hue/saturation/lightness to RGB. No transcendentals, so it is safe anywhere.
function rk_color_hsl(h, s, l) local(c, xx, m, hp, r1, g1, b1) (
  h = h - floor(h);
  c  = (1 - abs(2 * l - 1)) * s;
  hp = h * 6;
  xx = c * (1 - abs(hp - floor(hp * 0.5) * 2 - 1));
  m  = l - c * 0.5;
  hp < 1 ? ( r1 = c;  g1 = xx; b1 = 0;  ) :
  hp < 2 ? ( r1 = xx; g1 = c;  b1 = 0;  ) :
  hp < 3 ? ( r1 = 0;  g1 = c;  b1 = xx; ) :
  hp < 4 ? ( r1 = 0;  g1 = xx; b1 = c;  ) :
  hp < 5 ? ( r1 = xx; g1 = 0;  b1 = c;  ) :
           ( r1 = c;  g1 = 0;  b1 = xx; );
  rk_color_r = r1 + m; rk_color_g = g1 + m; rk_color_b = b1 + m;
);

// Set gfx to whatever `v` means, whether that is a hue or a sentinel.
function rk_color_set(v, sat, lum) (
  v <= -1.5 ? gfx_set(0.20, 0.20, 0.22, 1) :
  v <  0    ? gfx_set(0.82, 0.82, 0.85, 1) :
  ( rk_color_hsl(v, sat, lum); gfx_set(rk_color_r, rk_color_g, rk_color_b, 1); );
);

// Which cell of the row a value belongs to. Black is 0, white is the last,
// and a hue lands on its nearest sixteenth.
function rk_color_cell(v) local(i) (
  v <= -1.5 ? 0 :
  v <  0    ? RKCP_N - 1 :
  ( i = floor(v * 16 + 0.5); i >= 16 ? i = 0; i + 1; );
);

function rk_color_swatches(mem, x, y, w, h, cur, sat, lum)
local(i, cw, sx, nx, sel, hov, out) (
  out = cur;
  sel = rk_color_cell(cur);
  cw  = w / RKCP_N;

  gfx_set(0.04, 0.04, 0.05, 1);
  gfx_rect(x, y - 1, w, h + 2);

  i = 0;
  loop(RKCP_N,
    // Integer edges, so neighbouring cells tile with no seam and no overlap.
    sx = x + floor(i * cw);
    nx = x + floor((i + 1) * cw);
    hov = mx >= sx && mx < nx && my >= y && my < y + h;

    i == 0          ? rk_color_set(-2, sat, lum) :
    i == RKCP_N - 1 ? rk_color_set(-1, sat, lum) :
                      rk_color_set((i - 1) / 16, sat, lum);
    gfx_rect(sx + 1, y, nx - sx - 2, h);

    hov ? ( gfx_set(1, 1, 1, 0.18); gfx_rect(sx + 1, y, nx - sx - 2, h); );
    i == sel ? (
      gfx_set(1, 1, 1, 0.95);
      gfx_rect(sx, y - 1, nx - sx, h + 2, 0);
      gfx_rect(sx + 1, y, nx - sx - 2, h, 0);
    );

    hov && lmb_down ? (
      out = i == 0 ? -2 : i == RKCP_N - 1 ? -1 : (i - 1) / 16;
    );
    i += 1;
  );
  out;
);

function rk_color_strip(mem, x, y, w, h, cur, sat, lum)
local(i, hovr, out, mk) (
  out = cur;

  // The rainbow, a pixel column at a time.
  i = 0;
  loop(floor(w),
    rk_color_hsl(i / max(w - 1, 1), sat, lum);
    gfx_set(rk_color_r, rk_color_g, rk_color_b, 1);
    gfx_rect(x + i, y, 1, h);
    i += 1;
  );
  gfx_set(0.25, 0.26, 0.30, 0.6);
  gfx_rect(x - 1, y - 1, w + 2, h + 2, 0);

  hovr = mx >= x - 2 && mx <= x + w + 2 && my >= y - 2 && my <= y + h + 2;
  mem[1] = hovr ? min(mem[1] + dt * hv_speed, 1) : max(mem[1] - dt * hv_speed, 0);

  mem[0] ? ( LMB ? out = max(0, min(0.999, (mx - x) / max(w, 1))) : mem[0] = 0; );
  !mem[0] && hovr && lmb_down ? (
    mem[0] = 1;
    out = max(0, min(0.999, (mx - x) / max(w, 1)));
  );

  // Wheel is the fine control, and it wraps — hue is a circle.
  hovr && frame_wheel != 0 ? (
    out = (out < 0 ? 0 : out) + frame_wheel * RKCP_STEP;
    out = out - floor(out);
  );

  // The marker only means something for a hue; black and white are not on it.
  out >= 0 ? (
    mk = x + floor(out * w);
    gfx_set(0, 0, 0, 0.5);
    gfx_rect(mk - 2, y - 1, 1, h + 2); gfx_rect(mk + 2, y - 1, 1, h + 2);
    gfx_set(1, 1, 1, 0.9);
    gfx_rect(mk - 1, y - 1, 3, h + 2);
  );
  out;
);

// Both, with the strip taking the right third — coarse on the left, fine on
// the right, which is the order you reach for them in.
function rk_color_pick(mem, x, y, w, h, cur, sat, lum)
local(sw, gap, out) (
  gap = max(4, floor(w * 0.02));
  sw  = floor((w - gap) * 0.66);
  out = rk_color_swatches(mem, x, y, sw, h, cur, sat, lum);
  out = rk_color_strip(mem, x + sw + gap, y, w - sw - gap, h, out, sat, lum);
  out;
);
