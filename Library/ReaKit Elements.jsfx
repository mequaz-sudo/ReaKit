_n = (slider71 - 0) / max(0.000001, 100 - 0);
sld_set_accent(0.98,0.80,0.08);
_n2 = sld_vert_interact(sm, ox+sc*630, sc*205, sc*36, sc*170, _n);
_n2 != _n ? ( slider71 = 0 + _n2 * (100 - 0); slider_automate(slider71); );
sld_vconsole_draw(ox+sc*630, sc*205, sc*36, sc*170, _n2, sm);

); // end SLIDERS tab

// ═══════════════════════ TAB 3 · METERS ═══════════════════════
slider1 == 3 ? (

// METERS — all 12 meters_kbsg styles + analog VU (label)
gfx_setfont(1,"Arial",max(9,floor(11*sc)),'b'); gfx_set(0.72,0.74,0.80); gfx_x=ox+sc*14; gfx_y=sc*56; gfx_drawstr("METERS — all 12 meters_kbsg styles + analog VU (click the VU's cover to pick its face)");

// VU (vu) — rk_vu, the house analog VU: twenty faces, 300 ms movement.
// The face picker (rk_vu_picker) is called at the very end of @gfx so its
// sheet opens over everything; see the bottom of this file.
vu_0.rk_vu_draw(ox+sc*14, sc*80, sc*250, sc*150, 0, _vu_face, "VU");

// LEDBar (meter)
mtr_update_db();   // meters_kbsg: linear→dB once per frame
mtr_led_bar_draw(ox+sc*290, sc*80, sc*40, sc*84, mtr_peak_l, mtr_peak_r, -60, 0);   // meters_kbsg led_bar

// PkRMS (meter)
mtr_peak_rms_draw(ox+sc*350, sc*80, sc*34, sc*84, mtr_peak_l, mtr_rms_l, -60, 0, mtr_pk_hold_l);   // meters_kbsg peak_rms

// Ring (meter)
mtr_ring_draw(ox+sc*440, sc*122, sc*38, mtr_peak_l, mtr_peak_r, -60, 0);   // meters_kbsg ring

// Gonio (meter)
mtr_gonio_draw(ox+sc*560, sc*122, sc*38);   // meters_kbsg gonio

// Clip (meter)
mtr_clip_interact(ox+sc*655, sc*90, sc*9);   // click an LED to reset it
mtr_clip_draw(ox+sc*655, sc*90, sc*9, mtr_clip_l, mtr_clip_r);   // meters_kbsg clip

// Plasma (meter)
mtr_plasma_draw(ox+sc*14, sc*250, sc*150, sc*18, mtr_peak_l, -60, 0);   // meters_kbsg plasma

// GR (meter)
mtr_gr_draw(ox+sc*190, sc*250, sc*150, sc*18, mtr_gr_db);   // meters_kbsg gr — feed via meter_set_gr() from a compressor

// Phase (meter)
mtr_phase_draw(ox+sc*366, sc*250, sc*130, sc*18, mtr_phase);   // meters_kbsg phase

// Level (meter)
mtr_gr_draw(ox+sc*520, sc*250, sc*180, sc*16, mtr_gr_db);   // meters_kbsg gr bar (was the vu_kbsg bar)

// Wave (meter)
mtr_wave_draw(ox+sc*14, sc*300, sc*160, sc*72, 0);   // meters_kbsg wave

// Spectrum (meter)
mtr_spectrum_draw(ox+sc*200, sc*300, sc*150, sc*72);   // meters_kbsg spectrum

// LUFS (meter)
mtr_lufs_draw(ox+sc*390, sc*306, sc*110, sc*66, mtr_lufs_s);   // meters_kbsg lufs

// Thresh (meter)
thr_db = mtr_threshold_interact(thrmem, ox+sc*550, sc*306, sc*130, sc*66, thr_db, -60, 0);
mtr_threshold_draw(ox+sc*550, sc*306, sc*130, sc*66, thr_db, -60, 0);   // meters_kbsg threshold

); // end METERS tab

// ═══════════════════════ TAB 4 · PADS & KEYS ═══════════════════════
slider1 == 4 ? (

// PADS & KEYS — rk_padgrid / rk_piano (label)
gfx_setfont(1,"Arial",max(9,floor(11*sc)),'b'); gfx_set(0.72,0.74,0.80); gfx_x=ox+sc*14; gfx_y=sc*56; gfx_drawstr("PADS & KEYS — rk_padgrid / rk_piano");

// Pads (padgrid)
pg = pgdmem_0;
_pf = rk_padgrid_interact(pg, ox+sc*14, sc*80, sc*220, sc*220, 4, 4, sc*4);   // -1, or the pad just pressed
_pf >= 0 ? ( slider73 = _pf; slider_automate(slider73); );
rk_padgrid_draw(pg, ox+sc*14, sc*80, sc*220, sc*220, 4, 4, sc*4, slider73, 0.85,0.20,0.11);

// Keys (piano)
_pk = rk_piano_hit(ox+sc*260, sc*110, sc*300, sc*80, 48, 72, 0);   // note under the mouse, or -1
_pk >= 0 && lmb_down ? ( slider74 = _pk; slider_automate(slider74); );
rk_piano_draw(ox+sc*260, sc*110, sc*300, sc*80, 48, 72, 0, slider74, _pk, 0.29,0.62,1.00);

// KeysV (piano)
_pk = rk_piano_hit(ox+sc*600, sc*80, sc*60, sc*220, 48, 72, 1);   // note under the mouse, or -1
_pk >= 0 && lmb_down ? ( slider75 = _pk; slider_automate(slider75); );
rk_piano_draw(ox+sc*600, sc*80, sc*60, sc*220, 48, 72, 1, slider75, _pk, 0.29,0.87,0.50);

// DISPLAY (label)
gfx_setfont(1,"Arial",max(9,floor(11*sc)),'b'); gfx_set(0.72,0.74,0.80); gfx_x=ox+sc*260; gfx_y=sc*220; gfx_drawstr("DISPLAY");

// Scope (waveform)
gfx_set(0.03,0.03,0.06,1); gfx_rect(ox+sc*260, sc*240, sc*300, sc*74);
gfx_set(0.98,0.45,0.09,1); _wi=0;
loop(300,
  _s = wf_0[(wfp_0 + floor(_wi*WF_LEN/300)) % WF_LEN];
  _wi==0 ? ( gfx_x=ox+sc*260; gfx_y=sc*240+sc*74*0.5 - _s*(sc*74*0.5-2); ) : gfx_lineto(ox+sc*(260+_wi), sc*240+sc*74*0.5 - _s*(sc*74*0.5-2), 1);
  _wi+=1;
);

// Big Heading (label)
gfx_setfont(1,"Arial",max(9,floor(18*sc)),'b'); gfx_set(0.91,0.91,0.94); gfx_x=ox+sc*14; gfx_y=sc*330; gfx_drawstr("Big Heading");

// small caption label (label)
gfx_setfont(1,"Arial",max(9,floor(11*sc)),0); gfx_set(0.66,0.68,0.74); gfx_x=ox+sc*14; gfx_y=sc*362; gfx_drawstr("small caption label");

); // end PADS & KEYS tab

// ═══════════════════════ TAB 5 · CURVE ═══════════════════════
slider1 == 5 ? (
  gfx_setfont(1,"Arial",max(9,floor(11*sc)),'b'); gfx_set(0.72,0.74,0.80);
  gfx_x=ox+sc*14; gfx_y=sc*56; gfx_drawstr("CURVE — rk_curve: drag a node, wheel for width, double-click to flatten");

  _cx = ox+sc*14; _cy = sc*76; _cw = sc*712; _ch = sc*286;

  // Refill only when an input changes. Four bells over 512 points is ~4000
  // transcendentals a fill, and doing that every frame is how the Drum Strip's
  // graph once burned ~600k of them a second while nothing moved.
  _h = cvd[0] + cvd[1]*7 + cvd[2]*31 + cvd[3]*127
     + cvf[0]*0.001 + cvf[1]*0.003 + cvf[2]*0.007 + cvf[3]*0.013
     + cvw[0]*11 + cvw[1]*53 + cvw[2]*211 + cvw[3]*907;
  _h != cv_hash ? (
    cv_hash = _h;
    _i = 0;
    loop(CV_PTS,
      _f = rk_curve_x2f(_i, 0, CV_PTS - 1);
      _sum = 0; _j = 0;
      loop(4,
        _d = log(_f / cvf[_j]) / 0.69314718 / max(cvw[_j], CV_WMIN);
        _sum += cvd[_j] * exp(-_d * _d);
        _j += 1;
      );
      cvbuf[_i] = _sum; _i += 1;
    );
  );

  _i = 0;
  loop(16, cvspec[_i] = rk_curve_mag2db(mtr_base[1280 + _i]); _i += 1; );

  rk_curve_plate(_cx, _cy, _cw, _ch, 18);
  rk_curve_analyser(_cx, _cy, _cw, _ch, cvspec, 16, mtr_spec_lo, mtr_spec_hi,
                    0, -60, 0.95,0.64,0.24);
  rk_curve_trace(_cx, _cy, _cw, _ch, cvbuf, CV_PTS, 18, 1, 0.29,0.62,1.00);

  _n = rk_curve_nodes(cvnm, _cx, _cy, _cw, _ch, 18, cvf, cvd, 4);
  rk_curve_moved && _n >= 0 ? (
    cvf[_n] = max(40, min(rk_curve_nf, 16000));
    cvd[_n] = max(-15, min(rk_curve_ndb, 15));
  );
  rk_curve_nwheel != 0 && _n >= 0 ?
    cvw[_n] = max(CV_WMIN, min(cvw[_n] * (1 - rk_curve_nwheel * 0.12), 3));
  rk_curve_dblclk && _n >= 0 ? cvd[_n] = 0;
  rk_curve_nodes_draw(cvnm, _cx, _cy, _cw, _ch, 18, cvf, cvd, 4,
                      rk_curve_hov, 0.29,0.62,1.00);

  gfx_setfont(1,"Arial",max(8,floor(10*sc))); gfx_set(0.55,0.58,0.64);
  gfx_x=ox+sc*14; gfx_y=sc*370;
  gfx_drawstr("The widget draws an array and writes nothing back — the caller owns the values. Analyser: the meters' sixteen bands, same axis.");
);

rk_tooltip_draw(sc);

// ── Analog VU face picker: click the coil cover for a sheet of all twenty faces
// as live miniatures; click one to pick it, anywhere else to close. LAST in
// @gfx (it draws over everything), Meters tab only. ──
slider1 == 3 ? (
  _vu_pk = vu_0.rk_vu_picker(ox+sc*14, sc*80, sc*250, sc*150, _vu_face);
  _vu_pk >= 0 ? _vu_face = _vu_pk;
);

// The dropdown's menu, genuinely last: it draws over everything, tooltips
// included. A pick loads that envelope; ESC or a click away changes nothing.
_pp = rk_popup_run(ppmem, #el_menu, sc*18, el_key, 0.29, 0.62, 1.00);
_pp > 0 ? el_env_preset(_pp);
