desc:ReaKit Elements
// @description ReaKit - UI widget library for JSFX (knobs, faders, buttons, meters, VU)
// @author Quaz (EON Studios)
// @version 1.0.0
// @about
//   19 procedural knob styles, 17 slider/fader types, 10 button styles,
//   12 meter styles with DSP included, and an analog VU with 11 face themes.
//   No bitmaps - everything is drawn in code and scales to any size.
//   This file is the all-elements showcase; the library itself lives in the
//   *_kbsg.jsfx-inc files installed alongside it.
// @provides
//   [nomain] knobs_kbsg.jsfx-inc
//   [nomain] sliders_kbsg.jsfx-inc
//   [nomain] buttons_kbsg.jsfx-inc
//   [nomain] vu_kbsg.jsfx-inc
//   [nomain] meters_kbsg.jsfx-inc
tags: effect

// Requires the EON ReaKit *_kbsg.jsfx-inc libs on the JSFX import path
//   (knobs_kbsg must be the dispatcher build that defines rk_knob_draw).

slider3:60<0,100,0.01>-SSL
slider4:6<-24,24,0.01>-Vari-Mu
slider5:70<0,100,0.01>-API
slider6:55<0,100,0.01>-WS
slider7:40<0,100,0.01>-Neve
slider8:65<0,100,0.01>-Joanny
slider9:50<0,100,0.01>-MPC
slider10:35<0,100,0.01>-Jog
slider11:80<0,100,0.01>-Spice
slider12:50<0,100,0.01>-Encoder
slider13:40<0,100,0.01>-Pultec
slider14:65<0,100,0.01>-Ableton
slider15:55<0,100,0.01>-FL
slider16:45<0,100,0.01>-ProTools
slider17:60<0,100,0.01>-FabFilter
slider18:75<0,100,0.01>-Serum
slider19:35<0,100,0.01>-Roland
slider20:55<0,100,0.01>-PultecCr
slider21:62<0,100,0.01>-NeveAlt
slider23:1<0,1,1{Off,On}>-Bypass
slider24:1<0,1,1{Off,On}>-EQ
slider25:1<0,1,1{Off,On}>-Link
slider26:1<0,1,1{Off,On}>-On
slider27:1<0,1,1{Off,On}>-Mode
slider28:1<0,1,1{Off,On}>-Pwr
slider29:1<0,1,1{Off,On}>-Stomp
slider30:1<0,2,1{0: 6,1: 12,2: 24}>-Slope
slider31:0<0,2,1{0: Amp,1: EQ,2: Mod}>-Page
slider32:1<0,2,1{0: Clean,1: Warm,2: Tube}>-Type
slider34:65<0,100,0.01>-Std
slider35:72<0,100,0.01>-Fill
slider36:50<0,100,0.01>-Step
slider37:30<-100,100,0.01>-Bipolar
slider38:60<0,100,0.01>-Mini
slider39:70<0,100,0.01>-Arc
slider41:70<0,100,0.01>-V
slider42:78<0,100,0.01>-LED
slider43:55<0,100,0.01>-Groove
slider44:35<-100,100,0.01>-SSL
slider45:60<-100,100,0.01>-Neve
slider46:40<-100,100,0.01>-API
slider47:72<-100,100,0.01>-Tube
slider69:74<0,100,0.01>-PT
slider70:0<-100,100,0.01>-MPC
slider71:66<0,100,0.01>-4K

import knobs_kbsg.jsfx-inc
import buttons_kbsg.jsfx-inc
import sliders_kbsg.jsfx-inc
import vu_kbsg.jsfx-inc
import meters_kbsg.jsfx-inc

@init
freemem = 440;
KS = 16;
// freemem starts at 440: vu_kbsg owns addresses 0..437
km = freemem; freemem += 19 * KS;   // 16 words/knob
btnmem = freemem; freemem += 10 * 8;   // 8 words/button-family
sldmem = freemem; freemem += 16 * 16;  // 16 words/slider
WF_LEN = 256;
wf_0 = freemem; freemem += WF_LEN; wfp_0 = 0;
mtr_base = freemem; freemem += 1380; meter_init(mtr_base);   // meters_kbsg DSP state
mtr_en_rms = 1;   // enable (set after meter_init resets flags)
mtr_en_gonio = 1;   // enable (set after meter_init resets flags)
mtr_en_phase = 1;   // enable (set after meter_init resets flags)
mtr_en_wave = 1;   // enable (set after meter_init resets flags)
mtr_en_spectrum = 1;   // enable (set after meter_init resets flags)
mtr_en_lufs = 1;   // enable (set after meter_init resets flags)
vu_0.vu_init(2);   // VU ballistics (speed 2)

@slider

@block

@sample
vu_0.vu_sample(abs(spl0));
mtr_0 = max(abs(spl0), mtr_0 * 0.999);   // placeholder peak-decay feed
meter_process_sample(spl0, spl1);   // drives mtr_peak_l/r, mtr_rms_l/r, mtr_phase, …
wf_0[wfp_0] = spl0; wfp_0 = wfp_0 < WF_LEN - 1 ? wfp_0 + 1 : 0;
// audio passthrough — insert DSP above; spl0/spl1 left unchanged

@gfx 740 1130
gfx_clear = 0x2e1a1a;   // canvas #1a1a2e packed as r+g*256+b*65536
zoom = 1;               // barmeter_hor multiplies coords by this

// --- per-frame input globals required by the kbsg libs ---
mx = mouse_x; my = mouse_y;
LMB = mouse_cap & 1; lmb_down = LMB && !_pLMB; _pLMB = LMB;
CTRL = mouse_cap & 4; SHIFT = mouse_cap & 8;
dt = time_precise() - _lt; _lt = time_precise(); hv_speed = 11; tau = 2*$pi;
frame_wheel = mouse_wheel / 120; mouse_wheel = 0;

// REAKIT — EVERY ELEMENT (label)
gfx_setfont(1,"Arial",13,'b'); gfx_set(0.85,0.20,0.11); gfx_x=14; gfx_y=8; gfx_drawstr("REAKIT — EVERY ELEMENT");

// KNOBS — all 19 styles (select one · scroll to change) (label)
gfx_setfont(1,"Arial",10,'b'); gfx_set(0.53,0.53,0.60); gfx_x=14; gfx_y=30; gfx_drawstr("KNOBS — all 19 styles (select one · scroll to change)");

// SSL (knob / ssl)
m = km + 0*KS;
_v = rk_knob_interact(1, m, 43, 74, 25, slider3, 0, 100, 60, 0);
_v != slider3 ? ( slider3 = _v; slider_automate(slider3); );
rk_knob_draw(1, 43, 74, 25, slider3, 0, 100, 0, m[0], 0.29,0.62,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("SSL",_tw,_th); gfx_x=43-_tw/2; gfx_y=103; gfx_drawstr("SSL");

// Vari-Mu (knob / varimu)
m = km + 1*KS;
_v = rk_knob_interact(2, m, 116, 74, 25, slider4, -24, 24, 6, 0);
_v != slider4 ? ( slider4 = _v; slider_automate(slider4); );
rk_knob_draw(2, 116, 74, 25, slider4, -24, 24, 1, m[0], 0.29,0.87,0.50, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Vari-Mu",_tw,_th); gfx_x=116-_tw/2; gfx_y=103; gfx_drawstr("Vari-Mu");

// API (knob / api)
m = km + 2*KS;
_v = rk_knob_interact(3, m, 189, 74, 25, slider5, 0, 100, 70, 0);
_v != slider5 ? ( slider5 = _v; slider_automate(slider5); );
rk_knob_draw(3, 189, 74, 25, slider5, 0, 100, 0, m[0], 0.98,0.80,0.08, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("API",_tw,_th); gfx_x=189-_tw/2; gfx_y=103; gfx_drawstr("API");

// WS (knob / ws)
m = km + 3*KS;
_v = rk_knob_interact(4, m, 262, 74, 25, slider6, 0, 100, 55, 0);
_v != slider6 ? ( slider6 = _v; slider_automate(slider6); );
rk_knob_draw(4, 262, 74, 25, slider6, 0, 100, 0, m[0], 0.98,0.45,0.09, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("WS",_tw,_th); gfx_x=262-_tw/2; gfx_y=103; gfx_drawstr("WS");

// Neve (knob / neve)
m = km + 4*KS;
_v = rk_knob_interact(5, m, 335, 74, 25, slider7, 0, 100, 40, 0);
_v != slider7 ? ( slider7 = _v; slider_automate(slider7); );
rk_knob_draw(5, 335, 74, 25, slider7, 0, 100, 0, m[0], 0.81,0.23,0.19, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Neve",_tw,_th); gfx_x=335-_tw/2; gfx_y=103; gfx_drawstr("Neve");

// Joanny (knob / witti)
m = km + 5*KS;
_v = rk_knob_interact(6, m, 408, 74, 25, slider8, 0, 100, 65, 0);
_v != slider8 ? ( slider8 = _v; slider_automate(slider8); );
rk_knob_draw(6, 408, 74, 25, slider8, 0, 100, 0, m[0], 0.64,0.46,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Joanny",_tw,_th); gfx_x=408-_tw/2; gfx_y=103; gfx_drawstr("Joanny");

// MPC (knob / mpc)
m = km + 6*KS;
_v = rk_knob_interact(7, m, 481, 74, 25, slider9, 0, 100, 50, 0);
_v != slider9 ? ( slider9 = _v; slider_automate(slider9); );
rk_knob_draw(7, 481, 74, 25, slider9, 0, 100, 0, m[0], 0.17,0.73,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("MPC",_tw,_th); gfx_x=481-_tw/2; gfx_y=103; gfx_drawstr("MPC");

// Jog (knob / jog)
m = km + 7*KS;
_v = rk_knob_interact(8, m, 554, 74, 25, slider10, 0, 100, 35, 0);
_v != slider10 ? ( slider10 = _v; slider_automate(slider10); );
rk_knob_draw(8, 554, 74, 25, slider10, 0, 100, 0, m[0], 0.86,0.72,0.42, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Jog",_tw,_th); gfx_x=554-_tw/2; gfx_y=103; gfx_drawstr("Jog");

// Spice (knob / sp)
m = km + 8*KS;
_v = rk_knob_interact(10, m, 627, 74, 25, slider11, 0, 100, 80, 0);
_v != slider11 ? ( slider11 = _v; slider_automate(slider11); );
rk_knob_draw(10, 627, 74, 25, slider11, 0, 100, 0, m[0], 0.89,0.29,0.29, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Spice",_tw,_th); gfx_x=627-_tw/2; gfx_y=103; gfx_drawstr("Spice");

// Encoder (knob / encoder)
m = km + 9*KS;
_v = rk_knob_interact(11, m, 43, 148, 25, slider12, 0, 100, 50, 0);
_v != slider12 ? ( slider12 = _v; slider_automate(slider12); );
rk_knob_draw(11, 43, 148, 25, slider12, 0, 100, 0, m[0], 0.29,0.62,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Encoder",_tw,_th); gfx_x=43-_tw/2; gfx_y=177; gfx_drawstr("Encoder");

// Pultec (knob / pultec)
m = km + 10*KS;
_v = rk_knob_interact(12, m, 116, 148, 25, slider13, 0, 100, 40, 0);
_v != slider13 ? ( slider13 = _v; slider_automate(slider13); );
rk_knob_draw(12, 116, 148, 25, slider13, 0, 100, 0, m[0], 0.86,0.72,0.42, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Pultec",_tw,_th); gfx_x=116-_tw/2; gfx_y=177; gfx_drawstr("Pultec");

// Ableton (knob / ableton)
m = km + 11*KS;
_v = rk_knob_interact(13, m, 189, 148, 25, slider14, 0, 100, 65, 0);
_v != slider14 ? ( slider14 = _v; slider_automate(slider14); );
rk_knob_draw(13, 189, 148, 25, slider14, 0, 100, 0, m[0], 0.29,0.87,0.50, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Ableton",_tw,_th); gfx_x=189-_tw/2; gfx_y=177; gfx_drawstr("Ableton");

// FL (knob / fl)
m = km + 12*KS;
_v = rk_knob_interact(14, m, 262, 148, 25, slider15, 0, 100, 55, 0);
_v != slider15 ? ( slider15 = _v; slider_automate(slider15); );
rk_knob_draw(14, 262, 148, 25, slider15, 0, 100, 0, m[0], 0.98,0.80,0.08, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("FL",_tw,_th); gfx_x=262-_tw/2; gfx_y=177; gfx_drawstr("FL");

// ProTools (knob / pt)
m = km + 13*KS;
_v = rk_knob_interact(15, m, 335, 148, 25, slider16, 0, 100, 45, 0);
_v != slider16 ? ( slider16 = _v; slider_automate(slider16); );
rk_knob_draw(15, 335, 148, 25, slider16, 0, 100, 0, m[0], 0.29,0.62,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("ProTools",_tw,_th); gfx_x=335-_tw/2; gfx_y=177; gfx_drawstr("ProTools");

// FabFilter (knob / fabfilter)
m = km + 14*KS;
_v = rk_knob_interact(16, m, 408, 148, 25, slider17, 0, 100, 60, 0);
_v != slider17 ? ( slider17 = _v; slider_automate(slider17); );
rk_knob_draw(16, 408, 148, 25, slider17, 0, 100, 0, m[0], 0.29,0.87,0.50, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("FabFilter",_tw,_th); gfx_x=408-_tw/2; gfx_y=177; gfx_drawstr("FabFilter");

// Serum (knob / serum)
m = km + 15*KS;
_v = rk_knob_interact(17, m, 481, 148, 25, slider18, 0, 100, 75, 0);
_v != slider18 ? ( slider18 = _v; slider_automate(slider18); );
rk_knob_draw(17, 481, 148, 25, slider18, 0, 100, 0, m[0], 0.64,0.46,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Serum",_tw,_th); gfx_x=481-_tw/2; gfx_y=177; gfx_drawstr("Serum");

// Roland (knob / roland)
m = km + 16*KS;
_v = rk_knob_interact(18, m, 554, 148, 25, slider19, 0, 100, 35, 0);
_v != slider19 ? ( slider19 = _v; slider_automate(slider19); );
rk_knob_draw(18, 554, 148, 25, slider19, 0, 100, 0, m[0], 0.98,0.45,0.09, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("Roland",_tw,_th); gfx_x=554-_tw/2; gfx_y=177; gfx_drawstr("Roland");

// PultecCr (knob / pultec_cream)
m = km + 17*KS;
_v = rk_knob_interact(19, m, 627, 148, 25, slider20, 0, 100, 55, 0);
_v != slider20 ? ( slider20 = _v; slider_automate(slider20); );
rk_knob_draw(19, 627, 148, 25, slider20, 0, 100, 0, m[0], 0.86,0.72,0.42, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("PultecCr",_tw,_th); gfx_x=627-_tw/2; gfx_y=177; gfx_drawstr("PultecCr");

// NeveAlt (knob / neve_alt)
m = km + 18*KS;
_v = rk_knob_interact(20, m, 700, 148, 25, slider21, 0, 100, 62, 0);
_v != slider21 ? ( slider21 = _v; slider_automate(slider21); );
rk_knob_draw(20, 700, 148, 25, slider21, 0, 100, 0, m[0], 0.81,0.23,0.19, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",11); gfx_set(0.60,0.64,0.69,1); gfx_measurestr("NeveAlt",_tw,_th); gfx_x=700-_tw/2; gfx_y=177; gfx_drawstr("NeveAlt");

// BUTTONS — all 10 styles (label)
gfx_setfont(1,"Arial",10,'b'); gfx_set(0.53,0.53,0.60); gfx_x=14; gfx_y=194; gfx_drawstr("BUTTONS — all 10 styles");

// Bypass (button)
bm = btnmem + 0*8;
_bs = btn_pill_interact(bm, 20, 230, 84, 28, slider23);
_bs != slider23 ? ( slider23 = _bs; slider_automate(slider23); );
btn_pill_draw(20, 230, 84, 28, slider23, "Bypass", bm[0], 0.85,0.20,0.11);

// EQ (button)
bm = btnmem + 1*8;
_bs = btn_rect_interact(bm, 120, 230, 66, 26, slider24);
_bs != slider24 ? ( slider24 = _bs; slider_automate(slider24); );
btn_rect_draw(120, 230, 66, 26, slider24, "EQ", bm[0], 0.29,0.87,0.50);

// Link (button)
bm = btnmem + 2*8;
_bs = btn_checkbox_interact(bm, 210, 230, 22, 74, slider25);
_bs != slider25 ? ( slider25 = _bs; slider_automate(slider25); );
btn_checkbox_draw(210, 230, 22, slider25, "Link", bm[0], 0.29,0.87,0.50);

// On (button)
bm = btnmem + 3*8;
_bs = btn_led_interact(bm, 423, 303, 13, slider26);
_bs != slider26 ? ( slider26 = _bs; slider_automate(slider26); );
btn_led_draw(423, 303, 13, slider26, "On", bm[0], 0.98,0.80,0.08, 0);

// Mode (button)
bm = btnmem + 4*8;
_bs = btn_rocker2_interact(bm, 300, 230, 80, 30, slider27);
_bs != slider27 ? ( slider27 = _bs; slider_automate(slider27); );
btn_rocker2_draw(300, 230, 80, 30, slider27, "IN", "OUT", bm[0]);

// Pwr (button)
bm = btnmem + 5*8;
_bs = btn_vintage_toggle_interact(bm, 533, 303, 46, 46, slider28);
_bs != slider28 ? ( slider28 = _bs; slider_automate(slider28); );
btn_vintage_toggle_draw(533, 303, 46, 46, slider28, bm[0]);

// Stomp (button)
bm = btnmem + 6*8;
_bs = btn_footswitch_interact(bm, 617, 301, 27, slider29);
_bs != slider29 ? ( slider29 = _bs; slider_automate(slider29); );
btn_footswitch_draw(617, 301, 27, slider29, "Stomp", bm[0], 0.81,0.23,0.19);

// Slope (button)
bm = btnmem + 7*8;
_bs = btn_rocker3_interact(bm, 20, 270, 92, 62, slider30);
_bs != slider30 ? ( slider30 = _bs; slider_automate(slider30); );
btn_rocker3_draw(20, 270, 92, 62, slider30, "6", "12", "24", bm[0]);

// Page (button)
bm = btnmem + 8*8;
_bs = btn_tab_interact(bm, 180, 280, 57, 26, 3, 2, slider31);
_bs != slider31 ? ( slider31 = _bs; slider_automate(slider31); );
btn_tab_draw(180, 280, 57, 26, 0, slider31==0, "Amp", bm[0]);
btn_tab_draw(239, 280, 57, 26, 1, slider31==1, "EQ", bm[0]);
btn_tab_draw(298, 280, 57, 26, 2, slider31==2, "Mod", bm[0]);

// Type (button)
bm = btnmem + 9*8;
slider32==0 ? strcpy(#_sel32,"Clean") : slider32==1 ? strcpy(#_sel32,"Warm") : strcpy(#_sel32,"Tube");
_d = btn_incdec_interact(bm, 400, 230, 132, 26);
_d != 0 ? ( slider32 = max(0, min(2, slider32 + _d)); slider_automate(slider32); );
btn_incdec_draw(400, 230, 132, 26, #_sel32, bm[0]);

// SLIDERS — horizontal + arc (label)
gfx_setfont(1,"Arial",10,'b'); gfx_set(0.53,0.53,0.60); gfx_x=14; gfx_y=348; gfx_drawstr("SLIDERS — horizontal + arc");

// Std (hslider)
sm = sldmem + 0*16;
_n = (slider34 - 0) / max(0.000001, 100 - 0);
sld_set_accent(0.29,0.62,1.00);
_n2 = sld_horiz_interact(sm, 14, 368, 118, 22, _n);
_n2 != _n ? ( slider34 = 0 + _n2 * (100 - 0); slider_automate(slider34); );
sld_horiz_draw(14, 368, 118, 22, _n2, sm);
gfx_setfont(1,"Arial",9); gfx_set(0.5,0.5,0.5,1); gfx_x=14; gfx_y=389; gfx_drawstr("Std");

// Fill (hslider)
sm = sldmem + 1*16;
_n = (slider35 - 0) / max(0.000001, 100 - 0);
sld_set_accent(0.29,0.87,0.50);
_n2 = sld_fillbar_interact(sm, 140, 368, 118, 22, _n);
_n2 != _n ? ( slider35 = 0 + _n2 * (100 - 0); slider_automate(slider35); );
sld_fillbar_draw(140, 368, 118, 22, _n2, sm);
gfx_setfont(1,"Arial",9); gfx_set(0.5,0.5,0.5,1); gfx_x=140; gfx_y=389; gfx_drawstr("Fill");

// Step (hslider)
sm = sldmem + 2*16;
_n = (slider36 - 0) / max(0.000001, 100 - 0);
sld_set_accent(0.98,0.80,0.08);
_n2 = sld_stepped_interact(sm, 266, 368, 118, 22, _n, 5);
_n2 != _n ? ( slider36 = 0 + _n2 * (100 - 0); slider_automate(slider36); );
sld_stepped_draw(266, 368, 118, 22, _n2, 5, sm);
gfx_setfont(1,"Arial",9); gfx_set(0.5,0.5,0.5,1); gfx_x=266; gfx_y=389; gfx_drawstr("Step");

// Bipolar (hslider)
sm = sldmem + 3*16;
_n = (slider37 - -100) / max(0.000001, 100 - -100);
sld_set_accent(0.29,0.62,1.00);
_n2 = sld_bipolar_interact(sm, 392, 368, 118, 22, _n);
_n2 != _n ? ( slider37 = -100 + _n2 * (100 - -100); slider_automate(slider37); );
