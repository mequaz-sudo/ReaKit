  cat == 36 ? ( gfx_line(cx-0.55*s,cy+0.5*s,cx,cy-0.55*s,1); gfx_line(cx,cy-0.55*s,cx+0.55*s,cy+0.5*s,1); gfx_line(cx-0.55*s,cy+0.5*s,cx+0.28*s,cy+0.5*s,1); gfx_line(cx+0.16*s,cy-0.08*s,cx+0.7*s,cy-0.24*s,1); ) :  // triangle (ex-percussion art)
  cat == 37 ? ( gfx_rect(cx-0.75*s,cy-0.3*s,1.5*s,0.75*s,0); gfx_line(cx-0.55*s,cy-0.05*s,cx+0.55*s,cy-0.05*s,1); gfx_line(cx+0.3*s,cy-0.45*s,cx+0.75*s,cy-0.9*s,1); gfx_circle(cx+0.28*s,cy-0.42*s,0.1*s,1,1); ) :  // woodblock: block + slit + mallet
  cat == 38 ? ( rk_icon_ell(cx,cy-0.55*s,0.5*s,0.15*s,0,2*$pi); gfx_line(cx-0.5*s,cy-0.55*s,cx-0.5*s,cy+0.15*s,1); gfx_line(cx+0.5*s,cy-0.55*s,cx+0.5*s,cy+0.15*s,1); rk_icon_ell(cx,cy+0.15*s,0.5*s,0.15*s,0,$pi); gfx_line(cx-0.45*s,cy-0.45*s,cx+0.45*s,cy+0.1*s,1); gfx_line(cx+0.45*s,cy-0.45*s,cx-0.45*s,cy+0.1*s,1); gfx_line(cx,cy+0.3*s,cx,cy+0.9*s,1); ) :  // cabasa: beaded cylinder + handle
  cat == 39 ? ( rk_icon_ell(cx-0.05*s,cy+0.05*s,0.8*s,0.38*s,0,2*$pi); gfx_line(cx-0.5*s,cy-0.25*s,cx-0.5*s,cy+0.35*s,1); gfx_line(cx-0.25*s,cy-0.3*s,cx-0.25*s,cy+0.4*s,1); gfx_line(cx,cy-0.32*s,cx,cy+0.42*s,1); gfx_line(cx+0.25*s,cy-0.3*s,cx+0.25*s,cy+0.4*s,1); gfx_line(cx+0.45*s,cy-0.4*s,cx+0.9*s,cy-0.85*s,1); ) :  // guiro: ridged gourd + scraper
  cat == 40 ? ( rk_icon_ell(cx,cy-0.35*s,0.8*s,0.22*s,0,2*$pi); gfx_line(cx-0.8*s,cy-0.35*s,cx-0.8*s,cy+0.1*s,1); gfx_line(cx+0.8*s,cy-0.35*s,cx+0.8*s,cy+0.1*s,1); rk_icon_ell(cx,cy+0.1*s,0.8*s,0.22*s,0,$pi); gfx_line(cx,cy+0.32*s,cx,cy+0.9*s,1); gfx_line(cx-0.3*s,cy+0.9*s,cx+0.3*s,cy+0.9*s,1); ) :  // timbale: shallow metal shell + stand
  cat == 41 ? ( gfx_line(cx-0.75*s,cy-0.35*s,cx-0.35*s,cy+0.55*s,1); gfx_line(cx+0.05*s,cy-0.35*s,cx-0.35*s,cy+0.55*s,1); gfx_line(cx-0.75*s,cy-0.35*s,cx+0.05*s,cy-0.35*s,1); gfx_line(cx+0.15*s,cy-0.2*s,cx+0.5*s,cy+0.75*s,1); gfx_line(cx+0.85*s,cy-0.2*s,cx+0.5*s,cy+0.75*s,1); gfx_line(cx+0.15*s,cy-0.2*s,cx+0.85*s,cy-0.2*s,1); gfx_line(cx-0.35*s,cy-0.35*s,cx+0.05*s,cy-0.75*s,1); gfx_line(cx+0.05*s,cy-0.75*s,cx+0.5*s,cy-0.2*s,1); ) :  // agogo: two bells + U handle
  cat == 42 ? ( rk_icon_ell(cx,cy-0.6*s,0.65*s,0.2*s,0,2*$pi); gfx_line(cx-0.65*s,cy-0.6*s,cx-0.2*s,cy+0.15*s,1); gfx_line(cx+0.65*s,cy-0.6*s,cx+0.2*s,cy+0.15*s,1); gfx_line(cx-0.2*s,cy+0.15*s,cx-0.5*s,cy+0.85*s,1); gfx_line(cx+0.2*s,cy+0.15*s,cx+0.5*s,cy+0.85*s,1); rk_icon_ell(cx,cy+0.85*s,0.5*s,0.14*s,0,$pi); ) :  // djembe: goblet drum
  cat == 43 ? ( gfx_rect(cx-0.6*s,cy-0.85*s,1.2*s,1.7*s,0); gfx_circle(cx,cy-0.4*s,0.22*s,0,1); gfx_line(cx-0.6*s,cy-0.62*s,cx+0.6*s,cy-0.62*s,1); ) :  // cajon: box + hole + seat edge
  cat == 44 ? ( gfx_circle(cx-0.62*s,cy+0.62*s,0.2*s,0,1); gfx_line(cx-0.48*s,cy+0.48*s,cx+0.35*s,cy-0.35*s,1); gfx_line(cx+0.35*s,cy-0.35*s,cx+0.85*s,cy-0.1*s,1); gfx_line(cx+0.35*s,cy-0.35*s,cx+0.6*s,cy-0.85*s,1); gfx_line(cx+0.6*s,cy-0.85*s,cx+0.85*s,cy-0.1*s,1); ) :  // vibraslap: ball + rod + rattle wedge
  cat == 45 ? ( gfx_circle(cx-0.2*s,cy+0.2*s,0.5*s,0,1); gfx_line(cx+0.1*s,cy-0.2*s,cx+0.85*s,cy-0.2*s,1); gfx_line(cx+0.15*s,cy+0.05*s,cx+0.85*s,cy+0.05*s,1); gfx_line(cx+0.85*s,cy-0.2*s,cx+0.85*s,cy+0.05*s,1); gfx_circle(cx-0.2*s,cy+0.2*s,0.1*s,1,1); ) :  // whistle: pea whistle
  ( gfx_line(cx-0.6*s,cy-0.3*s,cx-0.6*s,cy+0.3*s,1); gfx_line(cx-0.3*s,cy-0.6*s,cx-0.3*s,cy+0.6*s,1); gfx_line(cx,cy-0.42*s,cx,cy+0.42*s,1); gfx_line(cx+0.3*s,cy-0.68*s,cx+0.3*s,cy+0.68*s,1); gfx_line(cx+0.6*s,cy-0.25*s,cx+0.6*s,cy+0.25*s,1); );  // 31 other
);

// public entry: lum >= 0 sets the ink (dark on light tiles, light on dark; lum < 0
// keeps the caller's colour). LOD: s < 11 -> small tier, else detailed.
// Self-contained ink (no host setcolor dependency): same 28/32/40 : 205/211/221 values.
function rk_icon_draw(cat, cx, cy, s, lum) (
  lum >= 0 ? (
    lum > 0.55 ? gfx_set(28/255, 32/255, 40/255, 240/255)
               : gfx_set(205/255, 211/255, 221/255, 235/255);
  );
  s < 11 ? rk_icon_sm(cat, cx, cy, s) : rk_icon_lg(cat, cx, cy, s);
);

// pad variant: ALWAYS the detailed tier (no LOD). Swing pads are never as tiny
// as the StepSeq lane column, and letting the small tier kick in made the SAME
// pad look different between the big floating grid and the embedded strip
// (tom = cylinder vs plain circle, cymbal = triple-ring vs single). Same ink.
function rk_icon_draw_hi(cat, cx, cy, s, lum) (
  lum >= 0 ? (
    lum > 0.55 ? gfx_set(28/255, 32/255, 40/255, 240/255)
               : gfx_set(205/255, 211/255, 221/255, 235/255);
  );
  rk_icon_lg(cat, cx, cy, s);
);

// Whole-word test for short tokens (bd/kk/sd/ch/oh): EEL2 match() has no frontier,
// so a bare "ch" substring would false-hit "china". Emulate a word match — exact,
// or the token flanked by spaces at the start / end / middle of the (already
// lowercased + separator-normalized) name. Mirrors rk_swing_colors' ch/oh handling.
function rk_icon_wordm(tok) (
  sprintf(#eon_wa, "%s *", tok);
  sprintf(#eon_wb, "* %s", tok);
  sprintf(#eon_wc, "* %s *", tok);
  match(tok,#eon_gn) || match(#eon_wa,#eon_gn) || match(#eon_wb,#eon_gn) || match(#eon_wc,#eon_gn);
);

// EON: category id (0..45) from a pad/lane NAME. FAITHFUL first-match port of
// eon_filename_categorizer.lua (same keywords, CATEGORY_ORDER priority: specific
// before generic). Separators _ - . ( ) normalize to spaces like the Lua.
//
// ⭐ EVERY keyword the Lua matches by frontier pattern (its <=3-char rule) goes
// through rk_icon_wordm here — not just the 2-char ones. Bare substrings for those
// were a real bug: "*tom*" claimed "Custom"/"Phantom"/"Bottom", "*rim*" claimed
// "Primary"/"Grimey", "*arp*" claimed "Harp"/"Warp", "*sub*" claimed "Subtle",
// "*hat*" claimed "Whatever", "*fx*" claimed any name containing those letters.
// Where the Lua ALSO carries a longer plural ("hats", "toms", "pads"), that stays
// a plain substring beside the word match, exactly as the Lua has it.
//
// Residual: the Lua SCORES + tiebreaks while this is first-match, so a rare
// compound name hitting several categories may differ; the ordering minimizes it.
// KEEP IN SYNC with eon_filename_categorizer.lua (and rk_lua_cat_glyphs M.ID).
// ⭐ .dev_tests/categorizer_parity.py diffs the two tables + their behaviour and
// FAILS on drift — run it after touching either side.
function rk_icon_for_name(nm) local(i, len, ch) (
  strcpy(#eon_gn, nm);
  len = strlen(#eon_gn);
  i = 0;
  loop(len,
    ch = str_getchar(#eon_gn, i);
    (ch >= 65 && ch <= 90) ? str_setchar(#eon_gn, i, ch+32) :
    (ch == 95 || ch == 45 || ch == 46 || ch == 40 || ch == 41) ? str_setchar(#eon_gn, i, 32) :  // _ - . ( ) -> space
    (ch >= 48 && ch <= 57) ? str_setchar(#eon_gn, i, 32);   // digits -> space: emulate the Lua's digit=word-boundary so "CH1"/"BD2" still word-match (no keyword contains a digit)
    i += 1;
  );
  match("*kick*",#eon_gn)||rk_icon_wordm("kck")||rk_icon_wordm("kik")||match("*bass drum*",#eon_gn)||match("*bassdrum*",#eon_gn)||rk_icon_wordm("bd")||rk_icon_wordm("kk") ? 0 :
  match("*snare*",#eon_gn)||rk_icon_wordm("snr")||rk_icon_wordm("sd") ? 1 :
  match("*sidestick*",#eon_gn)||match("*side stick*",#eon_gn)||match("*cross stick*",#eon_gn)||match("*crosstick*",#eon_gn)||match("*xstick*",#eon_gn)||match("*x stick*",#eon_gn)||match("*stick*",#eon_gn) ? 35 :
  match("*rimshot*",#eon_gn)||match("*rim shot*",#eon_gn)||rk_icon_wordm("rim") ? 2 :
  match("*clap*",#eon_gn)||rk_icon_wordm("clp") ? 3 :
  // "*snap*" already covers the Lua's snaps/fingersnap/finger snap; the old
  // bare "*finger*" was BROADER than the Lua and stole e.g. "Finger Cymbal".
  match("*snap*",#eon_gn) ? 32 :
  match("*closed*",#eon_gn)||match("*pedal hat*",#eon_gn)||match("*pedalhat*",#eon_gn)||rk_icon_wordm("ch")||rk_icon_wordm("chh") ? 4 :
  match("*open*",#eon_gn)||rk_icon_wordm("oh")||rk_icon_wordm("ohh") ? 5 :
  // ⭐ 2026-07-27 user rule (mirrors eon_filename_categorizer): a GENERIC
  // hi-hat name means CLOSED. Row order is load-bearing: open (above) keeps
  // "Open Hat"->5; this row takes hihat/hi hat/high hat/hh -> 4; the reduced
  // bare *hat* row below stays 6 — and must NEVER read as open.
  match("*hihat*",#eon_gn)||match("*hi hat*",#eon_gn)||match("*high hat*",#eon_gn)||match("*highhat*",#eon_gn)||rk_icon_wordm("hh") ? 4 :
  rk_icon_wordm("hat")||match("*hats*",#eon_gn) ? 6 :
  match("*splash*",#eon_gn)||match("*splsh*",#eon_gn) ? 33 :
  match("*china*",#eon_gn)||match("*trash*",#eon_gn)||match("*stack*",#eon_gn) ? 34 :
  match("*cymbal*",#eon_gn)||rk_icon_wordm("cym") ? 7 :
  match("*crash*",#eon_gn)||match("*crsh*",#eon_gn) ? 8 :
  match("*ride*",#eon_gn) ? 9 :
  match("*floor tom*",#eon_gn)||match("*floortom*",#eon_gn)||match("*floor*",#eon_gn)||match("*low tom*",#eon_gn)||match("*lowtom*",#eon_gn)||match("*lo tom*",#eon_gn) ? 10 :
  match("*rack*",#eon_gn)||match("*hi tom*",#eon_gn)||match("*hitom*",#eon_gn)||match("*high tom*",#eon_gn)||match("*mid tom*",#eon_gn)||match("*midtom*",#eon_gn) ? 11 :
  rk_icon_wordm("tom")||match("*toms*",#eon_gn) ? 12 :
  match("*conga*",#eon_gn) ? 13 :
  match("*bongo*",#eon_gn) ? 14 :
  match("*cowbell*",#eon_gn)||match("*cow bell*",#eon_gn) ? 15 :
  match("*clave*",#eon_gn) ? 16 :
  match("*tambourine*",#eon_gn)||match("*tamb*",#eon_gn) ? 17 :
  match("*shaker*",#eon_gn)||match("*shake*",#eon_gn) ? 18 :
  match("*maraca*",#eon_gn)||match("*marcas*",#eon_gn) ? 19 :
  match("*triangle*",#eon_gn) ? 36 :
  match("*woodblock*",#eon_gn)||match("*wood block*",#eon_gn)||match("*click*",#eon_gn) ? 37 :
  match("*cabasa*",#eon_gn) ? 38 :
  match("*guiro*",#eon_gn) ? 39 :
  match("*timbale*",#eon_gn) ? 40 :
  match("*agogo*",#eon_gn) ? 41 :
  match("*djembe*",#eon_gn)||match("*jembe*",#eon_gn) ? 42 :
  match("*cajon*",#eon_gn) ? 43 :
  match("*vibraslap*",#eon_gn)||match("*vibra slap*",#eon_gn) ? 44 :
  match("*whistle*",#eon_gn) ? 45 :
  match("*perc*",#eon_gn) ? 20 :
  match("*bass*",#eon_gn)||rk_icon_wordm("sub")||match("*reese*",#eon_gn) ? 21 :
  match("*synth*",#eon_gn)||rk_icon_wordm("arp")||match("*arpeggio*",#eon_gn)||match("*pluck*",#eon_gn)||match("*stab*",#eon_gn)||match("*chord*",#eon_gn)||rk_icon_wordm("saw")||match("*square*",#eon_gn)||match("*sine*",#eon_gn)||match("*supersaw*",#eon_gn)||match("*hoover*",#eon_gn) ? 22 :
  rk_icon_wordm("pad")||match("*pads*",#eon_gn)||match("*ambient*",#eon_gn)||match("*atmo*",#eon_gn)||match("*drone*",#eon_gn)||match("*texture*",#eon_gn)||match("*evolving*",#eon_gn)||match("*soundscape*",#eon_gn) ? 23 :
  match("*piano*",#eon_gn)||match("*keys*",#eon_gn)||match("*keyboard*",#eon_gn)||match("*organ*",#eon_gn)||match("*rhodes*",#eon_gn)||match("*wurli*",#eon_gn)||match("*epiano*",#eon_gn)||match("*e piano*",#eon_gn)||match("*clav*",#eon_gn)||match("*marimba*",#eon_gn)||match("*vibraphone*",#eon_gn)||match("*xylophone*",#eon_gn)||match("*glockenspiel*",#eon_gn)||match("*celesta*",#eon_gn)||match("*harp*",#eon_gn)||match("*mallet*",#eon_gn) ? 24 :
  match("*guitar*",#eon_gn)||rk_icon_wordm("gtr")||match("*guit*",#eon_gn)||match("*strat*",#eon_gn)||match("*tele*",#eon_gn)||match("*les paul*",#eon_gn)||match("*nylon*",#eon_gn)||match("*steel string*",#eon_gn)||match("*ukulele*",#eon_gn) ? 25 :
  // ⚠️ the Lua's "contrabass" is deliberately NOT here: the bass row above fires
  // first on its "*bass*", and the Lua reaches the same answer (contrabass ties
  // strings 2-2 and CATEGORY_ORDER puts bass first). Adding it would be dead code.
  match("*string*",#eon_gn)||match("*violin*",#eon_gn)||match("*viola*",#eon_gn)||match("*cello*",#eon_gn)||match("*orchestral*",#eon_gn)||match("*ensemble*",#eon_gn)||match("*chamber*",#eon_gn)||match("*pizzicato*",#eon_gn) ? 26 :
  match("*brass*",#eon_gn)||match("*trumpet*",#eon_gn)||match("*trombone*",#eon_gn)||match("*horn*",#eon_gn)||match("*tuba*",#eon_gn)||match("*flugelhorn*",#eon_gn)||match("*cornet*",#eon_gn) ? 27 :
  match("*vocal*",#eon_gn)||rk_icon_wordm("vox")||match("*voice*",#eon_gn)||match("*choir*",#eon_gn)||match("*acapella*",#eon_gn)||match("*a capella*",#eon_gn)||match("*singing*",#eon_gn)||match("*spoken*",#eon_gn)||match("*speech*",#eon_gn)||match("*adlib*",#eon_gn)||match("*chant*",#eon_gn) ? 28 :
  rk_icon_wordm("fx")||match("*sfx*",#eon_gn)||match("*effect*",#eon_gn)||match("*riser*",#eon_gn)||match("*impact*",#eon_gn)||match("*downlifter*",#eon_gn)||match("*uplifter*",#eon_gn)||match("*whoosh*",#eon_gn)||match("*sweep*",#eon_gn)||match("*noise*",#eon_gn)||match("*glitch*",#eon_gn)||match("*stutter*",#eon_gn)||match("*transition*",#eon_gn)||match("*reverse*",#eon_gn)||match("*buildup*",#eon_gn)||match("*build up*",#eon_gn)||match("*drop*",#eon_gn)||match("*explosion*",#eon_gn)||match("*boom*",#eon_gn)||match("*siren*",#eon_gn)||match("*alarm*",#eon_gn)||match("*foley*",#eon_gn)||match("*cinematic*",#eon_gn)||rk_icon_wordm("hit")||match("*one shot*",#eon_gn) ? 29 :
  match("*loop*",#eon_gn)||match("*break*",#eon_gn)||match("*breakbeat*",#eon_gn)||match("*drum loop*",#eon_gn)||match("*drumloop*",#eon_gn)||match("*top loop*",#eon_gn)||match("*toploop*",#eon_gn)||match("*groove*",#eon_gn)||match("*pattern*",#eon_gn)||match("*beat*",#eon_gn)||match("*construction*",#eon_gn) ? 30 :
  31;   // other
);
