desc:ReaKit Starter — GUI skeleton (grain / pitch / motion / reverb / delay)
author:EON Studios
version:1.1
about:
  A working ReaKit interface you can copy. Five sections, every widget family
  wired to a real parameter with automation-safe writes, plus a hand-drawn
  visualiser panel to show custom graphics living next to kit widgets.

  The DSP here is a deliberate passthrough with an output gain: this file is a
  GUI skeleton, not an effect. Replace @sample with your engine and keep the
  @gfx block.

  Everything here calls the SHIPPING ReaKit API — the *_kbsg draw/interact
  pairs. There is no framework layer: the chrome helpers at the top of @init
  are ordinary local functions, about 120 lines, and they are meant to be
  copied and changed rather than imported.

  Three controls are hand-rolled at the bottom of @init because ReaKit has no
  widget for them yet — they are marked GAP. See the header of each.

  Part of ReaKit, MIT licensed — see ReaKit/README.md for the guide.

// ── Grain ───────────────────────────────────────────────────────────────────
slider1:g_size=40<1,500,0.1>Grain Size (ms)
slider2:g_dens=12<0.5,80,0.1>Grain Density (Hz)
slider3:g_spray=15<0,100,0.1>Spray (%)
slider4:g_pos=50<0,100,0.1>Position (%)
slider5:g_dir=0<0,2,1{Forward,Reverse,Alternate}>Direction
// ── Pitch ───────────────────────────────────────────────────────────────────
slider6:p_semi=0<-24,24,1>Pitch (semitones)
slider7:p_fine=0<-100,100,0.1>Fine (cents)
slider8:p_mode=0<0,2,1{Repitch,Tuned,Stretch}>Pitch Mode
slider26:p_scale=0<0,6,1{Chromatic,Major,Minor,Dorian,Phrygian,Lydian,Mixolydian}>Scale
// ── Motion ──────────────────────────────────────────────────────────────────
slider9:m_x=0.5<0,1,0.001>Motion X
slider10:m_y=0.5<0,1,0.001>Motion Y
slider11:m_div=6<0,15,1>Motion Rate (division)
slider12:m_on=1<0,1,1>Motion On
// ── Grain envelope ──────────────────────────────────────────────────────────
slider13:e_a=20<0,500,0.1>Env Attack (ms)
slider14:e_d=180<0,2000,0.1>Env Decay (ms)
slider15:e_s=0.6<0,1,0.001>Env Sustain
slider16:e_r=300<0,2000,0.1>Env Release (ms)
// ── Reverb ──────────────────────────────────────────────────────────────────
slider17:r_size=0.45<0,1,0.001>Reverb Size
slider18:r_damp=0.35<0,1,0.001>Reverb Damping
slider19:r_mix=0.25<0,1,0.001>Reverb Mix
slider20:r_freeze=0<0,1,1>Reverb Freeze
// ── Delay ───────────────────────────────────────────────────────────────────
slider21:d_div=7<0,15,1>Delay Division
slider22:d_fb=0.35<0,0.95,0.001>Delay Feedback
slider23:d_mix=0.20<0,1,0.001>Delay Mix
slider24:d_ping=0<0,1,1>Ping-Pong
// ── Output ──────────────────────────────────────────────────────────────────
slider25:out_db=0<-24,12,0.1>Output (dB)

// One library set, one place. These four are the whole shipping widget API.
import knobs_kbsg.jsfx-inc
import buttons_kbsg.jsfx-inc
import sliders_kbsg.jsfx-inc
import meters_kbsg.jsfx-inc

@init

gfx_ext_retina = 1;

// ── Memory ──────────────────────────────────────────────────────────────────
// No allocator: JSFX gives you one flat array and `freemem` is just a cursor
// you push forward. Claim ONCE here — claiming in @gfx would hand out fresh
// addresses every frame and no control would remember it was mid-drag.
//
// Block sizes are the libraries' own conventions: 16 words per knob, 16 per
// slider, 8 per button.  ⚠️ If you also import vu_kbsg, start at 440 — that
// file writes to fixed addresses 0..437.
freemem = 0;

KNOB_W = 16;
BTN_W  = 8;

m_gsize  = freemem; freemem += KNOB_W;
m_gdens  = freemem; freemem += KNOB_W;
m_gspray = freemem; freemem += KNOB_W;
m_gpos   = freemem; freemem += KNOB_W;
m_psemi  = freemem; freemem += KNOB_W;
m_pfine  = freemem; freemem += KNOB_W;
m_ea     = freemem; freemem += KNOB_W;
m_ed     = freemem; freemem += KNOB_W;
m_es     = freemem; freemem += KNOB_W;
m_er     = freemem; freemem += KNOB_W;
m_rsize  = freemem; freemem += KNOB_W;
m_rdamp  = freemem; freemem += KNOB_W;
m_rmix   = freemem; freemem += KNOB_W;
m_dfb    = freemem; freemem += KNOB_W;
m_dmix   = freemem; freemem += KNOB_W;
m_out    = freemem; freemem += KNOB_W;

m_gdir   = freemem; freemem += BTN_W;
m_pmode  = freemem; freemem += BTN_W;
m_mon    = freemem; freemem += BTN_W;
m_rfrz   = freemem; freemem += BTN_W;
m_dping  = freemem; freemem += BTN_W;
m_mdiv   = freemem; freemem += BTN_W;
m_ddiv   = freemem; freemem += BTN_W;
m_style  = freemem; freemem += BTN_W;
m_xy     = freemem; freemem += BTN_W;

mtr_base = freemem; freemem += 1380; meter_init(mtr_base);

// Tempo divisions, in beats. Index 0 is free-running.
DIVN = 16;
divtab = freemem; freemem += DIVN;
divtab[0]  = 0;
divtab[1]  = 8;     divtab[2]  = 4;      divtab[3]  = 3;
divtab[4]  = 2;     divtab[5]  = 1.5;    divtab[6]  = 1;
divtab[7]  = 0.75;  divtab[8]  = 0.5;    divtab[9]  = 0.375;
divtab[10] = 0.25;  divtab[11] = 0.1875; divtab[12] = 0.125;
divtab[13] = 0.09375; divtab[14] = 0.0625; divtab[15] = 0.03125;

// The visualiser's own memory — a peak-envelope ring plus a fixed spray table,
// so grain markers sit still between frames instead of jittering.
HIST_N  = 480;  hist  = freemem; freemem += HIST_N;
SPRAY_N = 64;   spray = freemem; freemem += SPRAY_N;
_i = 0;
loop(SPRAY_N, spray[_i] = rand(2) - 1; _i += 1; );

hist_w = 0; hist_acc = 0; hist_cnt = 0;
meter_pk = 0;
knob_style = 1;   // 1 = SSL. The header stepper walks all 20 (see knobs_kbsg).
sc = 1;

// ── Palette ─────────────────────────────────────────────────────────────────
// Six colours, plain globals. Change them here and the whole panel follows —
// that is all a theme needs to be.
bg_r = 0.086; bg_g = 0.090; bg_b = 0.106;   // window
pn_r = 0.133; pn_g = 0.141; pn_b = 0.165;   // panel
ln_r = 0.239; ln_g = 0.251; ln_b = 0.290;   // borders and rules
tx_r = 0.839; tx_g = 0.855; tx_b = 0.886;   // text
ac_r = 0.290; ac_g = 0.624; ac_b = 1.000;   // accent
a2_r = 0.945; a2_g = 0.639; a2_b = 0.239;   // secondary accent

// ═══ CHROME — ordinary local functions, not a framework ═════════════════════
// ⚠️ EEL2 resolves names at PARSE time, so every one of these must be defined
// above the @gfx block that calls it. A call above its definition kills the
// whole file's compile.

function px(v) ( sc * v; );

function ui_font(size, bold) (
  gfx_setfont(1, "Arial", max(8, floor(size * sc + 0.5)), bold ? 'b' : 0);
);

function ui_col(r, g, b, a) ( gfx_set(r, g, b, a); );

function ui_text(x, y, s) ( gfx_x = x; gfx_y = y; gfx_drawstr(s); );

function ui_text_c(cx, y, s) local(tw, th) (
  gfx_measurestr(s, tw, th); gfx_x = cx - tw * 0.5; gfx_y = y; gfx_drawstr(s);
);

function ui_text_r(rx, y, s) local(tw, th) (
  gfx_measurestr(s, tw, th); gfx_x = rx - tw; gfx_y = y; gfx_drawstr(s);
);

function ui_rrect(x, y, w, h, r) local(d) (
  d = min(r, min(w, h) * 0.5);
  gfx_rect(x + d, y, w - d * 2, h);
  gfx_rect(x, y + d, w, h - d * 2);
  gfx_circle(x + d,         y + d,         d, 1, 1);
  gfx_circle(x + w - d - 1, y + d,         d, 1, 1);
  gfx_circle(x + d,         y + h - d - 1, d, 1, 1);
  gfx_circle(x + w - d - 1, y + h - d - 1, d, 1, 1);
);

function ui_panel(x, y, w, h, r) (
  gfx_set(pn_r, pn_g, pn_b, 1);
  ui_rrect(x, y, w, h, r);
  gfx_set(ln_r, ln_g, ln_b, 1);
  gfx_rect(x, y, w, 1); gfx_rect(x, y + h - 1, w, 1);
  gfx_rect(x, y, 1, h); gfx_rect(x + w - 1, y, 1, h);
);

// Draws the panel and its title, and returns the y where content starts.
function ui_section(x, y, w, h, title) (
  ui_panel(x, y, w, h, px(4));
  ui_font(9, 1);
  gfx_set(tx_r, tx_g, tx_b, 0.62);
  ui_text(x + px(10), y + px(7), title);
  gfx_set(ln_r, ln_g, ln_b, 1);
  gfx_rect(x + px(10), y + px(22), w - px(20), 1);
  y + px(26);
);

function ui_sep_h(x, y, w) (
  gfx_set(ln_r, ln_g, ln_b, 1); gfx_rect(x, y, w, 1);
);

// A value box: dark well, centred text. Used above every knob.
function ui_readout(cx, y, w, h, s) (
  gfx_set(0, 0, 0, 0.30);
  ui_rrect(cx - w * 0.5, y, w, h, px(2));
  ui_font(8, 0);
  gfx_set(ac_r, ac_g, ac_b, 0.95);
  ui_text_c(cx, y + px(2), s);
);

// Tooltips are collected during the frame and painted last, so a tip is never
// covered by a panel drawn after it.
function ui_tip(x, y, w, h, s) (
  mx >= x && mx < x + w && my >= y && my < y + h ? (
    strcpy(#tip, s); tip_x = mx; tip_y = my;
  );
);

function ui_tip_flush() local(tw, th, bw, bh, bx, by) (
  strlen(#tip) > 0 ? (
    ui_font(8, 0);
    gfx_measurestr(#tip, tw, th);
    bw = tw + px(10); bh = th + px(6);
    bx = min(tip_x + px(14), gfx_w - bw - px(4));
    by = min(tip_y + px(18), gfx_h - bh - px(4));
    gfx_set(0.04, 0.04, 0.06, 0.94);
    ui_rrect(bx, by, bw, bh, px(3));
    gfx_set(ln_r, ln_g, ln_b, 1);
    gfx_rect(bx, by, bw, 1); gfx_rect(bx, by + bh - 1, bw, 1);
    gfx_rect(bx, by, 1, bh); gfx_rect(bx + bw - 1, by, 1, bh);
    gfx_set(tx_r, tx_g, tx_b, 1);
    ui_text(bx + px(5), by + px(3), #tip);
  );
);

function ui_db(x) ( x > 0.0000001 ? 20 * log10(x) : -100; );

function div_beats(d) ( divtab[max(0, min(floor(d + 0.5), DIVN - 1))]; );

function div_seconds(d) local(b) (
  b = div_beats(d);
  b <= 0 ? 0 : b * 60 / max(ui_tempo, 20);
);

function div_hz(d) local(s) ( s = div_seconds(d); s <= 0 ? 0 : 1 / s; );

function div_name(d, dst) local(i) (
  i = max(0, min(floor(d + 0.5), DIVN - 1));
  i == 0 ? strcpy(dst, "FREE") :
  i == 1 ? strcpy(dst, "2 BAR") : i == 2 ? strcpy(dst, "1 BAR") :
  i == 3 ? strcpy(dst, "1/2.")  : i == 4 ? strcpy(dst, "1/2")   :
  i == 5 ? strcpy(dst, "1/4.")  : i == 6 ? strcpy(dst, "1/4")   :
  i == 7 ? strcpy(dst, "1/8.")  : i == 8 ? strcpy(dst, "1/8")   :
  i == 9 ? strcpy(dst, "1/8T")  : i == 10 ? strcpy(dst, "1/16") :
  i == 11 ? strcpy(dst, "1/16.") : i == 12 ? strcpy(dst, "1/32") :
  i == 13 ? strcpy(dst, "1/32T") : i == 14 ? strcpy(dst, "1/64") :
            strcpy(dst, "1/128");
  dst;
);

// ── The function worth copying ──────────────────────────────────────────────
// One call = interact + draw + readout + label + tooltip, so every knob in the
// plugin gets the same behaviour and the caller is left with the one line that
// matters: compare, assign, automate.
//
// Both the arc and the readout are drawn from `cur` — the value as it stands
// coming INTO the frame — never from the freshly-interacted `nv`. Drawing the
// arc from nv while the caller's text still says cur would let the pointer and
// the number disagree mid-drag, which reads as a bug. They commit together on
// the next frame instead.
function ui_knob(mem, cx, cy, rad, cur, vmin, vmax, vdef, ndet, sym, label, txt)
local(nv) (
  nv = rk_knob_interact(knob_style, mem, cx, cy, rad, cur, vmin, vmax, vdef, ndet);
  rk_knob_draw(knob_style, cx, cy, rad, cur, vmin, vmax, sym, mem[0],
               ac_r, ac_g, ac_b, ndet, pn_r, pn_g, pn_b);
  ui_readout(cx, cy - rad - px(17), px(52), px(13), txt);
  ui_font(9, 1);
  gfx_set(tx_r, tx_g, tx_b, 0.90);
  ui_text_c(cx, cy + rad + px(5), label);
  ui_tip(cx - rad, cy - rad, rad * 2, rad * 2, label);
  nv;
);

// A whole segmented selector in one call: buttons_kbsg does the work, this
// just walks the labels. Returns the (possibly new) value.
function ui_segment3(mem, x, y, w, h, cur, l0, l1, l2) local(nv, sw, gap) (
  gap = px(3);
  sw = (w - gap * 2) / 3;
  nv = btn_segment_interact(mem, x, y, sw, h, 3, gap, cur);
  btn_segment_draw(x,                  y, sw, h, 0, nv, l0, mem[0], ac_r, ac_g, ac_b);
  btn_segment_draw(x + sw + gap,       y, sw, h, 1, nv, l1, mem[0], ac_r, ac_g, ac_b);
  btn_segment_draw(x + (sw + gap) * 2, y, sw, h, 2, nv, l2, mem[0], ac_r, ac_g, ac_b);
  nv;
);

// ═══ GAP 1 — XY PAD ═════════════════════════════════════════════════════════
// ReaKit has no XY pad. Two parameters on one grab is a common instrument
// control and there is nothing in knobs/sliders/buttons/meters that covers it,
// so it is written out here. Publishes through globals because EEL2 functions
// return one value; returns 1 on the frames it moved.
function ui_xy(mem, x, y, w, h, vx, vy) local(hit, nx, ny, cx, cy, i) (
  hit = mx >= x && mx < x + w && my >= y && my < y + h;
  ui_xy_vx = vx; ui_xy_vy = vy; ui_xy_moved = 0;

  hit && lmb_down ? mem[1] = 1;
  !LMB ? mem[1] = 0;

  mem[1] ? (
    nx = min(max((mx - x) / max(w, 1), 0), 1);
    ny = 1 - min(max((my - y) / max(h, 1), 0), 1);
    CTRL ? ( nx = vx + (nx - vx) * 0.15; ny = vy + (ny - vy) * 0.15; );
    nx != vx || ny != vy ? ( ui_xy_vx = nx; ui_xy_vy = ny; ui_xy_moved = 1; );
  );

  gfx_set(0, 0, 0, 0.34);
  ui_rrect(x, y, w, h, px(3));
  gfx_set(ln_r, ln_g, ln_b, hit || mem[1] ? 1 : 0.6);
  gfx_rect(x, y, w, 1); gfx_rect(x, y + h - 1, w, 1);
  gfx_rect(x, y, 1, h); gfx_rect(x + w - 1, y, 1, h);

  gfx_set(ln_r, ln_g, ln_b, 0.45);
  i = 1;
  loop(3,
    gfx_rect(x + w * i * 0.25, y + px(3), 1, h - px(6));
    gfx_rect(x + px(3), y + h * i * 0.25, w - px(6), 1);
    i += 1;
  );

  cx = x + ui_xy_vx * w;
  cy = y + (1 - ui_xy_vy) * h;
  gfx_set(ac_r, ac_g, ac_b, 0.30);
  gfx_rect(cx, y, 1, h); gfx_rect(x, cy, w, 1);
  gfx_set(ac_r, ac_g, ac_b, 1);
  gfx_circle(cx, cy, px(mem[1] ? 6 : 4), 1, 1);
  gfx_set(1, 1, 1, 0.85);
  gfx_circle(cx, cy, px(2), 1, 1);

  ui_xy_moved;
);

// ═══ GAP 2 — ADSR DISPLAY ═══════════════════════════════════════════════════
// ReaKit has no envelope editor either. This one only DRAWS — the four knobs
// beside it are the control surface, which keeps it honest about what ships.
// Making the corners draggable is the obvious next widget.
function ui_env_draw(x, y, w, h, a, d, s, r, amax, dmax, rmax)
local(ax, dx, rx, sy, total) (
  gfx_set(0, 0, 0, 0.34);
  ui_rrect(x, y, w, h, px(3));
  gfx_set(ln_r, ln_g, ln_b, 0.6);
  gfx_rect(x, y, w, 1); gfx_rect(x, y + h - 1, w, 1);
  gfx_rect(x, y, 1, h); gfx_rect(x + w - 1, y, 1, h);

  total = max(amax + dmax + rmax, 1);
  ax = w * (a / total);
  dx = w * (d / total);
  rx = w * (r / total);
  // whatever is left between decay and release is the sustain plateau
  sy = y + h - h * min(max(s, 0), 1);

  gfx_set(ac_r, ac_g, ac_b, 1);
  gfx_line(x,                y + h, x + ax,                y,     1);
  gfx_line(x + ax,           y,     x + ax + dx,           sy,    1);
  gfx_line(x + ax + dx,      sy,    x + w - rx,            sy,    1);
  gfx_line(x + w - rx,       sy,    x + w,                 y + h, 1);

  gfx_set(ac_r, ac_g, ac_b, 0.85);
  gfx_circle(x + ax,      y,  px(2.5), 1, 1);
  gfx_circle(x + ax + dx, sy, px(2.5), 1, 1);
  gfx_circle(x + w - rx,  sy, px(2.5), 1, 1);
);

// ═══ GAP 3 — DROPDOWN ═══════════════════════════════════════════════════════
// ReaKit has segmented bars and radio groups, which are right for three
// options and useless for eleven. There is no dropdown, so this leans on
// JSFX's own gfx_showmenu — which is genuinely the right answer for a long
// list, and is why the widget may never need to exist.
function ui_dropdown(x, y, w, h, cur, label, menu) local(hit, res, tw, th) (
  hit = mx >= x && mx < x + w && my >= y && my < y + h;
  ui_dd_val = cur;

  gfx_set(0, 0, 0, 0.30);
  ui_rrect(x, y, w, h, px(3));
  gfx_set(ln_r, ln_g, ln_b, hit ? 1 : 0.6);
  gfx_rect(x, y, w, 1); gfx_rect(x, y + h - 1, w, 1);
  gfx_rect(x, y, 1, h); gfx_rect(x + w - 1, y, 1, h);

  ui_font(8, 0);
  gfx_set(tx_r, tx_g, tx_b, hit ? 1 : 0.85);
  ui_text(x + px(6), y + px(3), label);
  gfx_set(tx_r, tx_g, tx_b, 0.7);
  gfx_triangle(x + w - px(13), y + h * 0.42,
               x + w - px(5),  y + h * 0.42,
               x + w - px(9),  y + h * 0.66);

  hit && lmb_down ? (
    gfx_x = x; gfx_y = y + h;
    res = gfx_showmenu(menu);
    res > 0 ? ui_dd_val = res - 1;
  );
  ui_dd_val;
);

function scale_name(i, dst) (
  i == 0 ? strcpy(dst, "Chromatic") : i == 1 ? strcpy(dst, "Major") :
  i == 2 ? strcpy(dst, "Minor")     : i == 3 ? strcpy(dst, "Dorian") :
  i == 4 ? strcpy(dst, "Phrygian")  : i == 5 ? strcpy(dst, "Lydian") :
           strcpy(dst, "Mixolydian");
  dst;
);

@slider

out_lin = 10 ^ (out_db / 20);

@block

// Sync values follow the host tempo, so they are resolved per block, not per
// frame: the UI reads what the engine will actually use.
ui_tempo = tempo > 0 ? tempo : 120;
m_hz     = div_hz(m_div);
d_secs   = div_seconds(d_div);

@sample

// Passthrough + output gain. Your engine goes here.
spl0 *= out_lin;
spl1 *= out_lin;

meter_process_sample(spl0, spl1);

// Decimated peak envelope for the visualiser.
_pk = max(abs(spl0), abs(spl1));
meter_pk = max(meter_pk * 0.9999, _pk);
hist_acc = max(hist_acc, _pk);
hist_cnt += 1;
hist_cnt >= (srate / 120) ? (
  hist[hist_w] = hist_acc;
  hist_w = (hist_w + 1) % HIST_N;
  hist_acc = 0;
  hist_cnt = 0;
);

@gfx 720 560

// ── The whole per-frame preamble ────────────────────────────────────────────
// These globals are what every *_kbsg widget reads. Set them once, at the top,
// and drag / ctrl-for-fine / wheel / double-click-to-reset work everywhere.
DW = 720; DH = 560;
sc = min(gfx_w / DW, gfx_h / DH);
sc < 0.35 ? sc = 0.35;

mx = mouse_x; my = mouse_y;
LMB = mouse_cap & 1; lmb_down = LMB && !_pLMB; _pLMB = LMB;
CTRL = mouse_cap & 4; SHIFT = mouse_cap & 8;
dt = time_precise() - _lt; _lt = time_precise();
hv_speed = 11; tau = 2 * $pi;
frame_wheel = mouse_wheel / 120; mouse_wheel = 0;

strcpy(#tip, "");

gfx_clear = -1;
gfx_set(bg_r, bg_g, bg_b, 1);
gfx_rect(0, 0, gfx_w, gfx_h);

W = DW * sc; H = DH * sc;

// ── Header ──────────────────────────────────────────────────────────────────
ui_font(17, 1);
gfx_set(tx_r, tx_g, tx_b, 1);
ui_text(px(16), px(11), "ReaKit Starter");
ui_font(9, 0);
gfx_set(tx_r, tx_g, tx_b, 0.55);
ui_text(px(128), px(17), "GUI SKELETON");

// Knob-style stepper — 20 console looks, one shared feel. Step it and every
// knob on the panel changes together; the interaction never does.
_sx = W - px(96); _sy = px(12); _sw = px(80); _sh = px(18);
_d = btn_incdec_interact(m_style, _sx, _sy, _sw, _sh);
_d != 0 ? knob_style = max(1, min(knob_style + _d, 20));
sprintf(#s, "KNOB %d", knob_style);
btn_incdec_draw(_sx, _sy, _sw, _sh, #s, m_style[0]);
ui_tip(_sx, _sy, _sw, _sh, "Knob style — 20 looks, identical feel");

ui_sep_h(px(14), px(38), W - px(28));

// ── Layout grid ─────────────────────────────────────────────────────────────
col_w = (W - px(42)) * 0.5;
col_l = px(14);
col_r = col_l + col_w + px(14);
row_y = px(48);
sec_h1 = px(134);
sec_h2 = px(132);
sec_h3 = px(112);
kr = px(19);

// ═══ GRAIN ══════════════════════════════════════════════════════════════════
cy = ui_section(col_l, row_y, col_w, sec_h1, "GRAIN");
kx = col_l + col_w * 0.16;
ky = cy + px(37);
kp = col_w * 0.225;

sprintf(#s, "%.0f ms", g_size);
_nv = ui_knob(m_gsize, kx, ky, kr, g_size, 1, 500, 40, 0, 0, "SIZE", #s);
_nv != g_size ? ( g_size = _nv; slider_automate(g_size); );

sprintf(#s, "%.1f Hz", g_dens);
_nv = ui_knob(m_gdens, kx + kp, ky, kr, g_dens, 0.5, 80, 12, 0, 0, "DENSITY", #s);
_nv != g_dens ? ( g_dens = _nv; slider_automate(g_dens); );

sprintf(#s, "%.0f %%", g_spray);
_nv = ui_knob(m_gspray, kx + kp * 2, ky, kr, g_spray, 0, 100, 15, 0, 0, "SPRAY", #s);
_nv != g_spray ? ( g_spray = _nv; slider_automate(g_spray); );

sprintf(#s, "%.0f %%", g_pos);
_nv = ui_knob(m_gpos, kx + kp * 3, ky, kr, g_pos, 0, 100, 50, 0, 0, "POSITION", #s);
_nv != g_pos ? ( g_pos = _nv; slider_automate(g_pos); );

_sy = row_y + sec_h1 - px(26);
_nv = ui_segment3(m_gdir, col_l + px(10), _sy, col_w - px(20), px(18), g_dir,
                  "FORWARD", "REVERSE", "ALTERNATE");
_nv != g_dir ? ( g_dir = _nv; slider_automate(g_dir); );

// ═══ PITCH ══════════════════════════════════════════════════════════════════
cy = ui_section(col_r, row_y, col_w, sec_h1, "PITCH");
kx = col_r + col_w * 0.22;
ky = cy + px(37);

// Detented knob: 49 stops across -24..+24 makes every semitone a click.
sprintf(#s, "%+d st", p_semi);
_nv = ui_knob(m_psemi, kx, ky, kr, p_semi, -24, 24, 0, 49, 1, "SEMITONES", #s);
_nv != p_semi ? ( p_semi = floor(_nv + 0.5); slider_automate(p_semi); );

sprintf(#s, "%+.0f ct", p_fine);
_nv = ui_knob(m_pfine, kx + col_w * 0.30, ky, kr, p_fine, -100, 100, 0, 0, 1, "FINE", #s);
_nv != p_fine ? ( p_fine = _nv; slider_automate(p_fine); );

// The scale dropdown paints its own popup, so it is drawn here but the menu
// only opens on click — gfx_showmenu is modal, so no overlay ordering needed.
sc_w = px(84); sc_h = px(18);
sc_x = col_r + col_w - sc_w - px(10);
sc_y = cy + px(2);
ui_font(8, 0);
gfx_set(tx_r, tx_g, tx_b, 0.75);
ui_text_r(sc_x - px(5), sc_y + px(4), "SCALE");
scale_name(p_scale, #s);
_nv = ui_dropdown(sc_x, sc_y, sc_w, sc_h, p_scale, #s,
      "Chromatic|Major|Minor|Dorian|Phrygian|Lydian|Mixolydian");
_nv != p_scale ? ( p_scale = _nv; slider_automate(p_scale); );

_nv = ui_segment3(m_pmode, col_r + px(10), _sy, col_w - px(20), px(18), p_mode,
                  "REPITCH", "TUNED", "STRETCH");
_nv != p_mode ? ( p_mode = _nv; slider_automate(p_mode); );

// ═══ MOTION ═════════════════════════════════════════════════════════════════
row_y = row_y + sec_h1 + px(10);
cy = ui_section(col_l, row_y, col_w, sec_h2, "MOTION");

pad_s = min(col_w * 0.52, sec_h2 - px(46));
pad_x = col_l + px(12);
pad_y = cy + px(4);

// Two parameters, one grab — both written and automated together.
ui_xy(m_xy, pad_x, pad_y, pad_s, pad_s, m_x, m_y) ? (
  m_x = ui_xy_vx; slider_automate(m_x);
  m_y = ui_xy_vy; slider_automate(m_y);
);
ui_tip(pad_x, pad_y, pad_s, pad_s, "Motion path — drag; CTRL for fine");

_rx = pad_x + pad_s + px(14);
_rw = col_l + col_w - _rx - px(12);

ui_font(9, 1);
gfx_set(tx_r, tx_g, tx_b, 0.90);
ui_text(_rx, pad_y + px(2), "RATE");
_d = btn_incdec_interact(m_mdiv, _rx, pad_y + px(14), _rw, px(20));
_d != 0 ? (
  m_div = max(0, min(m_div + _d, DIVN - 1));
  slider_automate(m_div);
);
div_name(m_div, #s);
btn_incdec_draw(_rx, pad_y + px(14), _rw, px(20), #s, m_mdiv[0]);
ui_tip(_rx, pad_y + px(14), _rw, px(20), "Tempo-synced rate");

_nv = btn_led_interact(m_mon, _rx + px(12), pad_y + px(52), px(7), m_on);
btn_led_draw(_rx + px(12), pad_y + px(52), px(7), _nv, "RUN", m_mon[0],
             a2_r, a2_g, a2_b, 0);
_nv != m_on ? ( m_on = _nv; slider_automate(m_on); );

// The resolved rate, in the units a musician checks against.
m_div < 1 ? strcpy(#s, "FREE") : sprintf(#s, "%.2f Hz", div_hz(m_div));
ui_readout(_rx + _rw * 0.5, pad_y + px(72), _rw, px(15), #s);
ui_font(8, 0);
gfx_set(tx_r, tx_g, tx_b, 0.6);
ui_text_c(_rx + _rw * 0.5, pad_y + px(90), "AT HOST TEMPO");

// ═══ ENVELOPE ═══════════════════════════════════════════════════════════════
cy = ui_section(col_r, row_y, col_w, sec_h2, "GRAIN ENVELOPE");
env_x = col_r + px(12);
env_w = col_w - px(24);
env_h = sec_h2 - px(76);

ui_env_draw(env_x, cy + px(2), env_w, env_h, e_a, e_d, e_s, e_r, 500, 2000, 2000);
ui_tip(env_x, cy + px(2), env_w, env_h, "Shape follows the four knobs below");

ky = cy + env_h + px(22);
kp = env_w * 0.26;
kx = env_x + px(14);
kr2 = px(14);

sprintf(#s, "%.0f", e_a);
_nv = ui_knob(m_ea, kx, ky, kr2, e_a, 0, 500, 20, 0, 0, "A", #s);
_nv != e_a ? ( e_a = _nv; slider_automate(e_a); );

sprintf(#s, "%.0f", e_d);
_nv = ui_knob(m_ed, kx + kp, ky, kr2, e_d, 0, 2000, 180, 0, 0, "D", #s);
_nv != e_d ? ( e_d = _nv; slider_automate(e_d); );

sprintf(#s, "%.2f", e_s);
_nv = ui_knob(m_es, kx + kp * 2, ky, kr2, e_s, 0, 1, 0.6, 0, 0, "S", #s);
_nv != e_s ? ( e_s = _nv; slider_automate(e_s); );

sprintf(#s, "%.0f", e_r);
_nv = ui_knob(m_er, kx + kp * 3, ky, kr2, e_r, 0, 2000, 300, 0, 0, "R", #s);
_nv != e_r ? ( e_r = _nv; slider_automate(e_r); );

// ═══ REVERB ═════════════════════════════════════════════════════════════════
row_y = row_y + sec_h2 + px(10);
cy = ui_section(col_l, row_y, col_w, sec_h3, "REVERB");
kx = col_l + col_w * 0.17;
ky = cy + px(37);
kp = col_w * 0.22;

sprintf(#s, "%.0f %%", r_size * 100);
_nv = ui_knob(m_rsize, kx, ky, kr, r_size, 0, 1, 0.45, 0, 0, "SIZE", #s);
_nv != r_size ? ( r_size = _nv; slider_automate(r_size); );

sprintf(#s, "%.0f %%", r_damp * 100);
_nv = ui_knob(m_rdamp, kx + kp, ky, kr, r_damp, 0, 1, 0.35, 0, 0, "DAMP", #s);
_nv != r_damp ? ( r_damp = _nv; slider_automate(r_damp); );

sprintf(#s, "%.0f %%", r_mix * 100);
_nv = ui_knob(m_rmix, kx + kp * 2, ky, kr, r_mix, 0, 1, 0.25, 0, 0, "MIX", #s);
_nv != r_mix ? ( r_mix = _nv; slider_automate(r_mix); );

_fx = col_l + col_w - px(70);
_nv = btn_led_interact(m_rfrz, _fx, ky, px(7), r_freeze);
btn_led_draw(_fx, ky, px(7), _nv, "FREEZE", m_rfrz[0], a2_r, a2_g, a2_b, 0);
_nv != r_freeze ? ( r_freeze = _nv; slider_automate(r_freeze); );

// ═══ DELAY ══════════════════════════════════════════════════════════════════
cy = ui_section(col_r, row_y, col_w, sec_h3, "DELAY");
kx = col_r + col_w * 0.19;
ky = cy + px(37);

sprintf(#s, "%.0f %%", d_fb * 100);
_nv = ui_knob(m_dfb, kx, ky, kr, d_fb, 0, 0.95, 0.35, 0, 0, "FEEDBACK", #s);
_nv != d_fb ? ( d_fb = _nv; slider_automate(d_fb); );

sprintf(#s, "%.0f %%", d_mix * 100);
_nv = ui_knob(m_dmix, kx + col_w * 0.22, ky, kr, d_mix, 0, 1, 0.20, 0, 0, "MIX", #s);
_nv != d_mix ? ( d_mix = _nv; slider_automate(d_mix); );

_dx = col_r + col_w * 0.52;
_dw = col_w * 0.40;
_d = btn_incdec_interact(m_ddiv, _dx, ky - px(20), _dw, px(20));
_d != 0 ? ( d_div = max(0, min(d_div + _d, DIVN - 1)); slider_automate(d_div); );
div_name(d_div, #s);
btn_incdec_draw(_dx, ky - px(20), _dw, px(20), #s, m_ddiv[0]);

d_div < 1 ? strcpy(#s, "FREE") : sprintf(#s, "%.0f ms", div_seconds(d_div) * 1000);
ui_readout(_dx + _dw * 0.5, ky + px(4), _dw, px(14), #s);

_nv = btn_checkbox_interact(m_dping, _dx, ky + px(24), px(13), px(70), d_ping);
btn_checkbox_draw(_dx, ky + px(24), px(13), _nv, "PING-PONG", m_dping[0],
                  ac_r, ac_g, ac_b);
_nv != d_ping ? ( d_ping = _nv; slider_automate(d_ping); );

// ═══ VISUALISER + OUTPUT ════════════════════════════════════════════════════
// The part ReaKit deliberately does NOT own. Your instrument's own graphics
// live here, drawn straight to gfx_* against the same palette, sharing the
// frame's mouse state. Nothing above knows or cares what this panel draws.
row_y = row_y + sec_h3 + px(10);
viz_h = H - row_y - px(14);
viz_w = W - px(28) - px(44);
viz_x = px(14);

ui_panel(viz_x, row_y, viz_w, viz_h, px(4));

_ix = viz_x + 2; _iy = row_y + 2;
_iw = viz_w - 4; _ih = viz_h - 4;
gfx_set(0, 0, 0, 0.35);
gfx_rect(_ix, _iy, _iw, _ih);

// Peak envelope, oldest at the left.
i = 0;
loop(HIST_N,
  _v = hist[(hist_w + i) % HIST_N];
  _bx = _ix + i / HIST_N * _iw;
  _bh = min(_ih * 0.5, _v * _ih * 0.5);
  gfx_set(ac_r, ac_g, ac_b, 0.55);
  gfx_rect(_bx, _iy + _ih * 0.5 - _bh, max(1, _iw / HIST_N), _bh * 2);
  i += 1;
);

// Grain markers: density sets the spacing, spray the scatter, position the
// playhead. Reading the parameters, not the audio — which is the point: the
// custom view stays in step with the kit's controls for free.
_gn = min(48, max(2, floor(g_dens)));
i = 0;
loop(_gn,
  _t = i / _gn + spray[i % SPRAY_N] * g_spray * 0.0008;
  _t = _t - floor(_t);
  _gx = _ix + _t * _iw;
  gfx_set(1, 1, 1, 0.16);
  gfx_rect(_gx, _iy + _ih * 0.5 - px(5), 1, px(10));
  i += 1;
);
_pxx = _ix + g_pos * 0.01 * _iw;
gfx_set(a2_r, a2_g, a2_b, 0.9);
gfx_rect(_pxx, _iy, 1, _ih);
gfx_circle(_pxx, _iy + px(4), px(3), 1, 1);

ui_font(8, 0);
gfx_set(tx_r, tx_g, tx_b, 0.55);
ui_text(_ix + px(6), _iy + px(4), "YOUR VISUALISATION — plain gfx_*, same palette");

// Output: knob + the library's LED bar meter, the only place this touches audio.
_ox = W - px(40);
sprintf(#s, "%+.1f", out_db);
_nv = ui_knob(m_out, _ox + px(13), row_y + px(20), px(13), out_db, -24, 12, 0, 0, 1, "OUT", #s);
_nv != out_db ? ( out_db = _nv; slider_automate(out_db); out_lin = 10 ^ (out_db / 20); );

mtr_led_bar_draw(_ox, row_y + px(42), px(26), viz_h - px(44),
                 ui_db(mtr_peak_l), ui_db(mtr_peak_r), -48, 6);
ui_tip(_ox, row_y, px(26), viz_h, "Output — knob sets gain, meter is meters_kbsg");

// Tooltips last, over everything.
ui_tip_flush();
