_n2 != _n ? ( slider69 = 0 + _n2 * (100 - 0); slider_automate(slider69); );
sld_vpt_draw(ox+sc*460, sc*205, sc*48, sc*170, _n2, sm);

// MPC (vslider)
sm = sldmem + 14*16;
_n = (slider70 - -100) / max(0.000001, 100 - -100);
sld_set_accent(0.17,0.73,1.00);
_n2 = sld_vbipolar_interact(sm, ox+sc*545, sc*205, sc*48, sc*170, _n);
_n2 != _n ? ( slider70 = -100 + _n2 * (100 - -100); slider_automate(slider70); );
sld_vmpc_draw(ox+sc*545, sc*205, sc*48, sc*170, _n2, sm);

