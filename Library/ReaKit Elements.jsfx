desc:ReaKit Elements
options:gfx_hz=60 no_meter want_all_kb
// @description ReaKit - UI widget library for JSFX (knobs, faders, buttons, meters, VU, pads, piano)
// @author Quaz (EON Studios)
// @version 1.5.2
// @changelog
//   New: ReaKit Starter - a working GUI skeleton to copy from. Installing this
//   package now also drops a second JSFX alongside this showcase. Where
//   Elements shows you every widget, Starter shows you a finished plugin face:
//   grain / pitch / motion / envelope / reverb / delay / output, every control
//   bound to a real automatable parameter, native sliders hidden so what you
//   see is the GUI. Its layout chrome is ~120 lines of ordinary local
//   functions, deliberately not a framework - copy them and change them.
//   Library incs are unchanged.
// @about
//   19 procedural knob styles, 17 slider/fader types, 10 button styles,
//   12 meter styles with DSP included, an analog VU with 11 face themes,
//   a drum pad grid and a piano keyboard (horizontal or vertical).
//   No bitmaps - everything is drawn in code and scales to any size.
//   The showcase is organized into five category tabs (the tab bar itself is
//   the library's btn_tab widget), scales uniformly to fit its window (resize
//   the FX window and the whole UI follows) and renders at full resolution on
//   HiDPI/Retina.
//   This file is the all-elements showcase; the library itself lives in the
//   *_kbsg.jsfx-inc files installed alongside it. The rk_ui_*.jsfx-inc files
//   are compatibility aliases for .jsfx exported by Forge.
// @provides
//   ReaKit Starter.jsfx
//   [nomain] knobs_kbsg.jsfx-inc
//   [nomain] sliders_kbsg.jsfx-inc
//   [nomain] buttons_kbsg.jsfx-inc
//   [nomain] rk_vu.jsfx-inc
//   [nomain] meters_kbsg.jsfx-inc
//   [nomain] rk_padgrid.jsfx-inc
//   [nomain] rk_piano.jsfx-inc
//   [nomain] rk_ui_math.jsfx-inc
//   [nomain] rk_ui_core.jsfx-inc
//   [nomain] rk_ui_knob.jsfx-inc
//   [nomain] rk_ui_button.jsfx-inc
//   [nomain] rk_ui_slider.jsfx-inc
//   [nomain] rk_ui_meter.jsfx-inc
//   [nomain] rk_curve.jsfx-inc
//   [nomain] rk_popup.jsfx-inc
//   [nomain] rk_ink.jsfx-inc
//   [nomain] rk_tooltip.jsfx-inc
//   [nomain] rk_textfield.jsfx-inc
//   [nomain] rk_colorpick.jsfx-inc
//   [nomain] rk_adsr.jsfx-inc
tags: effect

// Requires the EON ReaKit *_kbsg.jsfx-inc libs on the JSFX import path
//   (knobs_kbsg must be the dispatcher build that defines rk_knob_draw).

// want_all_kb (the options line) is for the text field on the Buttons tab.
// Without it REAPER keeps SPACE for the transport and the field never sees
// it. It pre-ticks "Send all keyboard input to plug-in" on a fresh insert, so
// while this window has focus the keyboard is the plugin's — SPACE included.
// An instance saved before 1.5.3 keeps the setting it was saved with.

slider1:0<0,5,1{Knobs,Buttons,Sliders,Meters,Pads & Keys,Curve}>-Tab
slider3:60<0,100,0.01>-SSL
slider4:6<-24,24,0.01>-Vari-Mu
slider5:70<0,100,0.01>-API
slider6:55<0,100,0.01>-WS
slider7:40<0,100,0.01>-Neve
slider8:65<0,100,0.01>-Joanny
slider9:50<0,100,0.01>-MPC
slider10:35<0,100,0.01>-Jog
slider11:80<0,100,0.01>-Spice
slider12:50<0,100,0.01>-Encoder
slider13:40<0,100,0.01>-Pultec
slider14:65<0,100,0.01>-Ableton
slider15:55<0,100,0.01>-FL
slider16:45<0,100,0.01>-ProTools
slider17:60<0,100,0.01>-FabFilter
slider18:75<0,100,0.01>-Serum
slider19:35<0,100,0.01>-Roland
slider20:55<0,100,0.01>-PultecCr
slider21:62<0,100,0.01>-NeveAlt
slider23:1<0,1,1{Off,On}>-Bypass
slider24:1<0,1,1{Off,On}>-EQ
slider25:1<0,1,1{Off,On}>-Link
slider26:1<0,1,1{Off,On}>-On
slider27:1<0,1,1{Off,On}>-Mode
slider28:1<0,1,1{Off,On}>-Pwr
slider29:1<0,1,1{Off,On}>-Stomp
slider30:1<0,2,1{0: 6,1: 12,2: 24}>-Slope
slider31:0<0,2,1{0: Amp,1: EQ,2: Mod}>-Page
slider32:1<0,2,1{0: Clean,1: Warm,2: Tube}>-Type
slider34:65<0,100,0.01>-Std
slider35:72<0,100,0.01>-Fill
slider36:50<0,100,0.01>-Step
slider37:30<-100,100,0.01>-Bipolar
slider38:60<0,100,0.01>-Mini
slider39:70<0,100,0.01>-Arc
slider41:70<0,100,0.01>-V
slider42:78<0,100,0.01>-LED
slider43:55<0,100,0.01>-Groove
slider44:35<-100,100,0.01>-SSL
slider45:60<-100,100,0.01>-Neve
slider46:40<-100,100,0.01>-API
slider47:72<-100,100,0.01>-Tube
slider69:74<0,100,0.01>-PT
slider70:0<-100,100,0.01>-MPC
slider71:66<0,100,0.01>-4K
slider73:5<0,15,1>-Pads
slider74:60<0,127,1>-Keys
slider75:55<0,127,1>-KeysV

import knobs_kbsg.jsfx-inc
import buttons_kbsg.jsfx-inc
import sliders_kbsg.jsfx-inc
import rk_vu.jsfx-inc
import meters_kbsg.jsfx-inc
import rk_padgrid.jsfx-inc
import rk_piano.jsfx-inc
import rk_curve.jsfx-inc
import rk_popup.jsfx-inc
import rk_ink.jsfx-inc
import rk_tooltip.jsfx-inc
import rk_textfield.jsfx-inc
import rk_colorpick.jsfx-inc
import rk_adsr.jsfx-inc

@init
// ⭐ ext_noinit: @init runs once, at load. Without it REAPER re-runs @init
// whenever playback starts, and a file with no @serialize has every variable
// and all of its memory zeroed first — so pressing play put the typed text,
// the colour, the envelope, the curve nodes, the threshold and the VU face
// back to their seeds. SPACE is play, which is how "type, press space, the
// text went away" looked from outside. ext_noinit also stops a samplerate
// change re-running @init, so everything that derives from srate is in
// el_rate_init() below, which @block calls again when the rate moves.
ext_noinit = 1.0;
gfx_ext_retina = 1;   // HiDPI/Retina: REAPER doubles the surface, sc math below follows
freemem = 0;      // rk_vu claims no memory
KS = 16;
km = freemem; freemem += 19 * KS;   // 16 words/knob
btnmem = freemem; freemem += 11 * 8;   // 8 words/button-family (10 demo styles + nav tab bar)
sldmem = freemem; freemem += 16 * 16;  // 16 words/slider
pgdmem_0 = freemem; freemem += 17;     // pad grid: 16 hover ramps + the held pad
WF_LEN = 256;
wf_0 = freemem; freemem += WF_LEN; wfp_0 = 0;
mtr_base = freemem; freemem += 1380;   // meters_kbsg DSP state

// The meters' coefficients and the VU's ballistics, which are all srate.
function el_rate_init() (
  meter_init(mtr_base);
  mtr_en_rms = 1;   // enable (set after meter_init resets flags)
  mtr_en_gonio = 1;
  mtr_en_phase = 1;
  mtr_en_wave = 1;
  mtr_en_spectrum = 1;
  mtr_en_lufs = 1;
  vu_0.rk_vu_init(-18);   // analog VU: 300 ms movement, 0 VU = a -18 dBFS sine
  el_srate = srate;
);
el_rate_init();
_vu_face = 0;           // face 0..19 (Cream); click the meter's coil cover to pick another

// CURVE tab. The graph spans the audio band; it does NOT have to match the
// meter's. rk_curve_analyser is handed the bands' own span and places them by
// frequency, so the two agree however either one is configured — which is what
// "by construction" is supposed to mean, and what matching two hand-written
// numbers never was.
rk_curve_init(20, 20000);
// The narrowest bell, in octaves. cvw is the width of a Gaussian in log
// frequency, and its half-gain width is 1.665 x cvw, so 0.05 is about Q 17 —
// past the 4-band EQ's Q 10. The floor used to be 0.2, which is about Q 4,
// while the fill loop's own guard already said 0.05; both read this now.
CV_WMIN = 0.05;
// 512 points, rk_curve's own recommendation. A narrow bell needs them: at 256
// a bell at the floor could fall between two points and draw its peak 2 dB
// below its own node.
CV_PTS = 512;
cvbuf  = freemem; freemem += CV_PTS;
cvspec = freemem; freemem += 16;
cvf    = freemem; freemem += 4;   cvf[0] = 80; cvf[1] = 400; cvf[2] = 2000; cvf[3] = 8000;
cvd    = freemem; freemem += 4;   cvd[0] = 4;  cvd[1] = -3;  cvd[2] = 5;    cvd[3] = -2;
cvw    = freemem; freemem += 4;   cvw[0] = 1.1; cvw[1] = 1.1; cvw[2] = 1.1; cvw[3] = 1.1;
cvnm   = freemem; freemem += 8 + 4;  cvnm[0] = -1;
cv_hash = -1;
thrmem = freemem; freemem += 8;   // threshold line: hover ramp + drag latch
thr_db = -18;                     // the draggable threshold, in dB
tfmem = freemem; freemem += RKTF_MEM;   // the text field
strcpy(#el_text, "type here");
cpmem = freemem; freemem += RKCP_MEM;   // the colour picker
el_hue = 0.58;                          // its value: -2 black, -1 white, 0..1 hue
admem = freemem; freemem += RKAD_MEM;   // the envelope editor
admem[0] = -1;
ppmem = freemem; freemem += RKPP_MEM;   // the envelope presets' dropdown

// The envelope presets, keyed by the menu row that picks them: 1-based, as
// rk_popup_run returns it. Row 1 is the menu's header and row 6 its separator,
// so neither comes back; anything that is not a preset is the default.
function el_env_preset(k) (
  el_pre = k >= 2 && k <= 5 ? k : 7;    // the row the menu ticks
  el_pre == 2 ? ( el_a = 1;   el_d = 160;  el_s = 0;    el_r = 90;   ) :   // Pluck
  el_pre == 3 ? ( el_a = 4;   el_d = 700;  el_s = 0.35; el_r = 400;  ) :   // Keys
  el_pre == 4 ? ( el_a = 450; el_d = 1200; el_s = 0.75; el_r = 1800; ) :   // Pad
  el_pre == 5 ? ( el_a = 900; el_d = 400;  el_s = 1;    el_r = 3000; ) :   // Swell
                ( el_a = 12;  el_d = 180;  el_s = 0.6;  el_r = 300;  );    // Default
);
function el_pre_name(k) (
  k == 2 ? "Pluck" : k == 3 ? "Keys" : k == 4 ? "Pad" : k == 5 ? "Swell" :
  k == 7 ? "Default" : "Custom";
);
el_env_preset(7);   // ms, ms, 0..1, ms

@slider

@block
// A samplerate change no longer re-runs @init (ext_noinit), so the meters' and
// the VU's rate-derived state is refreshed here. Also catches a load that
// handed @init an srate of 0.
srate != el_srate ? el_rate_init();

@sample
vu_0.rk_vu_sample((spl0 + spl1) * 0.5);   // mono sum; the meter rectifies
meter_process_sample(spl0, spl1);   // drives mtr_peak_l/r, mtr_rms_l/r, mtr_phase, …
wf_0[wfp_0] = spl0; wfp_0 = wfp_0 < WF_LEN - 1 ? wfp_0 + 1 : 0;
// audio passthrough — insert DSP above; spl0/spl1 left unchanged

@gfx 740 480
gfx_clear = 0x2e1a1a;   // canvas #1a1a2e packed as r+g*256+b*65536

// --- fit-to-window scale -------------------------------------------------
// Design canvas is 740x480; sc maps design px -> window px so the active
// tab is always visible at any window size (and crisp on HiDPI, since
// gfx_w/gfx_h arrive pre-doubled when gfx_ext_retina kicks in).
// ⭐ The height is PER TAB. One shared 480-row canvas meant the sparsest tab
// (Buttons, whose content ends at row 277) carried ~200 rows of dead canvas at
// every window size — and scaling up only made the empty part bigger. Each tab
// now declares the height it actually uses, so every one of them fills the
// window the way the Starter does.
DES_H = slider1 == 0 ? 384 : slider1 == 1 ? 462 : slider1 == 2 ? 392 :
        slider1 == 3 ? 390 : slider1 == 4 ? 392 : 400;
sc = min(gfx_w / 740, gfx_h / DES_H);
sc < 0.35 ? sc = 0.35;

// The title and the tab bar belong to the PLUGIN, not to whichever tab is
// showing, so they scale off a fixed reference height instead of the active
// tab's. Scaling them per tab made the bar change size as you switched tabs on
// a short window. 400 is the tallest tab, so sc_ui is never larger than sc and
// the bar always sits inside the content width.
sc_ui = min(gfx_w / 740, gfx_h / 400);
sc_ui < 0.35 ? sc_ui = 0.35;

// ⭐ ox CENTRES the page. sc is the smaller of the two ratios, so surplus width
// has nowhere to go and becomes a dead strip down one side.
//
// Stretching X was tried and is wrong HERE. The Starter can stretch because its
// panels are proportional containers that grow with the window. These tabs are
// loose widgets at authored positions, so stretching their x without their size
// just pulls them apart, and at the scale floor it pushes the leftmost ones off
// the edge. Centring keeps every proportion the page was drawn with and turns
// one big empty side into two small even margins, which is the honest best for
// a layout of independent widgets.
ox = max(0, (gfx_w - 740 * sc) * 0.5);

// --- per-frame input globals required by the kbsg libs ---
mx = mouse_x; my = mouse_y;
LMB = mouse_cap & 1; lmb_down = LMB && !_pLMB; _pLMB = LMB;
RMB = mouse_cap & 2; rmb_down = RMB && !_pRMB; _pRMB = RMB;
CTRL = mouse_cap & 4; SHIFT = mouse_cap & 8;
dt = time_precise() - _lt; _lt = time_precise(); hv_speed = 11; tau = 2*$pi;
frame_wheel = mouse_wheel / 120; mouse_wheel = 0;

// The keyboard. The text field drains the queue itself while it is open; the
// rest of the time one key a frame is read here. That is all the dropdown
// needs (ESC closes it), and it keeps keys from piling up while nothing is
// listening — with want_all_kb the queue fills whenever this window has focus.
el_key = rk_text_active(tfmem) ? 0 : gfx_getchar();

// While the dropdown's menu is open nothing drawn after this sees the mouse,
// so a click cannot land on a widget under it. rk_popup_run, last in @gfx,
// gets the real values back.
rk_popup_gate(ppmem);

// REAKIT ELEMENTS (title)
gfx_setfont(1,"Arial",max(9,floor(14*sc_ui)),'b'); gfx_set(0.85,0.20,0.11); gfx_x=sc_ui*14; gfx_y=sc_ui*18; gfx_drawstr("REAKIT ELEMENTS");

// Nav tab bar — buttons_kbsg btn_tab, the library's own tab widget
bm = btnmem + 10*8;
_nt = btn_tab_interact(bm, sc_ui*150, sc_ui*10, sc_ui*93, sc_ui*28, 6, sc_ui*4, slider1);
_nt != slider1 ? ( slider1 = _nt; slider_automate(slider1); );
gfx_setfont(1,"Arial",max(9,floor(11*sc_ui)),'b');
btn_tab_draw(sc_ui*150, sc_ui*10, sc_ui*93, sc_ui*28, 0, slider1, "KNOBS", bm[0]);
btn_tab_draw(sc_ui*247, sc_ui*10, sc_ui*93, sc_ui*28, 1, slider1, "BUTTONS", bm[0]);
btn_tab_draw(sc_ui*344, sc_ui*10, sc_ui*93, sc_ui*28, 2, slider1, "SLIDERS", bm[0]);
btn_tab_draw(sc_ui*441, sc_ui*10, sc_ui*93, sc_ui*28, 3, slider1, "METERS", bm[0]);
btn_tab_draw(sc_ui*538, sc_ui*10, sc_ui*93, sc_ui*28, 4, slider1, "PADS/KEYS", bm[0]);
btn_tab_draw(sc_ui*635, sc_ui*10, sc_ui*93, sc_ui*28, 5, slider1, "CURVE", bm[0]);

// Leaving the Buttons tab closes its text field, keeping what was typed, and
// its dropdown. Neither is run on another tab, so one left open would go on
// holding the keyboard, or the mouse, for a page that is not showing.
slider1 != 1 ? ( rk_text_close(tfmem); rk_popup_close(ppmem); );

// The spectrum bins are fed here, not inside a tab, because TWO tabs read them
// — Meters draws the bars and Curve uses them as the analyser behind the graph.
// Fed from inside Meters, the Curve tab showed bins that had simply decayed.
slider1 == 3 || slider1 == 5 ? meter_spectrum_update();

// ═══════════════════════ TAB 0 · KNOBS ═══════════════════════
slider1 == 0 ? (

// KNOBS — all 19 styles (select one · scroll to change) (label)
gfx_setfont(1,"Arial",max(9,floor(11*sc)),'b'); gfx_set(0.72,0.74,0.80); gfx_x=ox+sc*14; gfx_y=sc*56; gfx_drawstr("KNOBS — all 19 styles (select one · scroll to change)");

// SSL (knob / ssl)
m = km + 0*KS;
_v = rk_knob_interact(1, m, ox+sc*50, sc*160, sc*32, slider3, 0, 100, 60, 0);
_v != slider3 ? ( slider3 = _v; slider_automate(slider3); );
rk_knob_draw(1, ox+sc*50, sc*160, sc*32, slider3, 0, 100, 0, m[0], 0.29,0.62,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("SSL",_tw,_th); gfx_x=ox+sc*50-_tw/2; gfx_y=sc*196; gfx_drawstr("SSL");

// Vari-Mu (knob / varimu)
m = km + 1*KS;
_v = rk_knob_interact(2, m, ox+sc*121, sc*160, sc*32, slider4, -24, 24, 6, 0);
_v != slider4 ? ( slider4 = _v; slider_automate(slider4); );
rk_knob_draw(2, ox+sc*121, sc*160, sc*32, slider4, -24, 24, 1, m[0], 0.29,0.87,0.50, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Vari-Mu",_tw,_th); gfx_x=ox+sc*121-_tw/2; gfx_y=sc*196; gfx_drawstr("Vari-Mu");

// API (knob / api)
m = km + 2*KS;
_v = rk_knob_interact(3, m, ox+sc*192, sc*160, sc*32, slider5, 0, 100, 70, 0);
_v != slider5 ? ( slider5 = _v; slider_automate(slider5); );
rk_knob_draw(3, ox+sc*192, sc*160, sc*32, slider5, 0, 100, 0, m[0], 0.98,0.80,0.08, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("API",_tw,_th); gfx_x=ox+sc*192-_tw/2; gfx_y=sc*196; gfx_drawstr("API");

// WS (knob / ws)
m = km + 3*KS;
_v = rk_knob_interact(4, m, ox+sc*263, sc*160, sc*32, slider6, 0, 100, 55, 0);
_v != slider6 ? ( slider6 = _v; slider_automate(slider6); );
rk_knob_draw(4, ox+sc*263, sc*160, sc*32, slider6, 0, 100, 0, m[0], 0.98,0.45,0.09, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("WS",_tw,_th); gfx_x=ox+sc*263-_tw/2; gfx_y=sc*196; gfx_drawstr("WS");

// Neve (knob / neve)
m = km + 4*KS;
_v = rk_knob_interact(5, m, ox+sc*334, sc*160, sc*32, slider7, 0, 100, 40, 0);
_v != slider7 ? ( slider7 = _v; slider_automate(slider7); );
rk_knob_draw(5, ox+sc*334, sc*160, sc*32, slider7, 0, 100, 0, m[0], 0.81,0.23,0.19, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Neve",_tw,_th); gfx_x=ox+sc*334-_tw/2; gfx_y=sc*196; gfx_drawstr("Neve");

// Joanny (knob / witti)
m = km + 5*KS;
_v = rk_knob_interact(6, m, ox+sc*405, sc*160, sc*32, slider8, 0, 100, 65, 0);
_v != slider8 ? ( slider8 = _v; slider_automate(slider8); );
rk_knob_draw(6, ox+sc*405, sc*160, sc*32, slider8, 0, 100, 0, m[0], 0.64,0.46,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Joanny",_tw,_th); gfx_x=ox+sc*405-_tw/2; gfx_y=sc*196; gfx_drawstr("Joanny");

// MPC (knob / mpc)
m = km + 6*KS;
_v = rk_knob_interact(7, m, ox+sc*476, sc*160, sc*32, slider9, 0, 100, 50, 0);
_v != slider9 ? ( slider9 = _v; slider_automate(slider9); );
rk_knob_draw(7, ox+sc*476, sc*160, sc*32, slider9, 0, 100, 0, m[0], 0.17,0.73,1.00, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("MPC",_tw,_th); gfx_x=ox+sc*476-_tw/2; gfx_y=sc*196; gfx_drawstr("MPC");

// Jog (knob / jog)
m = km + 7*KS;
_v = rk_knob_interact(8, m, ox+sc*547, sc*160, sc*32, slider10, 0, 100, 35, 0);
_v != slider10 ? ( slider10 = _v; slider_automate(slider10); );
rk_knob_draw(8, ox+sc*547, sc*160, sc*32, slider10, 0, 100, 0, m[0], 0.86,0.72,0.42, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Jog",_tw,_th); gfx_x=ox+sc*547-_tw/2; gfx_y=sc*196; gfx_drawstr("Jog");

// Spice (knob / sp)
m = km + 8*KS;
_v = rk_knob_interact(10, m, ox+sc*618, sc*160, sc*32, slider11, 0, 100, 80, 0);
_v != slider11 ? ( slider11 = _v; slider_automate(slider11); );
rk_knob_draw(10, ox+sc*618, sc*160, sc*32, slider11, 0, 100, 0, m[0], 0.89,0.29,0.29, 0, 0.10,0.10,0.18);
gfx_setfont(1,"Arial",max(9,floor(11*sc))); gfx_set(0.80,0.82,0.86,1); gfx_measurestr("Spice",_tw,_th); gfx_x=ox+sc*618-_tw/2; gfx_y=sc*196; gfx_drawstr("Spice");

// Encoder (knob / encoder)
m = km + 9*KS;
_v = rk_knob_interact(11, m, ox+sc*689, sc*160, sc*32, slider12, 0, 100, 50, 0);
_v != slider12 ? ( slider12 = _v; slider_automate(slider12); );
rk_knob_draw(11, ox+sc*689, sc*160, sc*32, slider12, 0, 100, 0, m[0], 0.29,0.62,1.00, 0, 0.10,0.10,0.18);
