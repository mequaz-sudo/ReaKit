// METERS — all 12 meters_kbsg styles + analog VU (label)
gfx_setfont(1,"Arial",max(9,floor(11*sc)),'b'); gfx_set(0.72,0.74,0.80); gfx_x=sc*14; gfx_y=sc*56; gfx_drawstr("METERS — all 12 meters_kbsg styles + analog VU (scroll VU to cycle its face)");

// VU (vu)
// zm_draw_meter consumes the raw mouse_wheel for its built-in face-theme
// scroll — hand it back only while the cursor is over the meter, so knobs
// elsewhere keep their own wheel behavior.
_vu_hover = mx >= sc*14 && mx <= sc*264 && my >= sc*80 && my <= sc*230;
_vu_hover && frame_wheel ? mouse_wheel = frame_wheel * 120;
zm_draw_meter(sc*14, sc*80, sc*250, sc*150, vu_0.nd_pos*23-20, -21, vu_0.over_g>0, zm_theme, 0);   // analog VU (vu_kbsg zm); vu_0.vu_init/vu_sample @init/@sample
mouse_wheel = 0;

// LEDBar (meter)
mtr_update_db();   // meters_kbsg: linear→dB once per frame
mtr_led_bar_draw(sc*290, sc*80, sc*40, sc*84, mtr_peak_l, mtr_peak_r, -60, 0);   // meters_kbsg led_bar

