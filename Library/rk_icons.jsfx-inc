desc: ReaKit instrument icon set
// ══════════════════════════════════════════════════════════════════════
// rk_icons.jsfx-inc — 46 instrument icons, drawn in code.
//
// Ported from EON's own glyph set, which was already free of any host
// dependency — it reads no plugin state, claims no memory and sets no colour
// of its own beyond the ink you hand it. The only change here is the name
// prefix, so it can sit beside the other ReaKit widgets without collisions.
//
// Two levels of detail. Below roughly 18 px an icon drops to its simple form,
// because the detailed one turns to mush; rk_icon_draw picks for you.
//
// The `lum` argument is the LUMINANCE OF WHAT IS BEHIND IT, 0..1, not a
// colour. The icon inks itself dark on a light background and light on a dark
// one, so the same call works on any pad colour or panel.
//
// REQUIREMENTS: none. No host globals, no memory.
//
// PUBLIC API:
//   rk_icon_draw(kind, cx, cy, size, lum)      pick the tier and draw
//   rk_icon_draw_hi(kind, cx, cy, size, lum)   force the detailed tier
//   rk_icon_sm / rk_icon_lg                    the tiers, if you want one
//   rk_icon_name(kind, #dst)                   the icon's name
//   rk_icon_for_name(#s)                       guess a kind from a filename
// ══════════════════════════════════════════════════════════════════════

@init

// ── EON ICONS: 46-category lane glyphs. ⚠️ THIS LIST IS THE FROZEN ID SPACE
// (persistence authority). It is NOT the same ordering as the categorizer's
// CATEGORY_ORDER — that list is MATCH PRIORITY and diverges from index 2 on
// (deriving ids from it was the 2026-07-24 live badge-shift bug):
//   0 kick  1 snare  2 rimshot  3 clap  4 closed_hat  5 open_hat  6 hihat
//   7 cymbal  8 crash  9 ride  10 floor_tom  11 rack_tom  12 tom
//   13 conga  14 bongo  15 cowbell  16 clave  17 tambourine  18 shaker
//   19 maraca  20 percussion  21 bass  22 synth  23 pad  24 keys  25 guitar
//   26 strings  27 brass  28 vocal  29 fx  30 loop  31 other
//   32 snap  33 splash  34 china  35 sidestick
//   36 triangle  37 woodblock  38 cabasa  39 guiro  40 timbale  41 agogo
//   42 djembe  43 cajon  44 vibraslap  45 whistle
//   (32+ are APPENDED -- ids persist in lane_icon_override, so existing ids are
//   frozen; never renumber, only append. 20 percussion = pure catch-all now,
//   its old triangle art moved to the real 36 triangle.)

// ⭐ THREE states, and every consumer must keep them apart:
//   cat >= 0        a category — draw its glyph.
//   cat == -1       nothing published yet. Consumers INFER from the pad name;
//                   that inference is what bootstraps an uncategorised rack.
//   cat == PADCAT_NONE   the user said this pad has no job. Draw nothing and
//                   infer nothing — an explicit answer, not a missing one.
//                   Mirrors EON_PADCAT_NONE in Swing_Kit_Bridge.lua (persists
//                   as "-" in P_EXT:EON_SWING_PADS).
PADCAT_NONE = -3;

// elliptical rim helper (JSFX has no native ellipse -- used for drum tops)
function rk_icon_ell(cx, cy, rx, ry, a0, a1) local(n, i, st, a, px, py, x, y) (
  n = 22; st = (a1 - a0) / n; a = a0;
  px = cx + rx*cos(a); py = cy + ry*sin(a);
  loop(n, a += st; x = cx + rx*cos(a); y = cy + ry*sin(a); gfx_line(px, py, x, y, 1); px = x; py = y;);
);

// category display name (icon-picker header / Auto row)
function rk_icon_name(dest, cat) (
  strcpy(dest,
    cat == 0  ? "Kick"       : cat == 1  ? "Snare"      : cat == 2  ? "Rimshot"    : cat == 3  ? "Clap" :
    cat == 4  ? "Closed Hat" : cat == 5  ? "Open Hat"   : cat == 6  ? "Hi-Hat"     : cat == 7  ? "Cymbal" :
    cat == 8  ? "Crash"      : cat == 9  ? "Ride"       : cat == 10 ? "Floor Tom"  : cat == 11 ? "Rack Tom" :
    cat == 12 ? "Tom"        : cat == 13 ? "Conga"      : cat == 14 ? "Bongo"      : cat == 15 ? "Cowbell" :
    cat == 16 ? "Clave"      : cat == 17 ? "Tambourine" : cat == 18 ? "Shaker"     : cat == 19 ? "Maraca" :
    cat == 20 ? "Percussion" : cat == 21 ? "Bass"       : cat == 22 ? "Synth"      : cat == 23 ? "Pad" :
    cat == 24 ? "Keys"       : cat == 25 ? "Guitar"     : cat == 26 ? "Strings"    : cat == 27 ? "Brass" :
    cat == 28 ? "Vocal"      : cat == 29 ? "FX"         : cat == 30 ? "Loop"       : cat == 31 ? "Other" :
    cat == 32 ? "Snap"       : cat == 33 ? "Splash"     : cat == 34 ? "China"      : cat == 35 ? "Sidestick" :
    cat == 36 ? "Triangle"   : cat == 37 ? "Woodblock"  : cat == 38 ? "Cabasa"     : cat == 39 ? "Guiro" :
    cat == 40 ? "Timbale"    : cat == 41 ? "Agogo"      : cat == 42 ? "Djembe"     : cat == 43 ? "Cajon" :
    cat == 44 ? "Vibraslap"  : "Whistle");
);

// SMALL tier (s < 11, lane column / embedded views): <=6 strokes per glyph, nothing
// finer than ~2px at s=7. Same category ids as the detailed tier.
function rk_icon_sm(cat, cx, cy, s) local(s2) (
  s2 = s*0.5;
  cat == 0  ? ( gfx_circle(cx,cy,s,1,1); ) :                                                    // kick: filled circle
  cat == 1  ? ( gfx_circle(cx,cy,s,0,1); gfx_line(cx-s,cy-s2,cx+s,cy+s2,1); gfx_line(cx-s,cy,cx+s,cy+s,1); ) :  // snare: circle + wires
  cat == 2  ? ( gfx_circle(cx,cy,s,0,1); gfx_line(cx-0.6*s,cy-s,cx+s,cy-0.2*s,1); ) :           // rimshot: circle + stick across rim
  cat == 3  ? ( gfx_line(cx-s,cy+s,cx-s2,cy-s,1); gfx_line(cx+1,cy+s,cx+s2+1,cy-s,1); ) :       // clap: two slashes
  cat == 4  ? ( gfx_line(cx-s,cy-1,cx+s,cy-1,1); gfx_line(cx-s,cy+1,cx+s,cy+1,1); ) :           // closed hat: 2 close bars
  cat == 5  ? ( gfx_line(cx-s,cy-s2,cx+s,cy-s2,1); gfx_line(cx-s,cy+s2,cx+s,cy+s2,1); ) :       // open hat: 2 spread bars
  cat == 6  ? ( gfx_line(cx-s,cy-2,cx+s,cy-2,1); gfx_line(cx-s,cy+1,cx+s,cy+1,1); gfx_line(cx,cy+1,cx,cy+s,1); ) : // hihat: bars + stem
  cat == 7  ? ( gfx_circle(cx,cy,s,0,1); gfx_circle(cx,cy,1.5,1,1); ) :                         // cymbal: circle + bell dot
  cat == 8  ? ( gfx_circle(cx,cy,0.65*s,0,1); gfx_line(cx,cy-0.65*s,cx,cy-s,1); gfx_line(cx-0.5*s,cy-0.45*s,cx-0.8*s,cy-0.75*s,1); gfx_line(cx+0.5*s,cy-0.45*s,cx+0.8*s,cy-0.75*s,1); ) : // crash: circle + rays
  cat == 9  ? ( gfx_circle(cx,cy,s,0,1); gfx_circle(cx,cy,max(1.5,0.35*s),1,1); ) :             // ride: circle + fat dot
  cat == 10 ? ( gfx_circle(cx,cy-0.1*s,0.9*s,0,1); gfx_line(cx-0.5*s,cy+0.6*s,cx-0.7*s,cy+s,1); gfx_line(cx+0.5*s,cy+0.6*s,cx+0.7*s,cy+s,1); ) : // floor tom: circle + legs
  cat == 11 ? ( gfx_circle(cx,cy+0.1*s,0.85*s,0,1); gfx_line(cx-s2,cy-s,cx+s2,cy-s,1); ) :      // rack tom: circle + mount bar
  cat == 12 ? ( gfx_circle(cx,cy,0.85*s,0,1); ) :                                               // tom: hollow circle
  cat == 13 ? ( gfx_line(cx-s2,cy-s,cx+s2,cy-s,1); gfx_line(cx-s2,cy-s,cx-0.35*s,cy+s,1); gfx_line(cx+s2,cy-s,cx+0.35*s,cy+s,1); gfx_line(cx-0.35*s,cy+s,cx+0.35*s,cy+s,1); ) : // conga: tall taper
  cat == 14 ? ( gfx_circle(cx-s2,cy,s2,0,1); gfx_circle(cx+0.55*s,cy+0.1*s,0.4*s,0,1); ) :      // bongo: two circles
  cat == 15 ? ( gfx_line(cx-s2,cy-s,cx+s2,cy-s,1); gfx_line(cx-s2,cy-s,cx-s,cy+s,1); gfx_line(cx+s2,cy-s,cx+s,cy+s,1); gfx_line(cx-s,cy+s,cx+s,cy+s,1); ) : // cowbell trapezoid
  cat == 16 ? ( gfx_line(cx-0.72*s,cy+0.52*s,cx+0.5*s,cy-0.6*s,1); gfx_line(cx-0.5*s,cy+0.66*s,cx+0.72*s,cy-0.46*s,1); ) : // clave: crossed sticks
  cat == 17 ? ( gfx_circle(cx,cy,s,0,1); gfx_circle(cx,cy-0.6*s,1.2,1,1); gfx_circle(cx-0.55*s,cy+0.35*s,1.2,1,1); gfx_circle(cx+0.55*s,cy+0.35*s,1.2,1,1); ) : // tambourine: ring + jingles
  cat == 18 ? ( rk_icon_ell(cx,cy,0.45*s,0.75*s,0,2*$pi); ) :                                       // shaker: upright ellipse
  cat == 19 ? ( gfx_circle(cx,cy-0.4*s,0.55*s,0,1); gfx_line(cx,cy+0.15*s,cx,cy+s,1); ) :       // maraca: head + stick
  cat == 20 ? ( gfx_line(cx-0.75*s,cy+0.8*s,cx+0.6*s,cy-0.75*s,1); gfx_line(cx+0.75*s,cy+0.8*s,cx-0.6*s,cy-0.75*s,1); gfx_circle(cx+0.6*s,cy-0.75*s,1.5,1,1); gfx_circle(cx-0.6*s,cy-0.75*s,1.5,1,1); ) : // percussion: crossed sticks (triangle art -> cat 36)
  cat == 21 ? ( gfx_rect(cx-s,cy-s,2*s,2*s,0); gfx_circle(cx,cy,max(1.5,0.3*s),1,1); ) :        // bass: speaker box + cone
  cat == 22 ? ( gfx_line(cx-s,cy+s2,cx-0.33*s,cy-s2,1); gfx_line(cx-0.33*s,cy-s2,cx+0.33*s,cy+s2,1); gfx_line(cx+0.33*s,cy+s2,cx+s,cy-s2,1); ) : // synth: zigzag
  cat == 23 ? ( gfx_line(cx-s,cy,cx-s2,cy-s2,1); gfx_line(cx-s2,cy-s2,cx,cy,1); gfx_line(cx,cy,cx+s2,cy+s2,1); gfx_line(cx+s2,cy+s2,cx+s,cy,1); ) : // pad: soft wave
  cat == 24 ? ( gfx_rect(cx-s,cy-0.6*s,2*s,1.2*s,0); gfx_line(cx-0.33*s,cy-0.6*s,cx-0.33*s,cy+0.6*s,1); gfx_line(cx+0.33*s,cy-0.6*s,cx+0.33*s,cy+0.6*s,1); ) : // keys: 3-key strip
  cat == 25 ? ( gfx_circle(cx,cy+0.3*s,0.6*s,0,1); gfx_line(cx,cy-0.3*s,cx,cy-s,1); ) :         // guitar: body + neck
  cat == 26 ? ( gfx_line(cx-s2,cy-s,cx-s2,cy+s,1); gfx_line(cx,cy-s,cx,cy+s,1); gfx_line(cx+s2,cy-s,cx+s2,cy+s,1); gfx_line(cx-s,cy+s2,cx+s,cy-s2,1); ) : // strings + bow
  cat == 27 ? ( gfx_line(cx+s,cy-s2,cx+s,cy+s2,1); gfx_line(cx+s,cy-s2,cx-s,cy,1); gfx_line(cx+s,cy+s2,cx-s,cy,1); ) : // brass: horn wedge
  cat == 28 ? ( gfx_circle(cx,cy-0.4*s,0.45*s,0,1); gfx_line(cx,cy+0.05*s,cx,cy+s,1); gfx_line(cx-0.4*s,cy+s,cx+0.4*s,cy+s,1); ) : // vocal: mic
  cat == 29 ? ( gfx_line(cx-s,cy,cx+s,cy,1); gfx_line(cx,cy-s,cx,cy+s,1); gfx_line(cx-s2,cy-s2,cx+s2,cy+s2,1); gfx_line(cx-s2,cy+s2,cx+s2,cy-s2,1); ) : // fx: asterisk
  cat == 30 ? ( rk_icon_ell(cx,cy,0.62*s,0.62*s,0.75,2*$pi); gfx_line(cx+0.45*s,cy+0.42*s,cx+0.23*s,cy+0.4*s,1); gfx_line(cx+0.45*s,cy+0.42*s,cx+0.41*s,cy+0.18*s,1); ) : // loop: circle arrow
  cat == 32 ? ( gfx_circle(cx,cy+0.35*s,max(1.5,0.2*s),1,1); gfx_line(cx,cy+0.1*s,cx,cy-0.6*s,1); gfx_line(cx-0.25*s,cy+0.15*s,cx-0.7*s,cy-0.4*s,1); gfx_line(cx+0.25*s,cy+0.15*s,cx+0.7*s,cy-0.4*s,1); ) : // snap: dot + sparks
  cat == 33 ? ( gfx_line(cx-s,cy+0.1*s,cx+s,cy+0.1*s,1); gfx_line(cx,cy+0.1*s,cx,cy+0.7*s,1); gfx_circle(cx-0.4*s,cy-0.4*s,1.2,1,1); gfx_circle(cx+0.35*s,cy-0.55*s,1.2,1,1); ) : // splash: lens + droplets
  cat == 34 ? ( gfx_line(cx-s,cy-0.4*s,cx-0.5*s,cy+0.1*s,1); gfx_line(cx-0.5*s,cy+0.1*s,cx+0.5*s,cy+0.1*s,1); gfx_line(cx+0.5*s,cy+0.1*s,cx+s,cy-0.4*s,1); gfx_line(cx,cy+0.1*s,cx,cy+0.7*s,1); ) : // china: upturned edges
  cat == 35 ? ( gfx_circle(cx,cy,0.75*s,0,1); gfx_line(cx-s,cy,cx+s,cy,1); ) : // sidestick: stick across head
  cat == 36 ? ( gfx_line(cx-0.8*s,cy+0.7*s,cx,cy-0.8*s,1); gfx_line(cx,cy-0.8*s,cx+0.8*s,cy+0.7*s,1); gfx_line(cx-0.8*s,cy+0.7*s,cx+0.8*s,cy+0.7*s,1); ) : // triangle
  cat == 37 ? ( gfx_rect(cx-0.8*s,cy-0.4*s,1.6*s,0.9*s,0); gfx_line(cx-0.5*s,cy-0.05*s,cx+0.5*s,cy-0.05*s,1); ) : // woodblock: block + slit
  cat == 38 ? ( gfx_circle(cx,cy-0.15*s,0.6*s,0,1); gfx_line(cx-0.4*s,cy-0.55*s,cx+0.4*s,cy+0.25*s,1); gfx_line(cx+0.4*s,cy-0.55*s,cx-0.4*s,cy+0.25*s,1); gfx_line(cx,cy+0.45*s,cx,cy+s,1); ) : // cabasa: beaded head + handle
  cat == 39 ? ( rk_icon_ell(cx,cy,0.85*s,0.4*s,0,2*$pi); gfx_line(cx-0.4*s,cy-0.35*s,cx-0.4*s,cy+0.35*s,1); gfx_line(cx,cy-0.4*s,cx,cy+0.4*s,1); gfx_line(cx+0.4*s,cy-0.35*s,cx+0.4*s,cy+0.35*s,1); ) : // guiro: ridged gourd
  cat == 40 ? ( gfx_line(cx-0.85*s,cy-0.3*s,cx+0.85*s,cy-0.3*s,1); gfx_line(cx-0.85*s,cy-0.3*s,cx-0.85*s,cy+0.15*s,1); gfx_line(cx+0.85*s,cy-0.3*s,cx+0.85*s,cy+0.15*s,1); gfx_line(cx-0.85*s,cy+0.15*s,cx+0.85*s,cy+0.15*s,1); gfx_line(cx,cy+0.15*s,cx,cy+0.9*s,1); ) : // timbale: shallow shell + stand
  cat == 41 ? ( gfx_line(cx-0.7*s,cy-0.4*s,cx-0.35*s,cy+0.4*s,1); gfx_line(cx-0.05*s,cy-0.4*s,cx-0.35*s,cy+0.4*s,1); gfx_line(cx+0.15*s,cy-0.3*s,cx+0.5*s,cy+0.55*s,1); gfx_line(cx+0.85*s,cy-0.3*s,cx+0.5*s,cy+0.55*s,1); ) : // agogo: two cones
  cat == 42 ? ( gfx_line(cx-0.7*s,cy-0.6*s,cx+0.7*s,cy-0.6*s,1); gfx_line(cx-0.7*s,cy-0.6*s,cx-0.2*s,cy+0.2*s,1); gfx_line(cx+0.7*s,cy-0.6*s,cx+0.2*s,cy+0.2*s,1); gfx_line(cx-0.2*s,cy+0.2*s,cx-0.5*s,cy+0.9*s,1); gfx_line(cx+0.2*s,cy+0.2*s,cx+0.5*s,cy+0.9*s,1); ) : // djembe: goblet
  cat == 43 ? ( gfx_rect(cx-0.65*s,cy-0.8*s,1.3*s,1.6*s,0); gfx_circle(cx,cy-0.35*s,max(2,0.22*s),0,1); ) : // cajon: box + hole
  cat == 44 ? ( gfx_line(cx-0.7*s,cy+0.6*s,cx+0.4*s,cy-0.5*s,1); gfx_circle(cx-0.75*s,cy+0.68*s,max(1.5,0.18*s),1,1); gfx_line(cx+0.4*s,cy-0.5*s,cx+0.85*s,cy-0.25*s,1); gfx_line(cx+0.4*s,cy-0.5*s,cx+0.6*s,cy-0.85*s,1); ) : // vibraslap: ball + rod + wedge
  cat == 45 ? ( gfx_circle(cx-0.15*s,cy+0.1*s,0.55*s,0,1); gfx_line(cx+0.3*s,cy-0.3*s,cx+0.9*s,cy-0.3*s,1); gfx_line(cx+0.3*s,cy-0.05*s,cx+0.9*s,cy-0.05*s,1); gfx_line(cx+0.9*s,cy-0.3*s,cx+0.9*s,cy-0.05*s,1); ) : // whistle: body + mouthpiece
  ( gfx_line(cx-0.6*s,cy-0.3*s,cx-0.6*s,cy+0.3*s,1); gfx_line(cx-0.3*s,cy-0.6*s,cx-0.3*s,cy+0.6*s,1); gfx_line(cx,cy-0.42*s,cx,cy+0.42*s,1); gfx_line(cx+0.3*s,cy-0.68*s,cx+0.3*s,cy+0.68*s,1); gfx_line(cx+0.6*s,cy-0.25*s,cx+0.6*s,cy+0.25*s,1); );  // 31 other: waveform bars
);

// DETAILED tier (s >= 11: icon picker, roomy lane rows). Everything fits +-1.0*s
// (crash pre-scaled by 0.85 so its rays stay inside the cell).
function rk_icon_lg(cat, cx, cy, s) local(sc) (
  cat == 0  ? ( gfx_circle(cx,cy-0.08*s,0.82*s,0,1); gfx_circle(cx,cy-0.08*s,0.4*s,0,1); gfx_circle(cx+0.16*s,cy+0.02*s,0.15*s,1,1); gfx_line(cx+0.16*s,cy+0.02*s,cx+0.66*s,cy+0.42*s,1); gfx_line(cx-0.48*s,cy+0.56*s,cx-0.66*s,cy+0.98*s,1); gfx_line(cx+0.48*s,cy+0.56*s,cx+0.66*s,cy+0.98*s,1); ) :  // kick
  cat == 1  ? ( rk_icon_ell(cx,cy-0.4*s,0.85*s,0.24*s,0,2*$pi); gfx_line(cx-0.85*s,cy-0.4*s,cx-0.85*s,cy+0.42*s,1); gfx_line(cx+0.85*s,cy-0.4*s,cx+0.85*s,cy+0.42*s,1); rk_icon_ell(cx,cy+0.42*s,0.85*s,0.24*s,0,$pi); gfx_line(cx-0.45*s,cy-0.06*s,cx-0.45*s,cy+0.2*s,1); gfx_line(cx,cy-0.06*s,cx,cy+0.2*s,1); gfx_line(cx+0.45*s,cy-0.06*s,cx+0.45*s,cy+0.2*s,1); ) :  // snare
  cat == 2  ? ( rk_icon_ell(cx,cy-0.35*s,0.8*s,0.22*s,0,2*$pi); gfx_line(cx-0.8*s,cy-0.35*s,cx-0.8*s,cy+0.42*s,1); gfx_line(cx+0.8*s,cy-0.35*s,cx+0.8*s,cy+0.42*s,1); rk_icon_ell(cx,cy+0.42*s,0.8*s,0.22*s,0,$pi); gfx_line(cx-0.4*s,cy-0.05*s,cx-0.4*s,cy+0.18*s,1); gfx_line(cx+0.4*s,cy-0.05*s,cx+0.4*s,cy+0.18*s,1); gfx_line(cx-0.55*s,cy-0.68*s,cx+0.72*s,cy-0.12*s,1); gfx_line(cx+0.22*s,cy-0.86*s,cx+0.5*s,cy-0.5*s,1); ) :  // rimshot
