// smooth_kbsg.jsfx-inc — One-pole parameter smoother
// Usage:
//   @init:    param.smooth_init(time_ms);
//   @slider:  param.smooth_init(new_time_ms);  // if time changes
//   @sample:  param.smooth(target);             // returns smoothed value
//   @init:    param.smooth_set(val);            // snap to value (no ramp)

@init

function smooth_init(time_ms)
  instance(coeff, val)
(
  coeff = 1 - exp(-1 / max(1, time_ms * 0.001 * srate));
);

function smooth(target)
  instance(coeff, val)
(
  val += (target - val) * coeff;
);

function smooth_set(v)
  instance(val)
(
  val = v;
);
